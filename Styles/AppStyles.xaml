<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:sys="clr-namespace:System;assembly=System.Runtime">
    
    <!-- ═══════════════════════════════════════════════════════════════════════
         Cloud Native Assessment - Centralized Style Resources
         
         Color Palette: Microsoft Fluent Design
         - Primary: #0078D4 (Microsoft Blue)
         - Success: #107C10 (Microsoft Green)
         - Error: #D13438 (Microsoft Red)
         - Warning: #E65100 (Orange)
         
         Usage: {StaticResource SuccessGreen}, {StaticResource ErrorRedLight}, etc.
         ═══════════════════════════════════════════════════════════════════════ -->
    
    <!-- ═══════════════════════════════════════════════════════════════════════
         BRAND COLORS
         ═══════════════════════════════════════════════════════════════════════ -->
    <Color x:Key="PrimaryBlueColor">#0078D4</Color>
    <Color x:Key="PrimaryBlueHoverColor">#106EBE</Color>
    <SolidColorBrush x:Key="PrimaryBlue" Color="{StaticResource PrimaryBlueColor}"/>
    <SolidColorBrush x:Key="PrimaryBlueHover" Color="{StaticResource PrimaryBlueHoverColor}"/>
    
    <!-- ═══════════════════════════════════════════════════════════════════════
         SEMANTIC COLORS - SUCCESS (Green)
         Use for: Intune side, positive metrics, success states
         ═══════════════════════════════════════════════════════════════════════ -->
    <Color x:Key="SuccessGreenColor">#107C10</Color>
    <Color x:Key="SuccessGreenLightColor">#E8F5E9</Color>
    <Color x:Key="SuccessGreenMediumColor">#C8E6C9</Color>
    <Color x:Key="SuccessGreenDarkColor">#2E7D32</Color>
    
    <SolidColorBrush x:Key="SuccessGreen" Color="{StaticResource SuccessGreenColor}"/>
    <SolidColorBrush x:Key="SuccessGreenLight" Color="{StaticResource SuccessGreenLightColor}"/>
    <SolidColorBrush x:Key="SuccessGreenMedium" Color="{StaticResource SuccessGreenMediumColor}"/>
    <SolidColorBrush x:Key="SuccessGreenDark" Color="{StaticResource SuccessGreenDarkColor}"/>
    
    <!-- ═══════════════════════════════════════════════════════════════════════
         SEMANTIC COLORS - ERROR (Red)
         Use for: Errors, critical warnings, negative metrics
         ═══════════════════════════════════════════════════════════════════════ -->
    <Color x:Key="ErrorRedColor">#D13438</Color>
    <Color x:Key="ErrorRedLightColor">#FFEBEE</Color>
    <Color x:Key="ErrorRedMediumColor">#FFCDD2</Color>
    <Color x:Key="ErrorRedDarkColor">#C62828</Color>
    
    <SolidColorBrush x:Key="ErrorRed" Color="{StaticResource ErrorRedColor}"/>
    <SolidColorBrush x:Key="ErrorRedLight" Color="{StaticResource ErrorRedLightColor}"/>
    <SolidColorBrush x:Key="ErrorRedMedium" Color="{StaticResource ErrorRedMediumColor}"/>
    <SolidColorBrush x:Key="ErrorRedDark" Color="{StaticResource ErrorRedDarkColor}"/>
    
    <!-- ═══════════════════════════════════════════════════════════════════════
         SEMANTIC COLORS - WARNING (Orange)
         Use for: ConfigMgr side, warnings, attention needed
         ═══════════════════════════════════════════════════════════════════════ -->
    <Color x:Key="WarningOrangeColor">#E65100</Color>
    <Color x:Key="WarningOrangeLightColor">#FFF3E0</Color>
    <Color x:Key="WarningOrangeMediumColor">#FFE0B2</Color>
    <Color x:Key="WarningOrangeDarkColor">#D84315</Color>
    
    <SolidColorBrush x:Key="WarningOrange" Color="{StaticResource WarningOrangeColor}"/>
    <SolidColorBrush x:Key="WarningOrangeLight" Color="{StaticResource WarningOrangeLightColor}"/>
    <SolidColorBrush x:Key="WarningOrangeMedium" Color="{StaticResource WarningOrangeMediumColor}"/>
    <SolidColorBrush x:Key="WarningOrangeDark" Color="{StaticResource WarningOrangeDarkColor}"/>
    
    <!-- ═══════════════════════════════════════════════════════════════════════
         NEUTRAL COLORS (Grays)
         ═══════════════════════════════════════════════════════════════════════ -->
    <Color x:Key="TextPrimaryColor">#333333</Color>
    <Color x:Key="TextSecondaryColor">#666666</Color>
    <Color x:Key="TextTertiaryColor">#888888</Color>
    <Color x:Key="TextDisabledColor">#AAAAAA</Color>
    
    <SolidColorBrush x:Key="TextPrimary" Color="{StaticResource TextPrimaryColor}"/>
    <SolidColorBrush x:Key="TextSecondary" Color="{StaticResource TextSecondaryColor}"/>
    <SolidColorBrush x:Key="TextTertiary" Color="{StaticResource TextTertiaryColor}"/>
    <SolidColorBrush x:Key="TextDisabled" Color="{StaticResource TextDisabledColor}"/>
    
    <!-- ═══════════════════════════════════════════════════════════════════════
         SEMANTIC COLORS - INFO (Blue)
         Use for: Information, links, neutral highlights
         ═══════════════════════════════════════════════════════════════════════ -->
    <Color x:Key="InfoBlueColor">#1976D2</Color>
    <Color x:Key="InfoBlueLightColor">#E3F2FD</Color>
    <Color x:Key="InfoBlueMediumColor">#BBDEFB</Color>
    <Color x:Key="InfoBlueDarkColor">#0D47A1</Color>
    
    <SolidColorBrush x:Key="InfoBlue" Color="{StaticResource InfoBlueColor}"/>
    <SolidColorBrush x:Key="InfoBlueLight" Color="{StaticResource InfoBlueLightColor}"/>
    <SolidColorBrush x:Key="InfoBlueMedium" Color="{StaticResource InfoBlueMediumColor}"/>
    <SolidColorBrush x:Key="InfoBlueDark" Color="{StaticResource InfoBlueDarkColor}"/>
    
    <!-- ═══════════════════════════════════════════════════════════════════════
         ACCENT COLORS
         Use for: Special highlights, categories, visual variety
         ═══════════════════════════════════════════════════════════════════════ -->
    <Color x:Key="AccentPurpleColor">#6A1B9A</Color>
    <Color x:Key="AccentPurpleLightColor">#F3E5F5</Color>
    <Color x:Key="AccentTealColor">#00897B</Color>
    <Color x:Key="AccentTealLightColor">#E0F2F1</Color>
    <Color x:Key="AccentAmberColor">#F59E0B</Color>
    <Color x:Key="AccentAmberLightColor">#FEF3C7</Color>
    
    <SolidColorBrush x:Key="AccentPurple" Color="{StaticResource AccentPurpleColor}"/>
    <SolidColorBrush x:Key="AccentPurpleLight" Color="{StaticResource AccentPurpleLightColor}"/>
    <SolidColorBrush x:Key="AccentTeal" Color="{StaticResource AccentTealColor}"/>
    <SolidColorBrush x:Key="AccentTealLight" Color="{StaticResource AccentTealLightColor}"/>
    <SolidColorBrush x:Key="AccentAmber" Color="{StaticResource AccentAmberColor}"/>
    <SolidColorBrush x:Key="AccentAmberLight" Color="{StaticResource AccentAmberLightColor}"/>
    
    <!-- ═══════════════════════════════════════════════════════════════════════
         EXTENDED GRAY PALETTE
         Use for: More nuanced text and UI elements
         ═══════════════════════════════════════════════════════════════════════ -->
    <Color x:Key="TextDarkColor">#1F2937</Color>
    <Color x:Key="TextMutedColor">#6B7280</Color>
    <Color x:Key="TextLightColor">#9CA3AF</Color>
    <Color x:Key="Gray700Color">#374151</Color>
    <Color x:Key="Gray600Color">#4B5563</Color>
    <Color x:Key="Gray400Color">#9CA3AF</Color>
    <Color x:Key="Gray300Color">#D1D5DB</Color>
    <Color x:Key="Gray200Color">#E5E7EB</Color>
    <Color x:Key="Gray100Color">#F3F4F6</Color>
    <Color x:Key="Gray50Color">#F9FAFB</Color>
    
    <SolidColorBrush x:Key="TextDark" Color="{StaticResource TextDarkColor}"/>
    <SolidColorBrush x:Key="TextMuted" Color="{StaticResource TextMutedColor}"/>
    <SolidColorBrush x:Key="TextLight" Color="{StaticResource TextLightColor}"/>
    <SolidColorBrush x:Key="Gray700" Color="{StaticResource Gray700Color}"/>
    <SolidColorBrush x:Key="Gray600" Color="{StaticResource Gray600Color}"/>
    <SolidColorBrush x:Key="Gray400" Color="{StaticResource Gray400Color}"/>
    <SolidColorBrush x:Key="Gray300" Color="{StaticResource Gray300Color}"/>
    <SolidColorBrush x:Key="Gray200" Color="{StaticResource Gray200Color}"/>
    <SolidColorBrush x:Key="Gray100" Color="{StaticResource Gray100Color}"/>
    <SolidColorBrush x:Key="Gray50" Color="{StaticResource Gray50Color}"/>
    
    <!-- ═══════════════════════════════════════════════════════════════════════
         BORDERS AND BACKGROUNDS
         ═══════════════════════════════════════════════════════════════════════ -->
    <Color x:Key="BorderLightColor">#E0E0E0</Color>
    <Color x:Key="BorderMediumColor">#BDBDBD</Color>
    <Color x:Key="BackgroundPageColor">#F5F5F5</Color>
    <Color x:Key="BackgroundCardColor">#FFFFFF</Color>
    <Color x:Key="BackgroundSubtleColor">#F8F9FA</Color>
    <Color x:Key="BackgroundMutedColor">#F9FAFB</Color>
    <Color x:Key="BackgroundAliceColor">#F0F8FF</Color>
    <Color x:Key="BackgroundMintColor">#ECFDF5</Color>
    
    <SolidColorBrush x:Key="BorderLight" Color="{StaticResource BorderLightColor}"/>
    <SolidColorBrush x:Key="BorderMedium" Color="{StaticResource BorderMediumColor}"/>
    <SolidColorBrush x:Key="BackgroundPage" Color="{StaticResource BackgroundPageColor}"/>
    <SolidColorBrush x:Key="BackgroundCard" Color="{StaticResource BackgroundCardColor}"/>
    <SolidColorBrush x:Key="BackgroundSubtle" Color="{StaticResource BackgroundSubtleColor}"/>
    <SolidColorBrush x:Key="BackgroundMuted" Color="{StaticResource BackgroundMutedColor}"/>
    <SolidColorBrush x:Key="BackgroundAlice" Color="{StaticResource BackgroundAliceColor}"/>
    <SolidColorBrush x:Key="BackgroundMint" Color="{StaticResource BackgroundMintColor}"/>
    
    <!-- ═══════════════════════════════════════════════════════════════════════
         TYPOGRAPHY - Font Sizes
         ═══════════════════════════════════════════════════════════════════════ -->
    <sys:Double x:Key="FontSizeH1">24</sys:Double>
    <sys:Double x:Key="FontSizeH2">18</sys:Double>
    <sys:Double x:Key="FontSizeH3">14</sys:Double>
    <sys:Double x:Key="FontSizeBody">13</sys:Double>
    <sys:Double x:Key="FontSizeSmall">11</sys:Double>
    <sys:Double x:Key="FontSizeCaption">10</sys:Double>
    
    <!-- ═══════════════════════════════════════════════════════════════════════
         CORNER RADIUS
         ═══════════════════════════════════════════════════════════════════════ -->
    <CornerRadius x:Key="RadiusSmall">4</CornerRadius>
    <CornerRadius x:Key="RadiusMedium">6</CornerRadius>
    <CornerRadius x:Key="RadiusLarge">8</CornerRadius>
    
    <!-- ═══════════════════════════════════════════════════════════════════════
         SHARED STYLES - Cards
         ═══════════════════════════════════════════════════════════════════════ -->
    
    <!-- Standard Card Container -->
    <Style x:Key="CardBorder" TargetType="Border">
        <Setter Property="Background" Value="{StaticResource BackgroundCard}"/>
        <Setter Property="BorderBrush" Value="{StaticResource BorderLight}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="CornerRadius" Value="{StaticResource RadiusLarge}"/>
        <Setter Property="Padding" Value="16"/>
        <Setter Property="Margin" Value="0,0,0,12"/>
    </Style>
    
    <!-- Intune/Cloud Side Panel (Green theme) -->
    <Style x:Key="IntuneSidePanel" TargetType="Border">
        <Setter Property="Background" Value="{StaticResource SuccessGreenLight}"/>
        <Setter Property="CornerRadius" Value="{StaticResource RadiusMedium}"/>
        <Setter Property="Padding" Value="12"/>
    </Style>
    
    <!-- ConfigMgr Side Panel (Orange theme) -->
    <Style x:Key="ConfigMgrSidePanel" TargetType="Border">
        <Setter Property="Background" Value="{StaticResource WarningOrangeLight}"/>
        <Setter Property="CornerRadius" Value="{StaticResource RadiusMedium}"/>
        <Setter Property="Padding" Value="12"/>
    </Style>
    
    <!-- Summary Footer Panel -->
    <Style x:Key="SummaryFooterPanel" TargetType="Border">
        <Setter Property="CornerRadius" Value="{StaticResource RadiusMedium}"/>
        <Setter Property="Padding" Value="12,8"/>
        <Setter Property="Margin" Value="0,12,0,0"/>
    </Style>
    
    <!-- Feature Tag Badge -->
    <Style x:Key="FeatureTagBadge" TargetType="Border">
        <Setter Property="Background" Value="{StaticResource SuccessGreenMedium}"/>
        <Setter Property="CornerRadius" Value="3"/>
        <Setter Property="Padding" Value="6,3"/>
        <Setter Property="Margin" Value="2"/>
    </Style>
    
    <!-- Warning Badge -->
    <Style x:Key="WarningBadge" TargetType="Border">
        <Setter Property="Background" Value="{StaticResource ErrorRedMedium}"/>
        <Setter Property="CornerRadius" Value="{StaticResource RadiusSmall}"/>
        <Setter Property="Padding" Value="8,6"/>
        <Setter Property="Margin" Value="0,8,0,0"/>
    </Style>
    
    <!-- ═══════════════════════════════════════════════════════════════════════
         SHARED STYLES - Buttons
         ═══════════════════════════════════════════════════════════════════════ -->
    
    <Style x:Key="PrimaryButton" TargetType="Button">
        <Setter Property="Background" Value="{StaticResource PrimaryBlue}"/>
        <Setter Property="Foreground" Value="White"/>
        <Setter Property="FontWeight" Value="SemiBold"/>
        <Setter Property="Padding" Value="16,8"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="BorderThickness" Value="0"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border Background="{TemplateBinding Background}" 
                            CornerRadius="{StaticResource RadiusSmall}"
                            Padding="{TemplateBinding Padding}">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
        <Style.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
                <Setter Property="Background" Value="{StaticResource PrimaryBlueHover}"/>
            </Trigger>
        </Style.Triggers>
    </Style>
    
    <!-- ═══════════════════════════════════════════════════════════════════════
         SHARED STYLES - Text
         ═══════════════════════════════════════════════════════════════════════ -->
    
    <Style x:Key="CardTitle" TargetType="TextBlock">
        <Setter Property="FontSize" Value="{StaticResource FontSizeH3}"/>
        <Setter Property="FontWeight" Value="SemiBold"/>
        <Setter Property="Foreground" Value="{StaticResource TextPrimary}"/>
    </Style>
    
    <Style x:Key="CardSubtitle" TargetType="TextBlock">
        <Setter Property="FontSize" Value="{StaticResource FontSizeSmall}"/>
        <Setter Property="Foreground" Value="{StaticResource TextSecondary}"/>
    </Style>
    
    <Style x:Key="MetricValue" TargetType="TextBlock">
        <Setter Property="FontSize" Value="{StaticResource FontSizeH3}"/>
        <Setter Property="FontWeight" Value="Bold"/>
    </Style>
    
    <Style x:Key="MetricLabel" TargetType="TextBlock">
        <Setter Property="FontSize" Value="{StaticResource FontSizeSmall}"/>
        <Setter Property="Foreground" Value="{StaticResource TextSecondary}"/>
    </Style>
    
    <!-- ═══════════════════════════════════════════════════════════════════════
         LICENSE STATUS INDICATORS
         ═══════════════════════════════════════════════════════════════════════ -->
    
    <Style x:Key="LicenseStatusLicensed" TargetType="Border">
        <Setter Property="Background" Value="{StaticResource SuccessGreenLight}"/>
        <Setter Property="BorderBrush" Value="{StaticResource SuccessGreen}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="CornerRadius" Value="{StaticResource RadiusSmall}"/>
        <Setter Property="Padding" Value="8,4"/>
    </Style>
    
    <Style x:Key="LicenseStatusNotLicensed" TargetType="Border">
        <Setter Property="Background" Value="{StaticResource ErrorRedLight}"/>
        <Setter Property="BorderBrush" Value="{StaticResource ErrorRed}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="CornerRadius" Value="{StaticResource RadiusSmall}"/>
        <Setter Property="Padding" Value="8,4"/>
    </Style>
    
    <Style x:Key="LicenseStatusPartial" TargetType="Border">
        <Setter Property="Background" Value="{StaticResource WarningOrangeLight}"/>
        <Setter Property="BorderBrush" Value="{StaticResource WarningOrange}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="CornerRadius" Value="{StaticResource RadiusSmall}"/>
        <Setter Property="Padding" Value="8,4"/>
    </Style>
    
</ResourceDictionary>
