<UserControl x:Class="ZeroTrustMigrationAddin.Views.CloudValueComparisonTab"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:lvc="clr-namespace:LiveCharts.Wpf;assembly=LiveCharts.Wpf"
             FontFamily="Segoe UI Emoji, Segoe UI, Arial">

    <UserControl.Resources>
        <!-- Card styles using centralized resources -->
        <Style x:Key="ComparisonCard" TargetType="Border" BasedOn="{StaticResource CardBorder}"/>
        
        <!-- Intune Side (Cloud - Green theme) -->
        <Style x:Key="IntuneSide" TargetType="Border" BasedOn="{StaticResource IntuneSidePanel}"/>
        
        <!-- ConfigMgr Side (On-Prem - Orange/Amber theme) -->
        <Style x:Key="ConfigMgrSide" TargetType="Border" BasedOn="{StaticResource ConfigMgrSidePanel}"/>
        
        <!-- Summary Footer -->
        <Style x:Key="SummaryFooter" TargetType="Border" BasedOn="{StaticResource SummaryFooterPanel}">
            <Setter Property="Background" Value="{StaticResource BackgroundPage}"/>
        </Style>
    </UserControl.Resources>

    <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="20">
        <StackPanel>
            
            <!-- Header Section -->
            <Border Background="White" BorderBrush="{StaticResource BorderLight}" BorderThickness="1" 
                    CornerRadius="8" Padding="25" Margin="0,0,0,20">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    
                    <StackPanel Grid.Column="0">
                        <TextBlock Text="📊 Cloud-Native Value Comparison" FontSize="24" FontWeight="Bold" 
                                   Foreground="{StaticResource TextPrimary}" Margin="0,0,0,8"/>
                        <TextBlock Text="Real data from your environment showing the operational advantages of cloud-native device management" 
                                   FontSize="14" Foreground="{StaticResource TextSecondary}" TextWrapping="Wrap"/>
                    </StackPanel>
                    
                    <Button Grid.Column="1" Content="🔄 Refresh Data"
                            x:Name="RefreshButton" Click="RefreshButton_Click"
                            Background="{StaticResource PrimaryBlue}" Foreground="White"
                            Padding="15,10" FontSize="14"
                            BorderThickness="0" Cursor="Hand">
                        <Button.Template>
                            <ControlTemplate TargetType="Button">
                                <Border Background="{TemplateBinding Background}" 
                                        CornerRadius="6" Padding="{TemplateBinding Padding}">
                                    <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Border>
                            </ControlTemplate>
                        </Button.Template>
                    </Button>
                </Grid>
            </Border>
            
            <!-- Legend -->
            <Border Background="{StaticResource BackgroundSubtle}" CornerRadius="6" Padding="12" Margin="0,0,0,20">
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                    <Border Background="{StaticResource SuccessGreenLight}" CornerRadius="4" Padding="8,4" Margin="0,0,20,0">
                        <TextBlock Text="☁️ Intune (Cloud-Native)" FontSize="12" Foreground="{StaticResource SuccessGreenDark}" FontWeight="SemiBold"/>
                    </Border>
                    <TextBlock Text="vs" FontSize="12" Foreground="{StaticResource TextSecondary}" VerticalAlignment="Center" Margin="0,0,20,0"/>
                    <Border Background="{StaticResource WarningOrangeLight}" CornerRadius="4" Padding="8,4">
                        <TextBlock Text="🏢 ConfigMgr (On-Premises)" FontSize="12" Foreground="{StaticResource WarningOrange}" FontWeight="SemiBold"/>
                    </Border>
                </StackPanel>
            </Border>
            
            <!-- ═══════════════════════════════════════════════════════════════ -->
            <!-- CLOUD NATIVE PROGRESS SECTION -->
            <!-- ═══════════════════════════════════════════════════════════════ -->
            <Border Background="White" BorderBrush="{StaticResource PrimaryBlue}" BorderThickness="2" 
                    CornerRadius="12" Padding="24" Margin="0,0,0,25">
                <StackPanel>
                    <!-- Title Row -->
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,20">
                        <TextBlock Text="☁️" FontSize="28" VerticalAlignment="Center" Margin="0,0,12,0"/>
                        <StackPanel>
                            <TextBlock Text="CLOUD NATIVE PROGRESS" FontSize="18" FontWeight="Bold" Foreground="{StaticResource PrimaryBlue}"/>
                            <TextBlock Text="Devices enrolled in Intune with NO ConfigMgr dependency" 
                                       FontSize="12" Foreground="{StaticResource TextSecondary}"/>
                        </StackPanel>
                    </StackPanel>
                    
                    <!-- Metrics Row -->
                    <Grid Margin="0,0,0,20">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        
                        <!-- Cloud Native Count Tile -->
                        <Border Grid.Column="0" Background="{StaticResource InfoBlueLight}" CornerRadius="8" Padding="25,20" Margin="0,0,30,0">
                            <StackPanel HorizontalAlignment="Center">
                                <TextBlock x:Name="CloudNativeCount" Text="--" 
                                           FontSize="48" FontWeight="Bold" Foreground="{StaticResource PrimaryBlue}" 
                                           HorizontalAlignment="Center"/>
                                <TextBlock Text="Cloud Native Devices" FontSize="14" Foreground="{StaticResource PrimaryBlue}" 
                                           HorizontalAlignment="Center" FontWeight="SemiBold"/>
                                <TextBlock x:Name="CloudNativePercentText" Text="--% of total estate" 
                                           FontSize="11" Foreground="{StaticResource TextSecondary}" HorizontalAlignment="Center" Margin="0,4,0,0"/>
                            </StackPanel>
                        </Border>
                        
                        <!-- Description -->
                        <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="20,0">
                            <TextBlock Text="What is Cloud Native?" FontSize="13" FontWeight="SemiBold" 
                                       Foreground="{StaticResource TextPrimary}" Margin="0,0,0,8"/>
                            <TextBlock TextWrapping="Wrap" FontSize="12" Foreground="{StaticResource TextSecondary}" LineHeight="20">
                                <Run Text="Devices managed by Intune with NO ConfigMgr dependency:"/>
                                <LineBreak/>
                                <Run Text="✅ Autopilot or BYOD enrolled directly to Intune"/>
                                <LineBreak/>
                                <Run Text="✅ Have Azure AD identity (AzureADDeviceId)"/>
                                <LineBreak/>
                                <Run Text="✅ Not found in ConfigMgr (by ID or name)"/>
                            </TextBlock>
                        </StackPanel>
                        
                        <!-- Goal Progress -->
                        <Border Grid.Column="2" Background="{StaticResource BackgroundPage}" CornerRadius="8" Padding="20" MinWidth="180">
                            <StackPanel HorizontalAlignment="Center">
                                <TextBlock Text="🎯 Migration Goal" FontSize="12" FontWeight="SemiBold" 
                                           Foreground="{StaticResource TextPrimary}" HorizontalAlignment="Center" Margin="0,0,0,8"/>
                                <TextBlock x:Name="CloudNativeGoalPercent" Text="100%" 
                                           FontSize="28" FontWeight="Bold" Foreground="{StaticResource SuccessGreen}" HorizontalAlignment="Center"/>
                                <TextBlock Text="of devices Cloud Native" FontSize="10" Foreground="{StaticResource TextSecondary}" 
                                           HorizontalAlignment="Center"/>
                                <ProgressBar x:Name="CloudNativeGoalProgress" Value="0" Maximum="100" 
                                             Height="8" Margin="0,10,0,0" Foreground="{StaticResource PrimaryBlue}"/>
                            </StackPanel>
                        </Border>
                    </Grid>
                    
                    <!-- Trend Chart Section -->
                    <StackPanel x:Name="TrendChartPanel" Visibility="Collapsed">
                        <TextBlock Text="📈 Cloud Native Growth Trend (Last 6 Months)" 
                                   FontSize="13" FontWeight="SemiBold" Foreground="{StaticResource TextPrimary}" Margin="0,10,0,10"/>
                        
                        <lvc:CartesianChart x:Name="CloudNativeTrendChart" Height="180" DisableAnimations="True">
                            <lvc:CartesianChart.Series>
                                <lvc:LineSeries x:Name="CloudNativeSeries" 
                                                Title="Cloud Native" 
                                                Stroke="{StaticResource PrimaryBlue}" 
                                                Fill="#1A0078D4" 
                                                StrokeThickness="3"
                                                PointGeometrySize="8"
                                                LineSmoothness="0.3"/>
                            </lvc:CartesianChart.Series>
                            <lvc:CartesianChart.AxisX>
                                <lvc:Axis x:Name="CloudNativeAxisX" ShowLabels="True" FontSize="10">
                                    <lvc:Axis.Separator>
                                        <lvc:Separator StrokeThickness="0"/>
                                    </lvc:Axis.Separator>
                                </lvc:Axis>
                            </lvc:CartesianChart.AxisX>
                            <lvc:CartesianChart.AxisY>
                                <lvc:Axis Title="Devices" MinValue="0" FontSize="10">
                                    <lvc:Axis.Separator>
                                        <lvc:Separator StrokeThickness="0.5" Stroke="{StaticResource BorderLight}"/>
                                    </lvc:Axis.Separator>
                                </lvc:Axis>
                            </lvc:CartesianChart.AxisY>
                        </lvc:CartesianChart>
                    </StackPanel>
                    
                    <!-- No Trend Data Message -->
                    <Border x:Name="NoTrendDataPanel" Visibility="Visible" 
                            Background="{StaticResource InfoBlueLight}" CornerRadius="6" Padding="15" Margin="0,10,0,0">
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                            <TextBlock Text="📅" FontSize="16" Margin="0,0,8,0" VerticalAlignment="Center"/>
                            <TextBlock Text="Growth trend requires historical data. Run the tool periodically to build trend history." 
                                       FontSize="12" Foreground="{StaticResource InfoBlue}" VerticalAlignment="Center" TextWrapping="Wrap"/>
                        </StackPanel>
                    </Border>
                </StackPanel>
            </Border>

            <!-- ═══════════════════════════════════════════════════════════════ -->
            <!-- HIGH-IMPACT COMPARISON CARDS (focused view) -->
            <!-- ═══════════════════════════════════════════════════════════════ -->
            
            <!-- Row 1: Device Compliance + Security Blind Spots -->
            <Grid Margin="0,0,0,12">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="15"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                
                <!-- Card: Device Compliance -->
                <Border Grid.Column="0" Style="{StaticResource ComparisonCard}">
                    <StackPanel>
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,12">
                            <TextBlock Text="📊" FontSize="20" Margin="0,0,8,0"/>
                            <StackPanel>
                                <TextBlock Text="Device Compliance" FontSize="14" FontWeight="SemiBold" Foreground="{StaticResource TextPrimary}"/>
                                <TextBlock Text="Intune: policy compliance | ConfigMgr: client activity" FontSize="11" Foreground="{StaticResource TextSecondary}"/>
                            </StackPanel>
                        </StackPanel>
                        <Grid Margin="0,0,0,8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <Border Grid.Column="0" Style="{StaticResource IntuneSide}">
                                <StackPanel HorizontalAlignment="Center">
                                    <TextBlock Text="☁️ Intune" FontSize="11" Foreground="{StaticResource SuccessGreenDark}" HorizontalAlignment="Center"/>
                                    <TextBlock x:Name="IntuneCompliancePercent" Text="--%" FontSize="20" FontWeight="Bold" Foreground="{StaticResource SuccessGreen}" HorizontalAlignment="Center"/>
                                    <TextBlock x:Name="IntuneComplianceDevices" Text="0 devices" FontSize="9" Foreground="{StaticResource TextSecondary}" HorizontalAlignment="Center"/>
                                </StackPanel>
                            </Border>
                            <TextBlock Grid.Column="1" x:Name="ComplianceComparisonIcon" Text="📈" FontSize="14" VerticalAlignment="Center" Margin="6,0"/>
                            <Border Grid.Column="2" Style="{StaticResource ConfigMgrSide}">
                                <StackPanel HorizontalAlignment="Center">
                                    <TextBlock Text="🏢 ConfigMgr" FontSize="11" Foreground="{StaticResource WarningOrange}" HorizontalAlignment="Center"/>
                                    <TextBlock x:Name="ConfigMgrCompliancePercent" Text="--%" FontSize="20" FontWeight="Bold" Foreground="{StaticResource WarningOrange}" HorizontalAlignment="Center"/>
                                    <TextBlock x:Name="ConfigMgrComplianceDevices" Text="0 devices" FontSize="9" Foreground="{StaticResource TextSecondary}" HorizontalAlignment="Center"/>
                                </StackPanel>
                            </Border>
                        </Grid>
                        <Border Style="{StaticResource SummaryFooter}">
                            <TextBlock x:Name="ComplianceSummaryText" Text="Loading compliance data..." FontSize="12" Foreground="{StaticResource TextPrimary}" TextWrapping="Wrap" TextAlignment="Center"/>
                        </Border>
                    </StackPanel>
                </Border>
                
                <!-- Card: Security Blind Spots (Stale Devices) -->
                <Border Grid.Column="2" Style="{StaticResource ComparisonCard}">
                    <StackPanel>
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,12">
                            <TextBlock Text="🔍" FontSize="20" Margin="0,0,8,0"/>
                            <StackPanel>
                                <TextBlock Text="Security Blind Spots" FontSize="14" FontWeight="SemiBold" Foreground="{StaticResource TextPrimary}"/>
                                <TextBlock Text="Stale devices (>14 days)" FontSize="11" Foreground="{StaticResource TextSecondary}"/>
                            </StackPanel>
                        </StackPanel>
                        <Grid Margin="0,0,0,8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <Border Grid.Column="0" Style="{StaticResource IntuneSide}">
                                <StackPanel HorizontalAlignment="Center">
                                    <TextBlock Text="☁️ Intune" FontSize="11" Foreground="{StaticResource SuccessGreenDark}" HorizontalAlignment="Center"/>
                                    <TextBlock x:Name="IntuneStalePercent" Text="--%" FontSize="20" FontWeight="Bold" Foreground="{StaticResource SuccessGreen}" HorizontalAlignment="Center"/>
                                    <TextBlock x:Name="IntuneStaleCount" Text="0 stale" FontSize="9" Foreground="{StaticResource TextSecondary}" HorizontalAlignment="Center"/>
                                </StackPanel>
                            </Border>
                            <TextBlock Grid.Column="1" x:Name="StaleComparisonIcon" Text="🔍" FontSize="14" VerticalAlignment="Center" Margin="6,0"/>
                            <Border Grid.Column="2" Style="{StaticResource ConfigMgrSide}">
                                <StackPanel HorizontalAlignment="Center">
                                    <TextBlock Text="🏢 ConfigMgr" FontSize="11" Foreground="{StaticResource WarningOrange}" HorizontalAlignment="Center"/>
                                    <TextBlock x:Name="ConfigMgrStalePercent" Text="--%" FontSize="20" FontWeight="Bold" Foreground="{StaticResource WarningOrange}" HorizontalAlignment="Center"/>
                                    <TextBlock x:Name="ConfigMgrStaleCount" Text="0 stale" FontSize="9" Foreground="{StaticResource TextSecondary}" HorizontalAlignment="Center"/>
                                </StackPanel>
                            </Border>
                        </Grid>
                        <Border Style="{StaticResource SummaryFooter}">
                            <TextBlock x:Name="StaleSummaryText" Text="Fewer stale devices = fewer security blind spots" FontSize="12" Foreground="{StaticResource TextPrimary}" TextWrapping="Wrap" TextAlignment="Center"/>
                        </Border>
                    </StackPanel>
                </Border>
            </Grid>
            
            <!-- Row 2: Zero Trust Ready + Enrollment Velocity -->
            <Grid Margin="0,0,0,12">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="15"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                
                <!-- Card: Zero Trust Ready (Conditional Access) -->
                <Border Grid.Column="0" Style="{StaticResource ComparisonCard}">
                    <StackPanel>
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,12">
                            <TextBlock Text="🛡️" FontSize="20" Margin="0,0,8,0"/>
                            <StackPanel>
                                <TextBlock Text="Zero Trust Ready" FontSize="14" FontWeight="SemiBold" Foreground="{StaticResource TextPrimary}"/>
                                <TextBlock Text="Conditional Access eligible" FontSize="11" Foreground="{StaticResource TextSecondary}"/>
                            </StackPanel>
                        </StackPanel>
                        <Grid Margin="0,0,0,8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <Border Grid.Column="0" Style="{StaticResource IntuneSide}">
                                <StackPanel HorizontalAlignment="Center">
                                    <TextBlock Text="☁️ Intune" FontSize="11" Foreground="{StaticResource SuccessGreenDark}" HorizontalAlignment="Center"/>
                                    <TextBlock x:Name="IntuneCAPercent" Text="--%" FontSize="20" FontWeight="Bold" Foreground="{StaticResource SuccessGreen}" HorizontalAlignment="Center"/>
                                    <TextBlock x:Name="IntuneCACount" Text="0 CA-ready" FontSize="9" Foreground="{StaticResource TextSecondary}" HorizontalAlignment="Center"/>
                                </StackPanel>
                            </Border>
                            <TextBlock Grid.Column="1" x:Name="CAComparisonIcon" Text="🛡️" FontSize="14" VerticalAlignment="Center" Margin="6,0"/>
                            <Border Grid.Column="2" Background="{StaticResource ErrorRedLight}" CornerRadius="6" Padding="12">
                                <StackPanel HorizontalAlignment="Center">
                                    <TextBlock Text="🏢 ConfigMgr-only" FontSize="11" Foreground="{StaticResource ErrorRedDark}" HorizontalAlignment="Center"/>
                                    <TextBlock x:Name="ConfigMgrCAPercent" Text="0%" FontSize="20" FontWeight="Bold" Foreground="{StaticResource ErrorRed}" HorizontalAlignment="Center"/>
                                    <TextBlock x:Name="ConfigMgrCACount" Text="Not eligible" FontSize="9" Foreground="{StaticResource TextSecondary}" HorizontalAlignment="Center"/>
                                </StackPanel>
                            </Border>
                        </Grid>
                        <Border Background="{StaticResource WarningOrangeLight}" CornerRadius="4" Padding="8" Margin="0,10,0,0">
                            <TextBlock x:Name="CASummaryText" Text="ConfigMgr-only devices cannot participate in Zero Trust" FontSize="12" Foreground="{StaticResource WarningOrange}" TextWrapping="Wrap" TextAlignment="Center"/>
                        </Border>
                    </StackPanel>
                </Border>
                
                <!-- Card: Enrollment Velocity -->
                <Border Grid.Column="2" Style="{StaticResource ComparisonCard}">
                    <StackPanel>
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,12">
                            <TextBlock Text="📈" FontSize="20" Margin="0,0,8,0"/>
                            <StackPanel>
                                <TextBlock Text="Enrollment Velocity" FontSize="14" FontWeight="SemiBold" Foreground="{StaticResource TextPrimary}"/>
                                <TextBlock Text="Weekly enrollment trend" FontSize="11" Foreground="{StaticResource TextSecondary}"/>
                            </StackPanel>
                        </StackPanel>
                        <Grid Margin="0,0,0,8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <Border Grid.Column="0" Style="{StaticResource IntuneSide}">
                                <StackPanel HorizontalAlignment="Center">
                                    <TextBlock Text="☁️ This Week" FontSize="11" Foreground="{StaticResource SuccessGreenDark}" HorizontalAlignment="Center"/>
                                    <TextBlock x:Name="EnrollmentThisWeek" Text="--" FontSize="20" FontWeight="Bold" Foreground="{StaticResource SuccessGreen}" HorizontalAlignment="Center"/>
                                    <TextBlock Text="new enrollments" FontSize="9" Foreground="{StaticResource TextSecondary}" HorizontalAlignment="Center"/>
                                    <TextBlock x:Name="EnrollmentTrendArrow" Text="" FontSize="11" Foreground="{StaticResource PrimaryBlue}" HorizontalAlignment="Center" Margin="0,4,0,0"/>
                                </StackPanel>
                            </Border>
                            <TextBlock Grid.Column="1" x:Name="VelocityComparisonIcon" Text="📈" FontSize="14" VerticalAlignment="Center" Margin="6,0"/>
                            <Border Grid.Column="2" Style="{StaticResource ConfigMgrSide}">
                                <StackPanel HorizontalAlignment="Center">
                                    <TextBlock Text="🏢 Provisioning" FontSize="11" Foreground="{StaticResource WarningOrange}" HorizontalAlignment="Center"/>
                                    <TextBlock x:Name="ConfigMgrProvisionEstimate" Text="~4 hrs" FontSize="20" FontWeight="Bold" Foreground="{StaticResource WarningOrange}" HorizontalAlignment="Center"/>
                                    <TextBlock Text="IT hands-on (imaging)" FontSize="9" Foreground="{StaticResource TextSecondary}" HorizontalAlignment="Center"/>
                                    <TextBlock x:Name="AutopilotProvisionEstimate" Text="vs ~30 min self-service" FontSize="9" Foreground="{StaticResource PrimaryBlue}" HorizontalAlignment="Center" Margin="0,4,0,0"/>
                                </StackPanel>
                            </Border>
                        </Grid>
                        <Border Style="{StaticResource SummaryFooter}">
                            <TextBlock x:Name="VelocitySummaryText" Text="Cloud enrollment is accelerating week over week" FontSize="12" Foreground="{StaticResource TextPrimary}" TextWrapping="Wrap" TextAlignment="Center"/>
                        </Border>
                    </StackPanel>
                </Border>
            </Grid>
            
            <!-- Row 3: Autopilot vs Imaging + Update Ring Coverage -->
            <Grid Margin="0,0,0,12">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="15"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                
                <!-- Card: Autopilot vs Imaging -->
                <Border Grid.Column="0" Style="{StaticResource ComparisonCard}">
                    <StackPanel>
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,12">
                            <TextBlock Text="🚀" FontSize="20" Margin="0,0,8,0"/>
                            <StackPanel>
                                <TextBlock Text="Autopilot vs. Imaging" FontSize="14" FontWeight="SemiBold" Foreground="{StaticResource TextPrimary}"/>
                                <TextBlock Text="Cloud provisioning readiness" FontSize="11" Foreground="{StaticResource TextSecondary}"/>
                            </StackPanel>
                        </StackPanel>
                        <Grid Margin="0,0,0,8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <Border Grid.Column="0" Style="{StaticResource IntuneSide}">
                                <StackPanel HorizontalAlignment="Center">
                                    <TextBlock Text="☁️ Autopilot" FontSize="11" Foreground="{StaticResource SuccessGreenDark}" HorizontalAlignment="Center"/>
                                    <TextBlock x:Name="AutopilotRegistered" Text="--" FontSize="20" FontWeight="Bold" Foreground="{StaticResource SuccessGreen}" HorizontalAlignment="Center"/>
                                    <TextBlock Text="registered" FontSize="9" Foreground="{StaticResource TextSecondary}" HorizontalAlignment="Center"/>
                                    <TextBlock x:Name="AutopilotProfiles" Text="" FontSize="9" Foreground="{StaticResource PrimaryBlue}" HorizontalAlignment="Center" Margin="0,4,0,0"/>
                                </StackPanel>
                            </Border>
                            <TextBlock Grid.Column="1" x:Name="AutopilotIcon" Text="🚀" FontSize="14" VerticalAlignment="Center" Margin="6,0"/>
                            <Border Grid.Column="2" Style="{StaticResource ConfigMgrSide}">
                                <StackPanel HorizontalAlignment="Center">
                                    <TextBlock Text="🏢 ConfigMgr" FontSize="11" Foreground="{StaticResource WarningOrange}" HorizontalAlignment="Center"/>
                                    <TextBlock x:Name="ConfigMgrImagingDevices" Text="--" FontSize="20" FontWeight="Bold" Foreground="{StaticResource WarningOrange}" HorizontalAlignment="Center"/>
                                    <TextBlock Text="task sequences" FontSize="9" Foreground="{StaticResource TextSecondary}" HorizontalAlignment="Center"/>
                                    <TextBlock Text="Requires on-prem infra" FontSize="9" Foreground="{StaticResource WarningOrange}" HorizontalAlignment="Center" Margin="0,4,0,0"/>
                                </StackPanel>
                            </Border>
                        </Grid>
                        <Border Style="{StaticResource SummaryFooter}">
                            <TextBlock x:Name="AutopilotSummaryText" Text="Autopilot: self-provision from anywhere, no imaging required" FontSize="12" Foreground="{StaticResource TextPrimary}" TextWrapping="Wrap" TextAlignment="Center"/>
                        </Border>
                    </StackPanel>
                </Border>
                
                <!-- Card: Update Ring Coverage -->
                <Border Grid.Column="2" Style="{StaticResource ComparisonCard}">
                    <StackPanel>
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,12">
                            <TextBlock Text="🔄" FontSize="20" Margin="0,0,8,0"/>
                            <StackPanel>
                                <TextBlock Text="Update Ring Coverage" FontSize="14" FontWeight="SemiBold" Foreground="{StaticResource TextPrimary}"/>
                                <TextBlock Text="WUfB rings vs. WSUS/SUP" FontSize="11" Foreground="{StaticResource TextSecondary}"/>
                            </StackPanel>
                        </StackPanel>
                        <Grid Margin="0,0,0,8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <Border Grid.Column="0" Style="{StaticResource IntuneSide}">
                                <StackPanel HorizontalAlignment="Center">
                                    <TextBlock Text="☁️ WUfB" FontSize="11" Foreground="{StaticResource SuccessGreenDark}" HorizontalAlignment="Center"/>
                                    <TextBlock x:Name="IntuneRingCount" Text="--" FontSize="20" FontWeight="Bold" Foreground="{StaticResource SuccessGreen}" HorizontalAlignment="Center"/>
                                    <TextBlock Text="update rings" FontSize="9" Foreground="{StaticResource TextSecondary}" HorizontalAlignment="Center"/>
                                    <TextBlock x:Name="IntuneRingDevices" Text="" FontSize="9" Foreground="{StaticResource PrimaryBlue}" HorizontalAlignment="Center" Margin="0,4,0,0"/>
                                </StackPanel>
                            </Border>
                            <TextBlock Grid.Column="1" x:Name="UpdateRingIcon" Text="🔄" FontSize="14" VerticalAlignment="Center" Margin="6,0"/>
                            <Border Grid.Column="2" Style="{StaticResource ConfigMgrSide}">
                                <StackPanel HorizontalAlignment="Center">
                                    <TextBlock Text="🏢 WSUS/SUP" FontSize="11" Foreground="{StaticResource WarningOrange}" HorizontalAlignment="Center"/>
                                    <TextBlock x:Name="ConfigMgrUpdateDevices" Text="--" FontSize="20" FontWeight="Bold" Foreground="{StaticResource WarningOrange}" HorizontalAlignment="Center"/>
                                    <TextBlock Text="devices" FontSize="9" Foreground="{StaticResource TextSecondary}" HorizontalAlignment="Center"/>
                                    <TextBlock x:Name="ConfigMgrUpdateCompliance" Text="" FontSize="9" Foreground="{StaticResource TextSecondary}" HorizontalAlignment="Center" Margin="0,4,0,0"/>
                                </StackPanel>
                            </Border>
                        </Grid>
                        <Border Style="{StaticResource SummaryFooter}">
                            <TextBlock x:Name="UpdateRingSummaryText" Text="WUfB delivers updates from Microsoft CDN — no WSUS infrastructure" FontSize="12" Foreground="{StaticResource TextPrimary}" TextWrapping="Wrap" TextAlignment="Center"/>
                        </Border>
                    </StackPanel>
                </Border>
            </Grid>

            <!-- ═══════════════════════════════════════════════════════════════ -->
            <!-- DEFENDER INTEGRATION (Full-width)                              -->
            <!-- ═══════════════════════════════════════════════════════════════ -->
            <Border Style="{StaticResource ComparisonCard}" BorderBrush="{StaticResource PrimaryBlue}" BorderThickness="2" Margin="0,0,0,12">
                <StackPanel>
                    <Grid Margin="0,0,0,12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel Orientation="Horizontal" Grid.Column="0">
                            <TextBlock Text="🛡️" FontSize="20" Margin="0,0,8,0"/>
                            <StackPanel>
                                <TextBlock Text="Microsoft Defender Integration" FontSize="14" FontWeight="SemiBold" Foreground="{StaticResource TextPrimary}"/>
                                <TextBlock Text="Real-time threat visibility - the cloud advantage" FontSize="11" Foreground="{StaticResource TextSecondary}"/>
                            </StackPanel>
                        </StackPanel>
                        <Border x:Name="DefenderLicenseBadge" Grid.Column="1" Style="{StaticResource LicenseStatusLicensed}" VerticalAlignment="Center">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock x:Name="DefenderLicenseIcon" Text="🟢" FontSize="10" Margin="0,0,4,0" VerticalAlignment="Center"/>
                                <TextBlock x:Name="DefenderLicenseText" Text="MDE Licensed" FontSize="10" FontWeight="SemiBold" Foreground="{StaticResource SuccessGreen}" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Border>
                    </Grid>
                    
                    <Border x:Name="DefenderNotLicensedBanner" Background="{StaticResource ErrorRedLight}" 
                            BorderBrush="{StaticResource ErrorRed}" BorderThickness="1" CornerRadius="6" 
                            Padding="12" Margin="0,0,0,12" Visibility="Collapsed">
                        <StackPanel>
                            <TextBlock Text="⚠️ Microsoft Defender for Endpoint Not Licensed" FontSize="13" FontWeight="Bold" 
                                       Foreground="{StaticResource ErrorRedDark}" Margin="0,0,0,8"/>
                            <TextBlock Text="You're missing real-time threat visibility. With MDE, you can see:" FontSize="11" 
                                       Foreground="{StaticResource TextPrimary}" TextWrapping="Wrap" Margin="0,0,0,8"/>
                            <StackPanel Margin="12,0,0,0">
                                <TextBlock Text="• Which devices have active malware infections" FontSize="11" Foreground="{StaticResource TextSecondary}"/>
                                <TextBlock Text="• Real-time threat state (compromised, misconfigured, at risk)" FontSize="11" Foreground="{StaticResource TextSecondary}"/>
                                <TextBlock Text="• Automatic threat remediation tracking" FontSize="11" Foreground="{StaticResource TextSecondary}"/>
                            </StackPanel>
                            <TextBlock x:Name="DefenderNotLicensedHint" Text="" FontSize="11" FontStyle="Italic" 
                                       Foreground="{StaticResource TextSecondary}" Margin="0,8,0,0" TextWrapping="Wrap"/>
                        </StackPanel>
                    </Border>
                    
                    <Grid x:Name="DefenderComparisonGrid">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="30"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <Border Grid.Column="0" Style="{StaticResource IntuneSidePanel}">
                            <StackPanel>
                                <TextBlock Text="☁️ Intune + Defender" FontSize="12" Foreground="{StaticResource SuccessGreenDark}" FontWeight="SemiBold" HorizontalAlignment="Center" Margin="0,0,0,12"/>
                                <StackPanel x:Name="DefenderDataPanel" HorizontalAlignment="Center" Margin="0,0,0,8">
                                    <TextBlock x:Name="DefenderMDEOnboarded" Text="-- devices with MDE visibility" FontSize="14" FontWeight="Bold" Foreground="{StaticResource SuccessGreen}" HorizontalAlignment="Center"/>
                                    <TextBlock x:Name="DefenderRealTimeProtection" Text="-- with real-time malware reporting" FontSize="11" Foreground="{StaticResource SuccessGreenDark}" HorizontalAlignment="Center" Margin="0,4,0,0"/>
                                    <TextBlock x:Name="DefenderRemediatedCount" Text="" FontSize="11" Foreground="{StaticResource SuccessGreen}" HorizontalAlignment="Center" Margin="0,4,0,0"/>
                                </StackPanel>
                                <Border x:Name="DefenderOnboardingHint" Background="{StaticResource WarningOrangeLight}" 
                                        CornerRadius="4" Padding="8,6" Margin="0,0,0,8" Visibility="Collapsed">
                                    <TextBlock Text="Devices need MDE sensor deployed to report threat data" FontSize="10" Foreground="{StaticResource WarningOrangeDark}" TextWrapping="Wrap" TextAlignment="Center"/>
                                </Border>
                                <WrapPanel x:Name="DefenderCapabilityTags" HorizontalAlignment="Center" Margin="0,8,0,0">
                                    <Border Style="{StaticResource FeatureTagBadge}">
                                        <TextBlock Text="Threat State" FontSize="10" Foreground="{StaticResource SuccessGreenDark}"/>
                                    </Border>
                                    <Border Style="{StaticResource FeatureTagBadge}">
                                        <TextBlock Text="Malware Count" FontSize="10" Foreground="{StaticResource SuccessGreenDark}"/>
                                    </Border>
                                    <Border Style="{StaticResource FeatureTagBadge}">
                                        <TextBlock Text="Auto-Remediate" FontSize="10" Foreground="{StaticResource SuccessGreenDark}"/>
                                    </Border>
                                </WrapPanel>
                            </StackPanel>
                        </Border>
                        <TextBlock Grid.Column="1" Text="vs" FontSize="14" Foreground="{StaticResource TextSecondary}" VerticalAlignment="Center" HorizontalAlignment="Center"/>
                        <Border Grid.Column="2" Style="{StaticResource ConfigMgrSidePanel}">
                            <StackPanel>
                                <TextBlock Text="🏢 ConfigMgr" FontSize="12" Foreground="{StaticResource WarningOrange}" FontWeight="SemiBold" HorizontalAlignment="Center" Margin="0,0,0,12"/>
                                <StackPanel HorizontalAlignment="Center" Margin="0,0,0,8">
                                    <TextBlock x:Name="DefenderConfigMgrEnabled" Text="-- devices with 'AV enabled'" FontSize="14" FontWeight="Bold" Foreground="{StaticResource WarningOrange}" HorizontalAlignment="Center"/>
                                    <TextBlock Text="No real-time threat visibility" FontSize="11" Foreground="{StaticResource WarningOrangeDark}" HorizontalAlignment="Center" Margin="0,4,0,0" FontStyle="Italic"/>
                                </StackPanel>
                                <Border Style="{StaticResource WarningBadge}">
                                    <TextBlock Text="⚠️ ConfigMgr can tell you AV is installed, but NOT if a device is actively infected." FontSize="10" Foreground="{StaticResource ErrorRedDark}" TextWrapping="Wrap" TextAlignment="Center"/>
                                </Border>
                            </StackPanel>
                        </Border>
                    </Grid>
                    
                    <Border x:Name="DefenderSummaryBorder" Style="{StaticResource SummaryFooterPanel}" Background="{StaticResource SuccessGreenLight}">
                        <TextBlock x:Name="DefenderSummaryText" Text="Connect to see your threat visibility comparison" FontSize="12" Foreground="{StaticResource SuccessGreen}" TextWrapping="Wrap" TextAlignment="Center" FontWeight="SemiBold"/>
                    </Border>
                </StackPanel>
            </Border>

            <!-- ═══════════════════════════════════════════════════════════════ -->
            <!-- CONFIGMGR AGENT REMOVAL RECOMMENDATION                         -->
            <!-- ═══════════════════════════════════════════════════════════════ -->
            <Border x:Name="AgentRemovalCard" Style="{StaticResource ComparisonCard}" BorderBrush="{StaticResource SuccessGreen}" BorderThickness="2" Margin="0,0,0,12">
                <StackPanel>
                    <Grid Margin="0,0,0,12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel Orientation="Horizontal" Grid.Column="0">
                            <TextBlock Text="🎯" FontSize="20" Margin="0,0,8,0"/>
                            <StackPanel>
                                <TextBlock Text="Ready for ConfigMgr Agent Removal" FontSize="14" FontWeight="SemiBold" Foreground="{StaticResource TextPrimary}"/>
                                <TextBlock Text="Devices with ALL workloads managed by Intune" FontSize="11" Foreground="{StaticResource TextSecondary}"/>
                            </StackPanel>
                        </StackPanel>
                        <Border x:Name="AgentRemovalBadge" Grid.Column="1" Background="{StaticResource SuccessGreenLight}" 
                                CornerRadius="12" Padding="10,4" VerticalAlignment="Center">
                            <TextBlock x:Name="AgentRemovalBadgeText" Text="RECOMMENDATION" FontSize="10" FontWeight="Bold" Foreground="{StaticResource SuccessGreen}"/>
                        </Border>
                    </Grid>
                    
                    <!-- Key Metric -->
                    <Grid Margin="0,0,0,16">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        
                        <!-- Ready Count -->
                        <Border Grid.Column="0" Background="{StaticResource SuccessGreenLight}" CornerRadius="8" Padding="20,15" Margin="0,0,20,0">
                            <StackPanel HorizontalAlignment="Center">
                                <TextBlock x:Name="AgentRemovalReadyCount" Text="--" FontSize="36" FontWeight="Bold" Foreground="{StaticResource SuccessGreen}" HorizontalAlignment="Center"/>
                                <TextBlock Text="devices ready" FontSize="12" Foreground="{StaticResource SuccessGreenDark}" HorizontalAlignment="Center" FontWeight="SemiBold"/>
                                <TextBlock x:Name="AgentRemovalReadyPercent" Text="--% of co-managed" FontSize="10" Foreground="{StaticResource TextSecondary}" HorizontalAlignment="Center" Margin="0,4,0,0"/>
                            </StackPanel>
                        </Border>
                        
                        <!-- Rationale -->
                        <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="10,0">
                            <TextBlock Text="Why remove the ConfigMgr agent?" FontSize="13" FontWeight="SemiBold" Foreground="{StaticResource TextPrimary}" Margin="0,0,0,8"/>
                            <TextBlock TextWrapping="Wrap" FontSize="12" Foreground="{StaticResource TextSecondary}" LineHeight="20">
                                <Run Text="These devices have ALL 7 co-management workloads on Intune:"/>
                                <LineBreak/>
                                <Run Text="✅ No policies, updates, or apps coming from ConfigMgr"/>
                                <LineBreak/>
                                <Run Text="✅ Removing the agent completes their cloud-native journey"/>
                                <LineBreak/>
                                <Run Text="✅ Reduces on-prem infrastructure dependency"/>
                            </TextBlock>
                        </StackPanel>
                        
                        <!-- Not Ready -->
                        <Border Grid.Column="2" Background="{StaticResource WarningOrangeLight}" CornerRadius="8" Padding="20,15" MinWidth="140">
                            <StackPanel HorizontalAlignment="Center">
                                <TextBlock x:Name="AgentRemovalNotReadyCount" Text="--" FontSize="36" FontWeight="Bold" Foreground="{StaticResource WarningOrange}" HorizontalAlignment="Center"/>
                                <TextBlock Text="still need ConfigMgr" FontSize="12" Foreground="{StaticResource WarningOrangeDark}" HorizontalAlignment="Center" FontWeight="SemiBold"/>
                                <TextBlock x:Name="AgentRemovalBlockerText" Text="" FontSize="10" Foreground="{StaticResource TextSecondary}" HorizontalAlignment="Center" Margin="0,4,0,0"/>
                            </StackPanel>
                        </Border>
                    </Grid>
                    
                    <!-- Workload Checklist Progress -->
                    <Border x:Name="AgentRemovalWorkloadPanel" Background="{StaticResource BackgroundPage}" CornerRadius="6" Padding="15" Margin="0,0,0,12">
                        <StackPanel>
                            <TextBlock Text="Workload Authority Breakdown (across co-managed fleet)" FontSize="12" FontWeight="SemiBold" 
                                       Foreground="{StaticResource TextPrimary}" Margin="0,0,0,10"/>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="0">
                                    <TextBlock x:Name="AgentRemovalWL1" Text="⬜ Compliance Policy" FontSize="11" Foreground="{StaticResource TextSecondary}" Margin="0,2"/>
                                    <TextBlock x:Name="AgentRemovalWL2" Text="⬜ Device Configuration" FontSize="11" Foreground="{StaticResource TextSecondary}" Margin="0,2"/>
                                    <TextBlock x:Name="AgentRemovalWL3" Text="⬜ Windows Update" FontSize="11" Foreground="{StaticResource TextSecondary}" Margin="0,2"/>
                                    <TextBlock x:Name="AgentRemovalWL4" Text="⬜ Endpoint Protection" FontSize="11" Foreground="{StaticResource TextSecondary}" Margin="0,2"/>
                                </StackPanel>
                                <StackPanel Grid.Column="1">
                                    <TextBlock x:Name="AgentRemovalWL5" Text="⬜ Modern Apps" FontSize="11" Foreground="{StaticResource TextSecondary}" Margin="0,2"/>
                                    <TextBlock x:Name="AgentRemovalWL6" Text="⬜ Office Apps" FontSize="11" Foreground="{StaticResource TextSecondary}" Margin="0,2"/>
                                    <TextBlock x:Name="AgentRemovalWL7" Text="⬜ Resource Access" FontSize="11" Foreground="{StaticResource TextSecondary}" Margin="0,2"/>
                                </StackPanel>
                            </Grid>
                        </StackPanel>
                    </Border>
                    
                    <!-- Summary -->
                    <Border Background="{StaticResource SuccessGreenLight}" CornerRadius="4" Padding="12">
                        <TextBlock x:Name="AgentRemovalSummaryText" 
                                   Text="Devices with all workloads on Intune are candidates for ConfigMgr agent removal — completing their cloud-native transition." 
                                   FontSize="12" Foreground="{StaticResource SuccessGreen}" TextWrapping="Wrap" TextAlignment="Center" FontWeight="SemiBold"/>
                    </Border>
                </StackPanel>
            </Border>

            <!-- Call to Action -->
            <Border Background="White" BorderBrush="{StaticResource PrimaryBlue}" BorderThickness="2" 
                    CornerRadius="8" Padding="25" Margin="0,20,0,20">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    
                    <StackPanel Grid.Column="0">
                        <TextBlock Text="🚀 Ready to Experience Cloud-Native Management?" FontSize="18" FontWeight="SemiBold" 
                                   Foreground="{StaticResource TextPrimary}"/>
                        <TextBlock Text="Every device moved to Intune gains these operational advantages. Co-management is your bridge—start moving workloads today." 
                                   FontSize="13" Foreground="{StaticResource TextSecondary}" TextWrapping="Wrap" Margin="0,8,0,0"/>
                    </StackPanel>
                    
                    <Button Grid.Column="1" Content="View Enrollment Tab →"
                            x:Name="ViewEnrollmentButton" Click="ViewEnrollmentButton_Click"
                            Background="{StaticResource PrimaryBlue}" Foreground="White"
                            Padding="20,12" FontSize="14" FontWeight="SemiBold"
                            BorderThickness="0" Cursor="Hand" Margin="20,0,0,0">
                        <Button.Template>
                            <ControlTemplate TargetType="Button">
                                <Border Background="{TemplateBinding Background}" 
                                        CornerRadius="6" Padding="{TemplateBinding Padding}">
                                    <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Border>
                            </ControlTemplate>
                        </Button.Template>
                    </Button>
                </Grid>
            </Border>
            
            <!-- Loading Overlay -->
            <Border x:Name="LoadingOverlay" Background="#80FFFFFF" 
                    Visibility="Collapsed" HorizontalAlignment="Stretch" VerticalAlignment="Stretch">
                <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                    <TextBlock Text="⏳" FontSize="48" HorizontalAlignment="Center"/>
                    <TextBlock Text="Loading comparison data..." FontSize="16" 
                               Foreground="{StaticResource TextSecondary}" Margin="0,10,0,0"/>
                </StackPanel>
            </Border>
            
        </StackPanel>
    </ScrollViewer>
</UserControl>


