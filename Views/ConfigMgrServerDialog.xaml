<Window x:Class="ZeroTrustMigrationAddin.Views.ConfigMgrServerDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="ConfigMgr Site Server" 
        Height="560" Width="480"
        WindowStartupLocation="CenterOwner"
        WindowStyle="SingleBorderWindow"
        ResizeMode="NoResize"
        Background="#F3F3F3"
        FontFamily="Segoe UI Emoji, Segoe UI, Arial"
        ShowInTaskbar="False">
    
    <Window.Resources>
        <Style x:Key="ModernButton" TargetType="Button">
            <Setter Property="Background" Value="#0078D4"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Padding" Value="20,10"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" 
                                CornerRadius="4" 
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Background" Value="#106EBE"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter Property="Background" Value="#005A9E"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        
        <Style x:Key="SecondaryButton" TargetType="Button" BasedOn="{StaticResource ModernButton}">
            <Setter Property="Background" Value="#E1E1E1"/>
            <Setter Property="Foreground" Value="#323130"/>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#D1D1D1"/>
                </Trigger>
            </Style.Triggers>
        </Style>
        
        <Style x:Key="ModernTextBox" TargetType="TextBox">
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="Padding" Value="12,10"/>
            <Setter Property="BorderBrush" Value="#8A8886"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TextBox">
                        <Border Background="White" 
                                BorderBrush="{TemplateBinding BorderBrush}" 
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="4">
                            <ScrollViewer x:Name="PART_ContentHost" Margin="{TemplateBinding Padding}"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsFocused" Value="True">
                                <Setter Property="BorderBrush" Value="#0078D4"/>
                                <Setter Property="BorderThickness" Value="2"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        
        <Style x:Key="ModernPasswordBox" TargetType="PasswordBox">
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="Padding" Value="12,10"/>
            <Setter Property="BorderBrush" Value="#8A8886"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="PasswordBox">
                        <Border Background="White" 
                                BorderBrush="{TemplateBinding BorderBrush}" 
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="4">
                            <ScrollViewer x:Name="PART_ContentHost" Margin="{TemplateBinding Padding}"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsFocused" Value="True">
                                <Setter Property="BorderBrush" Value="#0078D4"/>
                                <Setter Property="BorderThickness" Value="2"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>
    
    <Grid Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        
        <!-- Header -->
        <StackPanel Grid.Row="0" Margin="0,0,0,16">
            <TextBlock Text="🖥️ Connect to ConfigMgr" FontSize="20" FontWeight="SemiBold" Foreground="#323130"/>
            <TextBlock Text="Enter your ConfigMgr Site Server name or FQDN" 
                       FontSize="13" Foreground="#605E5C" Margin="0,4,0,0"/>
        </StackPanel>
        
        <!-- Input Field -->
        <StackPanel Grid.Row="1" Margin="0,0,0,16">
            <TextBlock Text="Site Server" FontSize="13" FontWeight="SemiBold" Foreground="#323130" Margin="0,0,0,6"/>
            <TextBox x:Name="ServerNameTextBox" Style="{StaticResource ModernTextBox}"/>
        </StackPanel>
        
        <!-- Alternate Credentials Section -->
        <StackPanel Grid.Row="2" Margin="0,0,0,16">
            <CheckBox x:Name="UseAlternateCredsCheckBox" 
                      Content="Use alternate account" 
                      FontSize="13" 
                      Foreground="#323130"
                      Checked="UseAlternateCredsCheckBox_Changed"
                      Unchecked="UseAlternateCredsCheckBox_Changed"/>
            <TextBlock Text="Connect with different credentials than your current Windows login"
                       FontSize="11" Foreground="#605E5C" Margin="20,2,0,0"/>
            
            <!-- Credential Fields (hidden by default) -->
            <Border x:Name="CredentialsPanel" 
                    Background="#E8F4FD" 
                    BorderBrush="#0078D4" 
                    BorderThickness="1"
                    CornerRadius="4" 
                    Padding="12" 
                    Margin="0,12,0,0"
                    Visibility="Collapsed">
                <StackPanel>
                    <TextBlock Text="Username" FontSize="12" FontWeight="SemiBold" Foreground="#323130" Margin="0,0,0,4"/>
                    <TextBox x:Name="UsernameTextBox" Style="{StaticResource ModernTextBox}"/>
                    <TextBlock Text="Format: DOMAIN\username or user@domain.com" 
                               FontSize="11" Foreground="#605E5C" Margin="0,4,0,8"/>
                    
                    <TextBlock Text="Password" FontSize="12" FontWeight="SemiBold" Foreground="#323130" Margin="0,4,0,4"/>
                    <PasswordBox x:Name="PasswordBox" Style="{StaticResource ModernPasswordBox}"/>
                    
                    <StackPanel Orientation="Horizontal" Margin="0,10,0,0">
                        <TextBlock Text="🔒" FontSize="12" Margin="0,0,4,0"/>
                        <TextBlock Text="Credentials are encrypted and stored locally on this computer only." 
                                   FontSize="11" Foreground="#605E5C" TextWrapping="Wrap"/>
                    </StackPanel>
                </StackPanel>
            </Border>
        </StackPanel>
        
        <!-- Examples -->
        <Border Grid.Row="3" Background="#F0F0F0" CornerRadius="4" Padding="12" Margin="0,0,0,12">
            <StackPanel>
                <TextBlock Text="Examples:" FontSize="12" FontWeight="SemiBold" Foreground="#605E5C" Margin="0,0,0,6"/>
                <TextBlock Text="• CM01.contoso.com" FontSize="12" Foreground="#605E5C"/>
                <TextBlock Text="• sccm.corp.contoso.local" FontSize="12" Foreground="#605E5C"/>
            </StackPanel>
        </Border>
        
        <!-- Info Text -->
        <TextBlock Grid.Row="4" 
                   Text="The app will try both Admin Service (REST API) and WMI as fallback."
                   FontSize="12" Foreground="#605E5C" 
                   TextWrapping="Wrap"
                   VerticalAlignment="Bottom"
                   Margin="0,0,0,12"/>
        
        <!-- Buttons -->
        <StackPanel Grid.Row="5" Orientation="Horizontal" HorizontalAlignment="Right">
            <Button x:Name="TestConnectionButton" 
                    Content="Test Connection" 
                    Style="{StaticResource SecondaryButton}"
                    Click="TestConnectionButton_Click"
                    Margin="0,0,10,0"
                    MinWidth="110"
                    Visibility="Collapsed"/>
            <Button x:Name="CancelButton" 
                    Content="Cancel" 
                    Style="{StaticResource SecondaryButton}"
                    Click="CancelButton_Click"
                    Margin="0,0,10,0"
                    MinWidth="90"/>
            <Button x:Name="ConnectButton" 
                    Content="Connect" 
                    Style="{StaticResource ModernButton}"
                    Click="ConnectButton_Click"
                    IsDefault="True"
                    MinWidth="90"/>
        </StackPanel>
    </Grid>
</Window>
