<Window x:Class="ZeroTrustMigrationAddin.Views.EulaWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="License Agreement - Microsoft Zero Trust Cloud Journey"
        Height="650" Width="750"
        WindowStartupLocation="CenterScreen"
        Background="#F5F5F5"
        FontFamily="Segoe UI, Arial"
        ResizeMode="NoResize"
        ShowInTaskbar="True"
        WindowStyle="SingleBorderWindow">

    <Window.Resources>
        <!-- Primary Accept Button -->
        <Style x:Key="AcceptButton" TargetType="Button">
            <Setter Property="Background" Value="#107C10"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="Padding" Value="24,12"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" 
                                CornerRadius="4" 
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Background" Value="#0E6B0E"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Background" Value="#CCCCCC"/>
                                <Setter Property="Foreground" Value="#888888"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Decline Button -->
        <Style x:Key="DeclineButton" TargetType="Button">
            <Setter Property="Background" Value="#E1E1E1"/>
            <Setter Property="Foreground" Value="#323130"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="Padding" Value="24,12"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" 
                                CornerRadius="4" 
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Background" Value="#D1D1D1"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Checkbox Style -->
        <Style x:Key="AcceptCheckbox" TargetType="CheckBox">
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="Foreground" Value="#323130"/>
            <Setter Property="Cursor" Value="Hand"/>
        </Style>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Header -->
        <Border Grid.Row="0" Background="#0078D4" Padding="24,20">
            <StackPanel>
                <TextBlock Text="📋 End User License Agreement" 
                           FontSize="24" FontWeight="SemiBold" Foreground="White"/>
                <TextBlock Text="Microsoft Zero Trust Cloud Journey Assessment Tool" 
                           FontSize="14" Foreground="#E0E0E0" Margin="0,8,0,0"/>
            </StackPanel>
        </Border>

        <!-- EULA Content -->
        <Border Grid.Row="1" Margin="24,16" Background="White" BorderBrush="#E0E0E0" BorderThickness="1" CornerRadius="4">
            <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="20">
                <TextBlock x:Name="EulaTextBlock" 
                           TextWrapping="Wrap" 
                           FontSize="13" 
                           LineHeight="22"
                           Foreground="#323130">
                    <!-- EULA content will be loaded from code-behind -->
                </TextBlock>
            </ScrollViewer>
        </Border>

        <!-- Acceptance Checkbox -->
        <Border Grid.Row="2" Margin="24,0,24,16" Padding="16" Background="#FFF8E1" BorderBrush="#FFE082" BorderThickness="1" CornerRadius="4">
            <CheckBox x:Name="AcceptCheckBox" 
                      Style="{StaticResource AcceptCheckbox}"
                      Checked="AcceptCheckBox_Changed"
                      Unchecked="AcceptCheckBox_Changed">
                <TextBlock TextWrapping="Wrap">
                    <Run FontWeight="SemiBold">I have read and agree</Run>
                    <Run> to the terms and conditions of this End User License Agreement</Run>
                </TextBlock>
            </CheckBox>
        </Border>

        <!-- Buttons -->
        <Border Grid.Row="3" Background="#F0F0F0" Padding="24,16">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <TextBlock Grid.Column="0" 
                           Text="Version 1.0" 
                           FontSize="12" 
                           Foreground="#888888" 
                           VerticalAlignment="Center"/>

                <Button Grid.Column="2" 
                        x:Name="DeclineButton"
                        Content="Decline" 
                        Style="{StaticResource DeclineButton}"
                        Click="DeclineButton_Click"
                        Margin="0,0,12,0"/>

                <Button Grid.Column="3" 
                        x:Name="AcceptButton"
                        Content="Accept &amp; Continue" 
                        Style="{StaticResource AcceptButton}"
                        Click="AcceptButton_Click"
                        IsEnabled="False"/>
            </Grid>
        </Border>
    </Grid>
</Window>
