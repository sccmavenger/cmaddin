                                                    <StackPanel>
                                                        <TextBlock Text="WHY IT MATTERS" FontSize="9" FontWeight="Bold" Foreground="#94A3B8" Margin="0,0,0,3"/>
                                                        <TextBlock Text="{Binding WhyItMatters}" FontSize="12" Foreground="#475569" TextWrapping="Wrap"/>
                                                    </StackPanel>
                                                </Border>

                                                <!-- Q3: Cost of Inaction -->
                                                <Border Background="#FEF2F2" CornerRadius="6" Padding="14,10" Margin="0,0,0,8">
                                                    <StackPanel>
                                                        <TextBlock Text="⚠️ COST OF INACTION" FontSize="9" FontWeight="Bold" Foreground="#991B1B" Margin="0,0,0,3"/>
                                                        <TextBlock Text="{Binding CostOfInaction}" FontSize="12" Foreground="#7F1D1D" TextWrapping="Wrap"/>
                                                    </StackPanel>
                                                </Border>

                                                <!-- Q4: Lowest-Risk Next Step -->
