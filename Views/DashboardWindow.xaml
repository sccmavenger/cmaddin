                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="280"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>

                                    <!-- LEFT: Progress Bar -->
                                    <Border Grid.Column="0" Background="{StaticResource BackgroundSubtle}" CornerRadius="8" Padding="20">
                                        <StackPanel>
                                            <!-- Progress Header -->
                                            <Grid Margin="0,0,0,15">
