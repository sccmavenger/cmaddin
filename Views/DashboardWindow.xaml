                                                    <Run Text="{Binding ConfigMgrFreeCountdown.CurrentVelocity, StringFormat='{}{0:F0}', Mode=OneWay}"/><Run Text="/wk"/>
                                                </TextBlock>
                                                <TextBlock Text="current velocity" FontSize="9" Foreground="#64748B" HorizontalAlignment="Center"/>
                                            </StackPanel>
                                        </Border>
                                    </Grid>

                                    <TextBlock Text="TOP ACCELERATORS" FontSize="9" FontWeight="Bold" Foreground="#94A3B8" Margin="0,5,0,5"/>
                                    <ItemsControl ItemsSource="{Binding ConfigMgrFreeCountdown.TopAccelerators}">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <TextBlock FontSize="11" Foreground="#16A34A" Margin="8,1,0,1" TextWrapping="Wrap">
                                                    <Run Text="🚀 "/><Run Text="{Binding Mode=OneWay}"/>
                                                </TextBlock>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </StackPanel>
                            </Border>

                            <!-- ============================== -->
                            <!-- F4: PILOT WAVE OPTIMIZER        -->
                            <!-- ============================== -->
                            <TextBlock Text="🎯 Pilot Wave Optimizer" FontSize="22" FontWeight="Bold" Foreground="#1E293B" Margin="0,10,0,5"/>
                            <TextBlock Text="Optimized device batches ranked by readiness, compliance likelihood, and risk. Each wave ensures diversity for early issue detection." FontSize="12" Foreground="#94A3B8" TextWrapping="Wrap" Margin="0,0,0,15"/>

                            <ItemsControl ItemsSource="{Binding PilotWaves}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Border Background="{Binding RiskBackground, Converter={StaticResource HexColorToBrushConverter}}"
                                                BorderBrush="{StaticResource BorderLight}" BorderThickness="1"
                                                CornerRadius="8" Padding="18" Margin="0,0,0,10">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="50"/>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="Auto"/>
                                                </Grid.ColumnDefinitions>

                                                <StackPanel Grid.Column="0" HorizontalAlignment="Center" VerticalAlignment="Center">
                                                    <TextBlock FontSize="22" FontWeight="Bold" Foreground="#1E293B" HorizontalAlignment="Center">
                                                        <Run Text="#"/><Run Text="{Binding WaveNumber, Mode=OneWay}"/>
                                                    </TextBlock>
                                                </StackPanel>

                                                <StackPanel Grid.Column="1" Margin="12,0,15,0">
                                                    <TextBlock Text="{Binding WaveName}" FontSize="14" FontWeight="Bold" Foreground="#1E293B"/>
                                                    <TextBlock Text="{Binding Description}" FontSize="12" Foreground="#64748B" TextWrapping="Wrap" Margin="0,3,0,0"/>
                                                </StackPanel>

                                                <StackPanel Grid.Column="2" VerticalAlignment="Center">
                                                    <Border Background="{Binding RiskColor, Converter={StaticResource HexColorToBrushConverter}}" CornerRadius="4" Padding="10,4" Margin="0,0,0,4">
                                                        <TextBlock FontSize="10" FontWeight="Bold" Foreground="White" HorizontalAlignment="Center">
                                                            <Run Text="{Binding DeviceCount, Mode=OneWay}"/><Run Text=" devices"/>
                                                        </TextBlock>
                                                    </Border>
                                                    <TextBlock FontSize="10" Foreground="#64748B" HorizontalAlignment="Center">
                                                        <Run Text="{Binding ExpectedSuccessRate, StringFormat='{}{0:F0}%', Mode=OneWay}"/><Run Text=" success"/>
                                                    </TextBlock>
                                                    <TextBlock FontSize="9" HorizontalAlignment="Center"
                                                               Foreground="{Binding RiskColor, Converter={StaticResource HexColorToBrushConverter}}">
                                                        <Run Text="Risk: "/><Run Text="{Binding RiskProfile, Mode=OneWay}"/>
                                                    </TextBlock>
                                                </StackPanel>
                                            </Grid>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>

                            <!-- ============================== -->
                            <!-- F5: WORKLOAD WHAT-IF            -->
                            <!-- ============================== -->
                            <TextBlock Text="🔮 Workload What-If Simulator" FontSize="22" FontWeight="Bold" Foreground="#1E293B" Margin="0,30,0,5"/>
                            <TextBlock Text="For each unmoved workload: projected impact on Security, Operations, and Compliance scores — plus which workloads get unblocked." FontSize="12" Foreground="#94A3B8" TextWrapping="Wrap" Margin="0,0,0,15"/>

                            <ItemsControl ItemsSource="{Binding WhatIfResults}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Border Background="White" BorderBrush="{StaticResource BorderLight}" BorderThickness="1"
                                                CornerRadius="8" Padding="18" Margin="0,0,0,10">
                                            <StackPanel>
                                                <TextBlock Text="{Binding WorkloadName}" FontSize="15" FontWeight="Bold" Foreground="#1E293B" Margin="0,0,0,8"/>

                                                <Grid Margin="0,0,0,8">
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="*"/>
                                                        <ColumnDefinition Width="*"/>
                                                        <ColumnDefinition Width="*"/>
                                                        <ColumnDefinition Width="*"/>
                                                    </Grid.ColumnDefinitions>

                                                    <Border Grid.Column="0" Background="#F8FAFC" CornerRadius="6" Padding="10,6" Margin="0,0,4,0">
                                                        <StackPanel HorizontalAlignment="Center">
                                                            <TextBlock Text="Security" FontSize="9" Foreground="#94A3B8" HorizontalAlignment="Center"/>
                                                            <TextBlock Text="{Binding SecurityDeltaLabel}" FontSize="16" FontWeight="Bold"
                                                                       Foreground="{Binding SecurityColor, Converter={StaticResource HexColorToBrushConverter}}" HorizontalAlignment="Center"/>
                                                        </StackPanel>
                                                    </Border>
                                                    <Border Grid.Column="1" Background="#F8FAFC" CornerRadius="6" Padding="10,6" Margin="4,0,4,0">
                                                        <StackPanel HorizontalAlignment="Center">
                                                            <TextBlock Text="Operations" FontSize="9" Foreground="#94A3B8" HorizontalAlignment="Center"/>
                                                            <TextBlock Text="{Binding OperationsDeltaLabel}" FontSize="16" FontWeight="Bold"
                                                                       Foreground="{Binding OperationsColor, Converter={StaticResource HexColorToBrushConverter}}" HorizontalAlignment="Center"/>
                                                        </StackPanel>
                                                    </Border>
                                                    <Border Grid.Column="2" Background="#F8FAFC" CornerRadius="6" Padding="10,6" Margin="4,0,4,0">
                                                        <StackPanel HorizontalAlignment="Center">
                                                            <TextBlock Text="Compliance" FontSize="9" Foreground="#94A3B8" HorizontalAlignment="Center"/>
                                                            <TextBlock Text="{Binding ComplianceDeltaLabel}" FontSize="16" FontWeight="Bold"
                                                                       Foreground="{Binding ComplianceColor, Converter={StaticResource HexColorToBrushConverter}}" HorizontalAlignment="Center"/>
                                                        </StackPanel>
                                                    </Border>
                                                    <Border Grid.Column="3" Background="#EFF6FF" CornerRadius="6" Padding="10,6" Margin="4,0,0,0">
                                                        <StackPanel HorizontalAlignment="Center">
                                                            <TextBlock Text="Devices" FontSize="9" Foreground="#94A3B8" HorizontalAlignment="Center"/>
                                                            <TextBlock Text="{Binding DevicesAffected, StringFormat='{}{0:N0}'}" FontSize="16" FontWeight="Bold" Foreground="#2563EB" HorizontalAlignment="Center"/>
                                                        </StackPanel>
                                                    </Border>
                                                </Grid>

                                                <TextBlock Text="{Binding Recommendation}" FontSize="11" Foreground="#475569" TextWrapping="Wrap" Margin="0,4,0,0"/>
                                            </StackPanel>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>

                            <!-- ============================== -->
                            <!-- F6: STALE/ORPHAN DETECTION       -->
                            <!-- ============================== -->
                            <TextBlock Text="👻 Stale Device &amp; Orphan Detection" FontSize="22" FontWeight="Bold" Foreground="#1E293B" Margin="0,30,0,5"/>
                            <TextBlock Text="Devices consuming ConfigMgr infrastructure with no management value — by category." FontSize="12" Foreground="#94A3B8" TextWrapping="Wrap" Margin="0,0,0,15"/>

                            <Border Background="White" BorderBrush="{StaticResource BorderLight}" BorderThickness="1" CornerRadius="10" Padding="22" Margin="0,0,0,8">
                                <StackPanel>
                                    <Grid Margin="0,0,0,15">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>

                                        <Border Grid.Column="0" Background="#F8FAFC" CornerRadius="8" Padding="14,10" Margin="0,0,4,0">
                                            <StackPanel HorizontalAlignment="Center">
                                                <TextBlock Text="💤" FontSize="20" HorizontalAlignment="Center"/>
                                                <TextBlock Text="{Binding StaleOrphanResult.StaleCount, StringFormat='{}{0:N0}'}" FontSize="22" FontWeight="Bold" Foreground="#D97706" HorizontalAlignment="Center"/>
                                                <TextBlock Text="Stale" FontSize="10" Foreground="#64748B" HorizontalAlignment="Center"/>
                                                <TextBlock Text="30+ days inactive" FontSize="8" Foreground="#94A3B8" HorizontalAlignment="Center"/>
                                            </StackPanel>
                                        </Border>

                                        <Border Grid.Column="1" Background="#F8FAFC" CornerRadius="8" Padding="14,10" Margin="4,0,4,0">
                                            <StackPanel HorizontalAlignment="Center">
                                                <TextBlock Text="🔗" FontSize="20" HorizontalAlignment="Center"/>
                                                <TextBlock Text="{Binding StaleOrphanResult.OrphanedCount, StringFormat='{}{0:N0}'}" FontSize="22" FontWeight="Bold" Foreground="#DC2626" HorizontalAlignment="Center"/>
                                                <TextBlock Text="Orphaned" FontSize="10" Foreground="#64748B" HorizontalAlignment="Center"/>
                                                <TextBlock Text="ConfigMgr only, no Intune" FontSize="8" Foreground="#94A3B8" HorizontalAlignment="Center"/>
                                            </StackPanel>
                                        </Border>

                                        <Border Grid.Column="2" Background="#F8FAFC" CornerRadius="8" Padding="14,10" Margin="4,0,4,0">
                                            <StackPanel HorizontalAlignment="Center">
                                                <TextBlock Text="👻" FontSize="20" HorizontalAlignment="Center"/>
                                                <TextBlock Text="{Binding StaleOrphanResult.GhostCount, StringFormat='{}{0:N0}'}" FontSize="22" FontWeight="Bold" Foreground="#7C3AED" HorizontalAlignment="Center"/>
                                                <TextBlock Text="Ghost" FontSize="10" Foreground="#64748B" HorizontalAlignment="Center"/>
                                                <TextBlock Text="Intune only, no ConfigMgr" FontSize="8" Foreground="#94A3B8" HorizontalAlignment="Center"/>
                                            </StackPanel>
                                        </Border>

                                        <Border Grid.Column="3" Background="#F8FAFC" CornerRadius="8" Padding="14,10" Margin="4,0,0,0">
                                            <StackPanel HorizontalAlignment="Center">
                                                <TextBlock Text="🚫" FontSize="20" HorizontalAlignment="Center"/>
                                                <TextBlock Text="{Binding StaleOrphanResult.BlockerCount, StringFormat='{}{0:N0}'}" FontSize="22" FontWeight="Bold" Foreground="#1E293B" HorizontalAlignment="Center"/>
                                                <TextBlock Text="Blockers" FontSize="10" Foreground="#64748B" HorizontalAlignment="Center"/>
                                                <TextBlock Text="Co-mgmt enrollment failed" FontSize="8" Foreground="#94A3B8" HorizontalAlignment="Center"/>
                                            </StackPanel>
                                        </Border>
                                    </Grid>
                                </StackPanel>
                            </Border>

                            <Border Background="#FFFBEB" CornerRadius="8" Padding="16" Margin="0,0,0,20">
                                <TextBlock Text="{Binding StaleOrphanResult.WasteSummary}" FontSize="12" Foreground="#92400E" TextWrapping="Wrap"/>
                            </Border>

                            <!-- ============================== -->
                            <!-- F7: INFRASTRUCTURE RETIREMENT   -->
                            <!-- ============================== -->
                            <TextBlock Text="🏗️ Infrastructure Retirement Map" FontSize="22" FontWeight="Bold" Foreground="#1E293B" Margin="0,10,0,5"/>
                            <TextBlock Text="What on-premises infrastructure can be decommissioned as each workload moves to Intune? Based on Microsoft's workload-to-infrastructure mapping." FontSize="12" Foreground="#94A3B8" TextWrapping="Wrap" Margin="0,0,0,15"/>

                            <ItemsControl ItemsSource="{Binding InfraRetirementItems}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Border Background="{Binding StatusBackground, Converter={StaticResource HexColorToBrushConverter}}"
                                                BorderBrush="{StaticResource BorderLight}" BorderThickness="1"
                                                CornerRadius="8" Padding="18" Margin="0,0,0,8">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="35"/>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="Auto"/>
                                                </Grid.ColumnDefinitions>

                                                <TextBlock Grid.Column="0" Text="{Binding StatusIcon}" FontSize="22" VerticalAlignment="Center" HorizontalAlignment="Center"/>

                                                <StackPanel Grid.Column="1" Margin="12,0,15,0">
                                                    <StackPanel Orientation="Horizontal">
                                                        <TextBlock Text="{Binding WorkloadName}" FontSize="13" FontWeight="Bold" Foreground="#1E293B"/>
                                                        <TextBlock Text=" → " FontSize="13" Foreground="#94A3B8"/>
                                                        <TextBlock Text="{Binding InfrastructureName}" FontSize="13" FontWeight="SemiBold" Foreground="#475569"/>
                                                    </StackPanel>
                                                    <TextBlock Text="{Binding InfrastructureDescription}" FontSize="11" Foreground="#64748B" TextWrapping="Wrap" Margin="0,3,0,0"/>
                                                </StackPanel>

                                                <Border Grid.Column="2" Background="{Binding StatusColor, Converter={StaticResource HexColorToBrushConverter}}"
                                                        CornerRadius="4" Padding="10,5" VerticalAlignment="Center">
                                                    <TextBlock Text="{Binding Status}" FontSize="10" FontWeight="Bold" Foreground="White"/>
                                                </Border>
                                            </Grid>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>

                            <!-- ============================== -->
                            <!-- F8: COMPLIANCE TREND            -->
                            <!-- ============================== -->
                            <TextBlock Text="📈 Compliance Impact Projection" FontSize="22" FontWeight="Bold" Foreground="#1E293B" Margin="0,30,0,5"/>
                            <TextBlock Text="Projected compliance improvement per workload transition — proving ROI of each move." FontSize="12" Foreground="#94A3B8" TextWrapping="Wrap" Margin="0,0,0,15"/>

                            <Border Background="White" BorderBrush="{StaticResource BorderLight}" BorderThickness="1" CornerRadius="10" Padding="22" Margin="0,0,0,8">
                                <StackPanel>
                                    <!-- Current → Projected header -->
                                    <Grid Margin="0,0,0,15">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>

                                        <Border Grid.Column="0" Background="#FEF2F2" CornerRadius="8" Padding="18,14">
                                            <StackPanel HorizontalAlignment="Center">
                                                <TextBlock Text="CURRENT COMPLIANCE" FontSize="9" FontWeight="Bold" Foreground="#991B1B" HorizontalAlignment="Center"/>
                                                <TextBlock Text="{Binding ComplianceTrend.CurrentComplianceRate, StringFormat='{}{0:F0}%'}" FontSize="28" FontWeight="Bold" Foreground="#DC2626" HorizontalAlignment="Center"/>
                                            </StackPanel>
                                        </Border>

                                        <TextBlock Grid.Column="1" Text="→" FontSize="28" Foreground="#94A3B8" VerticalAlignment="Center" Margin="15,0,15,0"/>

                                        <Border Grid.Column="2" Background="#F0FDF4" CornerRadius="8" Padding="18,14">
                                            <StackPanel HorizontalAlignment="Center">
                                                <TextBlock Text="PROJECTED COMPLIANCE" FontSize="9" FontWeight="Bold" Foreground="#166534" HorizontalAlignment="Center"/>
                                                <TextBlock Text="{Binding ComplianceTrend.ProjectedComplianceRate, StringFormat='{}{0:F0}%'}" FontSize="28" FontWeight="Bold" Foreground="#16A34A" HorizontalAlignment="Center"/>
                                            </StackPanel>
                                        </Border>
                                    </Grid>

                                    <!-- Per-workload impact bars -->
                                    <TextBlock Text="IMPROVEMENT BY WORKLOAD" FontSize="9" FontWeight="Bold" Foreground="#94A3B8" Margin="0,0,0,8"/>

                                    <ItemsControl ItemsSource="{Binding ComplianceTrend.WorkloadImpacts}">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <Grid Margin="0,0,0,6">
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="180"/>
                                                        <ColumnDefinition Width="*"/>
                                                        <ColumnDefinition Width="60"/>
                                                    </Grid.ColumnDefinitions>

                                                    <TextBlock Grid.Column="0" Text="{Binding WorkloadName}" FontSize="12" Foreground="#1E293B" VerticalAlignment="Center"/>

                                                    <Border Grid.Column="1" Background="#E2E8F0" CornerRadius="3" Height="8" VerticalAlignment="Center">
                                                        <Border Background="{Binding BarColor, Converter={StaticResource HexColorToBrushConverter}}"
                                                                CornerRadius="3" HorizontalAlignment="Left"
                                                                Width="{Binding Improvement, Converter={StaticResource PercentToWidthConverter}, ConverterParameter=200}"/>
                                                    </Border>

                                                    <TextBlock Grid.Column="2" Text="{Binding ImprovementLabel}" FontSize="12" FontWeight="Bold"
                                                               Foreground="{Binding BarColor, Converter={StaticResource HexColorToBrushConverter}}"
                                                               HorizontalAlignment="Right" VerticalAlignment="Center"/>
                                                </Grid>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </StackPanel>
                            </Border>

                            <Border Background="#F0FDF4" CornerRadius="8" Padding="16" Margin="0,0,0,20">
                                <TextBlock Text="{Binding ComplianceTrend.Insight}" FontSize="12" Foreground="#15803D" TextWrapping="Wrap"/>
                            </Border>

                        </StackPanel>
                    </ScrollViewer>
                </TabItem>

                <!-- APPLICATIONS TAB -->
                <TabItem Header="📦 Applications" Visibility="{Binding ShowApplicationsTab}">
                    <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="20">
                        <StackPanel>
                            <!-- Application Readiness Section (Moved from Cloud Readiness) -->
                            <Border Style="{StaticResource SectionCard}" Margin="0,0,0,15">
                                <StackPanel>
                                    <Grid Margin="0,0,0,15">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        
                                        <StackPanel Grid.Column="0">
                                            <StackPanel Orientation="Horizontal">
                                                <TextBlock Text="📦" FontSize="24" Margin="0,0,10,0" VerticalAlignment="Center"/>
                                                <StackPanel>
                                                    <TextBlock Text="Application Readiness (Client Apps Prerequisite)" Style="{StaticResource SectionTitle}" Margin="0"/>
                                                    <TextBlock Text="Client Apps is the most complex workload — application migration readiness determines when you can safely transition" 
                                                               FontSize="12" Foreground="#666" Margin="0,2,0,0" TextWrapping="Wrap"/>
                                                </StackPanel>
                                            </StackPanel>
                                        </StackPanel>
                                        
                                        <Border Grid.Column="1" Background="{StaticResource SuccessGreenLight}" CornerRadius="8" Padding="15,10" VerticalAlignment="Center">
                                            <StackPanel HorizontalAlignment="Center">
                                                <TextBlock Text="{Binding AppReadinessPercentage, StringFormat={}{0:F0}%}" 
                                                           FontSize="28" FontWeight="Bold" Foreground="{StaticResource SuccessGreen}" HorizontalAlignment="Center"/>
                                                <TextBlock Text="Ready" FontSize="11" Foreground="#666" HorizontalAlignment="Center"/>
                                            </StackPanel>
                                        </Border>
                                    </Grid>
                                    
                                    <!-- Readiness Summary Cards -->
                                    <Grid Margin="0,0,0,15">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>
                                        
                                        <Border Grid.Column="0" Background="{StaticResource SuccessGreenLight}" CornerRadius="6" Padding="12" Margin="0,0,5,0">
                                            <StackPanel HorizontalAlignment="Center">
                                                <TextBlock Text="Easy Migration" FontSize="11" Foreground="{StaticResource SuccessGreenDark}" HorizontalAlignment="Center"/>
                                                <TextBlock Text="{Binding AppReadinessEasyCount}" FontSize="24" FontWeight="Bold" 
                                                           Foreground="{StaticResource SuccessGreen}" HorizontalAlignment="Center"/>
                                                <TextBlock Text="MSI / Store apps" FontSize="9" Foreground="#666" HorizontalAlignment="Center"/>
                                            </StackPanel>
                                        </Border>
                                        
                                        <Border Grid.Column="1" Background="#FFF8E1" CornerRadius="6" Padding="12" Margin="5,0">
                                            <StackPanel HorizontalAlignment="Center">
                                                <TextBlock Text="Moderate Effort" FontSize="11" Foreground="{StaticResource WarningOrange}" HorizontalAlignment="Center"/>
                                                <TextBlock Text="{Binding AppReadinessModerateCount}" FontSize="24" FontWeight="Bold" 
                                                           Foreground="{StaticResource WarningOrange}" HorizontalAlignment="Center"/>
                                                <TextBlock Text="Win32 packaging" FontSize="9" Foreground="#666" HorizontalAlignment="Center"/>
                                            </StackPanel>
                                        </Border>
                                        
                                        <Border Grid.Column="2" Background="{StaticResource ErrorRedLight}" CornerRadius="6" Padding="12" Margin="5,0,0,0">
                                            <StackPanel HorizontalAlignment="Center">
                                                <TextBlock Text="Complex" FontSize="11" Foreground="{StaticResource ErrorRedDark}" HorizontalAlignment="Center"/>
                                                <TextBlock Text="{Binding AppReadinessComplexCount}" FontSize="24" FontWeight="Bold" 
                                                           Foreground="{StaticResource ErrorRed}" HorizontalAlignment="Center"/>
                                                <TextBlock Text="App-V / Scripts" FontSize="9" Foreground="#666" HorizontalAlignment="Center"/>
                                            </StackPanel>
                                        </Border>
                                    </Grid>
                                    
                                    <!-- Top Blockers -->
                                    <Border Background="{StaticResource ErrorRedLight}" CornerRadius="6" Padding="12" Margin="0,0,0,10">
                                        <StackPanel>
                                            <TextBlock Text="⚠️ Top Migration Blockers" FontSize="12" FontWeight="SemiBold" 
                                                       Foreground="{StaticResource ErrorRedDark}" Margin="0,0,0,8"/>
                                            <StackPanel>
                                                <Grid Margin="0,0,0,4">
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="*"/>
                                                        <ColumnDefinition Width="Auto"/>
                                                    </Grid.ColumnDefinitions>
                                                    <TextBlock Grid.Column="0" Text="App-V Packages" FontSize="11" Foreground="#333"/>
                                                    <TextBlock Grid.Column="1" Text="{Binding AppBlockerAppVCount, StringFormat={}{0} apps}" 
                                                               FontSize="11" Foreground="{StaticResource ErrorRed}" FontWeight="SemiBold"/>
                                                </Grid>
                                                <Grid>
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="*"/>
                                                        <ColumnDefinition Width="Auto"/>
                                                    </Grid.ColumnDefinitions>
                                                    <TextBlock Grid.Column="0" Text="Script-Based Installers" FontSize="11" Foreground="#333"/>
                                                    <TextBlock Grid.Column="1" Text="{Binding AppBlockerScriptCount, StringFormat={}{0} apps}" 
                                                               FontSize="11" Foreground="{StaticResource WarningOrange}" FontWeight="SemiBold"/>
                                                </Grid>
                                            </StackPanel>
                                        </StackPanel>
                                    </Border>
                                    
                                    <!-- Recommendations -->
                                    <Border Background="{StaticResource InfoBlueLight}" CornerRadius="6" Padding="12">
                                        <StackPanel>
                                            <TextBlock Text="💡 Recommendations" FontSize="12" FontWeight="SemiBold" 
                                                       Foreground="{StaticResource PrimaryBlue}" Margin="0,0,0,8"/>
                                            <TextBlock Text="• Start with MSI apps using Win32 Content Prep Tool" 
                                                       FontSize="11" Foreground="#333" Margin="0,0,0,4"/>
                                            <TextBlock Text="• App-V packages need repackaging to MSIX or Win32" 
                                                       FontSize="11" Foreground="#333" Margin="0,0,0,4"/>
                                            <TextBlock Text="• Check Enterprise App Catalog for common apps before packaging" 
                                                       FontSize="11" Foreground="#333"/>
                                        </StackPanel>
                                    </Border>
                                </StackPanel>
                            </Border>
                        </StackPanel>
                    </ScrollViewer>
                </TabItem>

                <!-- AI ACTION COMMAND CENTER TAB -->
                <TabItem Header="🤖 AI Actions" Visibility="{Binding ShowAIActionsTab}">
                    <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="20">
                        <StackPanel>
                            <!-- Placeholder - Content being redesigned -->
                            <Border Style="{StaticResource SectionCard}">
                                <StackPanel HorizontalAlignment="Center" Margin="60">
                                    <TextBlock Text="🤖 AI-Powered Actions" 
                                               FontSize="24" FontWeight="Bold" Foreground="{StaticResource PrimaryBlue}" 
                                               HorizontalAlignment="Center" Margin="0,0,0,15"/>
                                    <TextBlock Text="This section is being redesigned to provide better AI-driven migration recommendations." 
                                               FontSize="14" Foreground="#666" TextWrapping="Wrap" TextAlignment="Center" 
                                               HorizontalAlignment="Center" MaxWidth="400"/>
                                </StackPanel>
                            </Border>
                        </StackPanel>
                    </ScrollViewer>
                </TabItem>
            </TabControl>
        </Grid>

        <!-- Zoom Controls Footer -->
        <Border Grid.Row="3" Background="{StaticResource BackgroundPage}" BorderBrush="{StaticResource BorderLight}" BorderThickness="0,1,0,0" Padding="10,6">
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <TextBlock Text="Zoom:" FontSize="12" Foreground="{StaticResource TextSecondary}" VerticalAlignment="Center" Margin="0,0,8,0"/>
                <Button x:Name="ZoomOutButton" Content="−" Width="28" Height="28" 
                        FontSize="16" FontWeight="Bold" Padding="0"
                        Background="{StaticResource BackgroundCard}" 
                        BorderBrush="{StaticResource BorderLight}" BorderThickness="1"
                        Click="ZoomOutButton_Click"
                        ToolTip="Zoom Out (Decrease text size)"/>
                <TextBlock x:Name="ZoomLevelText" Text="100%" Width="45" TextAlignment="Center"
                           FontSize="12" FontWeight="SemiBold" VerticalAlignment="Center" Margin="5,0"/>
                <Button x:Name="ZoomInButton" Content="+" Width="28" Height="28" 
                        FontSize="16" FontWeight="Bold" Padding="0"
                        Background="{StaticResource BackgroundCard}" 
                        BorderBrush="{StaticResource BorderLight}" BorderThickness="1"
                        Click="ZoomInButton_Click"
                        ToolTip="Zoom In (Increase text size)"/>
                <Button x:Name="ZoomResetButton" Content="Reset" Margin="10,0,0,0" Padding="8,4"
                        FontSize="11" 
                        Background="{StaticResource BackgroundCard}" 
                        BorderBrush="{StaticResource BorderLight}" BorderThickness="1"
                        Click="ZoomResetButton_Click"
                        ToolTip="Reset zoom to 100%"/>
            </StackPanel>
        </Border>
    </Grid>
</Window>







