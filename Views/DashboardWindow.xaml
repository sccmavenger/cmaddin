                                            <Run Text="💡 Tip: " FontWeight="Bold"/>
                                            <Run Text="Address complex applications first. App-V packages and custom script deployments need re-engineering before the Client Apps workload can be safely transitioned."/>
                                        </TextBlock>
                                    </Border>
                                </StackPanel>
                            </Border>

                        </StackPanel>
                    </ScrollViewer>
                </TabItem>
                
                <TabItem Header="🎯 Decision Cards" Visibility="{Binding ShowDecisionCardsTab}">
                    <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="20">
