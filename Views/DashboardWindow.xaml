                                                    <TextBlock FontSize="11" Foreground="#666">
                                                        <Run Text="{Binding CurrentAdoptionPercentage, StringFormat='{}{0:F0}%', Mode=OneWay}"/>
                                                        <Run Text=" adoption"/>
                                                    </TextBlock>
                                                </StackPanel>

                                                <Border Grid.Column="2" Background="#FFECB3" CornerRadius="4" Padding="8,4" VerticalAlignment="Center">
