                                                            <TextBlock Text="{Binding CardTypeLabel}" FontSize="10" FontWeight="Bold" Foreground="White"/>
                                                        </Border>
                                                        <Border Background="#F1F5F9" CornerRadius="4" Padding="8,4" Visibility="{Binding DevicesAffected, Converter={StaticResource IntToVisibilityConverter}}">
