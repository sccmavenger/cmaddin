                                            <Run Text="{Binding SavingsUnlockInsight.SavingsFromWorkloadTransition, Converter={StaticResource CurrencyConverter}, Mode=OneWay}"/>
                                            <Run Text="/year" FontSize="14"/>
                                        </TextBlock>
                                        <TextBlock FontSize="12" Foreground="#666" Margin="0,0,0,8">
