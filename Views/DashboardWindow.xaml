                                                        <Run Text=" days stalled"/>
                                                    </TextBlock>
                                                </Border>
                                            </Grid>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>

                            <!-- Per-Workload Cards -->
                            <ItemsControl ItemsSource="{Binding Workloads}">
