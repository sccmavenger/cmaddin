                                            <Run Text="✅ ACTION: "/>
                                            <Run Text="{Binding SavingsUnlockInsight.RecommendedAction, Mode=OneWay}" FontWeight="Normal"/>
                                        </TextBlock>
                                    </StackPanel>
                                </Border>

                                <!-- Workload Transition Action -->
                                <Border Background="{StaticResource InfoBlueLight}" Padding="12" CornerRadius="4">
                                    <StackPanel>
                                        <TextBlock Text="🔄 Workload Transition Impact" FontWeight="Bold" FontSize="13" Margin="0,0,0,5"/>
