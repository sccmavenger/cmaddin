                                                </Grid>
                                            </Border>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </StackPanel>
                        </Border>

                        <!-- 4. Security & Compliance Scorecard -->
                        <Border Style="{StaticResource SectionCard}" Visibility="Collapsed">
