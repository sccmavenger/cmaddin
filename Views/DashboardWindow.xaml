                                                                <Run Text="{Binding DevicesAffected, Mode=OneWay}"/>
                                                                <Run Text=" devices"/>
                                                            </TextBlock>
                                                        </Border>
                                                    </StackPanel>
                                                </Grid>

                                                <!-- Q1: Decision -->
