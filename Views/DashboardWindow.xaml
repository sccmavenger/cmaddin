                                            <Run Text="{Binding SavingsUnlockInsight.SavingsLockedBehindEnrollment, Converter={StaticResource CurrencyConverter}, Mode=OneWay}"/>
                                            <Run Text="/year" FontSize="14"/>
                                        </TextBlock>
                                        <TextBlock Text="locked behind device enrollment" FontSize="12" Foreground="#666" Margin="0,0,0,8"/>
