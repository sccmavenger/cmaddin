                                       FontSize="28" FontWeight="Bold" Foreground="{StaticResource PrimaryBlue}" Margin="0,0,0,6"/>
                            <TextBlock Text="Each card answers: What decision? Why now? Cost of inaction? Lowest-risk next step. Completed workloads are not shown."
