                                <TextBlock Text="🔒 Security &amp; Compliance Scorecard" Style="{StaticResource SectionTitle}"/>
                                
                                <lvc:CartesianChart Height="200" Series="{Binding ComplianceComparisonSeries}" 
                                                    LegendLocation="Right" Margin="0,0,0,15">
