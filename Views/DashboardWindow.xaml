<Window x:Class="ZeroTrustMigrationAddin.Views.DashboardWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:lvc="clr-namespace:LiveCharts.Wpf;assembly=LiveCharts.Wpf"
        xmlns:converters="clr-namespace:ZeroTrustMigrationAddin.Converters"
        xmlns:views="clr-namespace:ZeroTrustMigrationAddin.Views"
        Title="Preview - Cloud Native Assessment Tool" 
        MinHeight="700" MinWidth="1200"
        WindowStartupLocation="CenterScreen"
        SizeToContent="Manual"
        Background="{StaticResource BackgroundPage}"
        FontFamily="Segoe UI Emoji, Segoe UI, Arial"
        Loaded="Window_Loaded">

    <Window.Resources>
        <converters:PercentageConverter x:Key="PercentageConverter"/>
        <converters:CurrencyConverter x:Key="CurrencyConverter"/>
        <converters:WorkloadStatusConverter x:Key="WorkloadStatusConverter"/>
        <converters:AlertSeverityConverter x:Key="AlertSeverityConverter"/>
        <converters:BlockerSeverityConverter x:Key="BlockerSeverityConverter"/>
        <converters:BoolToVisibilityConverter x:Key="BoolToVisibilityConverter"/>
        <converters:CountToVisibilityConverter x:Key="CountToVisibilityConverter"/>
        <converters:InverseCountToVisibilityConverter x:Key="InverseCountToVisibilityConverter"/>
        <converters:ObjectToVisibilityConverter x:Key="ObjectToVisibilityConverter"/>
        <converters:NullToVisibilityConverter x:Key="NullToVisibilityConverter"/>
        <converters:CollectionToVisibilityConverter x:Key="CollectionToVisibilityConverter"/>
        <converters:RecommendationPriorityConverter x:Key="RecommendationPriorityConverter"/>
        <converters:PercentageToStrokeDashConverter x:Key="PercentageToStrokeDashConverter"/>
        <converters:PercentageToWidthConverter x:Key="PercentageToWidthConverter"/>
        <converters:BoolToColorConverter x:Key="BoolToColorConverter"/>
        <converters:BoolToOpacityConverter x:Key="BoolToOpacityConverter"/>
        <converters:PercentToWidthConverter x:Key="PercentToWidthConverter"/>
        <converters:HexColorToBrushConverter x:Key="HexColorToBrushConverter"/>
        <converters:IntToVisibilityConverter x:Key="IntToVisibilityConverter"/>

        <Style x:Key="SectionCard" TargetType="Border">
            <Setter Property="Background" Value="White"/>
            <Setter Property="CornerRadius" Value="8"/>
            <Setter Property="Padding" Value="20"/>
            <Setter Property="Margin" Value="0,0,0,15"/>
            <Setter Property="Effect">
                <Setter.Value>
                    <DropShadowEffect BlurRadius="10" ShadowDepth="2" Opacity="0.1"/>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="SectionTitle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="18"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="{StaticResource TextPrimary}"/>
            <Setter Property="Margin" Value="0,0,0,15"/>
        </Style>

        <Style x:Key="MetricLabel" TargetType="TextBlock">
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Foreground" Value="{StaticResource TextSecondary}"/>
        </Style>

        <Style x:Key="MetricValue" TargetType="TextBlock">
            <Setter Property="FontSize" Value="24"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Foreground" Value="{StaticResource PrimaryBlue}"/>
        </Style>

        <Style x:Key="ActionButton" TargetType="Button">
            <Setter Property="Background" Value="{StaticResource PrimaryBlue}"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="FontFamily" Value="Segoe UI Emoji, Segoe UI, Arial"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="15,8"/>
            <Setter Property="Margin" Value="5"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" 
                                CornerRadius="4"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="{StaticResource PrimaryBlueHover}"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <!-- Help Icon Button Style -->
        <Style x:Key="TileHelpButton" TargetType="Button">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="{StaticResource PrimaryBlue}"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Padding" Value="6,3"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="HorizontalAlignment" Value="Right"/>
            <Setter Property="VerticalAlignment" Value="Bottom"/>
            <Setter Property="Opacity" Value="0.5"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" CornerRadius="3" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Opacity" Value="1"/>
                    <Setter Property="Background" Value="{StaticResource InfoBlueLight}"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <!-- Toggle Switch Style for Autonomous Mode -->
        <Style x:Key="ToggleSwitchStyle" TargetType="ToggleButton">
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ToggleButton">
                        <Border x:Name="Border" Background="{StaticResource Gray300}" CornerRadius="13" Width="50" Height="26">
                            <Ellipse x:Name="Thumb" Fill="White" Width="20" Height="20" 
                                     HorizontalAlignment="Left" Margin="3,0,0,0"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Border" Property="Background" Value="{StaticResource SuccessGreen}"/>
                                <Setter TargetName="Thumb" Property="HorizontalAlignment" Value="Right"/>
                                <Setter TargetName="Thumb" Property="Margin" Value="0,0,3,0"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Header -->
        <Border Grid.Row="0" Background="{StaticResource PrimaryBlue}" Padding="20">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                
                <StackPanel Grid.Column="0">
                    <TextBlock Text="Cloud Native Assessment" FontSize="28" FontWeight="Bold" Foreground="White"/>
                    <TextBlock Text="Assess your readiness for cloud-native device management" 
                               FontSize="14" Foreground="{StaticResource BorderLight}" Margin="0,5,0,0"/>
                </StackPanel>

                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                    <WrapPanel Orientation="Horizontal" HorizontalAlignment="Right">
                        <!-- Connection Status Indicator -->
                        <Border Background="{StaticResource BackgroundPage}" CornerRadius="4" Padding="8,4" Margin="0,0,10,0"
                                ToolTip="Connection Status: Both Graph and ConfigMgr must be connected to show real data">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="⚫" FontSize="12" Foreground="{StaticResource SuccessGreen}" 
                                           Visibility="{Binding UseRealData, Converter={StaticResource BoolToVisibilityConverter}}"
                                           ToolTip="Data Sources Connected - Showing Live Data"/>
                                <TextBlock Text="⚫" FontSize="12" Foreground="{StaticResource WarningOrange}" 
                                           Visibility="{Binding UseRealData, Converter={StaticResource BoolToVisibilityConverter}, ConverterParameter=Inverse}"
                                           ToolTip="Data Sources Not Connected - Showing Mock Data"/>
                                <TextBlock Text=" " FontSize="10"/>
                                <TextBlock Text="MOCK DATA" FontSize="10" FontWeight="Bold" Foreground="{StaticResource WarningOrange}"
                                           Visibility="{Binding UseRealData, Converter={StaticResource BoolToVisibilityConverter}, ConverterParameter=Inverse}"/>
                                <TextBlock Text="LIVE DATA" FontSize="10" FontWeight="Bold" Foreground="{StaticResource SuccessGreen}"
                                           Visibility="{Binding UseRealData, Converter={StaticResource BoolToVisibilityConverter}}"/>
                            </StackPanel>
                        </Border>
                        
                        <Button Content="🔗 Graph" 
                                Command="{Binding ConnectToGraphCommand}"
                                Style="{StaticResource ActionButton}"
                                Background="{StaticResource SuccessGreen}"
                                ToolTip="Connect to Microsoft Graph"
                                Margin="0,0,5,0" Padding="10,5"/>
                        <Button Content="🔐 Auth" 
                                Click="OpenGraphAuthSettings_Click"
                                Style="{StaticResource ActionButton}"
                                Background="{StaticResource PrimaryBlue}"
                                ToolTip="Configure Graph authentication method and custom app registration"
                                Margin="0,0,5,0" Padding="10,5"/>
                        <Button Content="⚙️ ConfigMgr" 
                                Command="{Binding ShowConfigMgrSettingsCommand}"
                                Style="{StaticResource ActionButton}"
                                Background="{StaticResource TextDark}"
                                ToolTip="Configure ConfigMgr Site Server connection"
                                Margin="0,0,5,0" Padding="10,5"/>
                        <Button Content="🔧 Diagnostics" 
                                Command="{Binding ShowDiagnosticsCommand}"
                                Style="{StaticResource ActionButton}"
                                Background="{StaticResource WarningOrange}"
                                ToolTip="Show connection status and data sources"
                                Margin="0,0,5,0" Padding="10,5"/>
                        <Button Content="🤖 AI" 
                                Command="{Binding ShowAISettingsCommand}"
                                Style="{StaticResource ActionButton}"
                                Background="{StaticResource AccentPurple}"
                                ToolTip="Configure Azure OpenAI integration"
                                Margin="0,0,5,0" Padding="10,5"/>
                        <Button Content="📋 Logs" 
                                Command="{Binding OpenLogFolderCommand}"
                                Style="{StaticResource ActionButton}"
                                Background="{StaticResource Gray600}"
                                ToolTip="Open log folder with debug information"
                                Margin="0,0,5,0" Padding="10,5"/>
                        <Button Content="📖 Guide" 
                                Command="{Binding OpenUserGuideCommand}"
                                Style="{StaticResource ActionButton}"
                                Background="{StaticResource AccentPurple}"
                                ToolTip="Open user guide and documentation"
                                Margin="0,0,5,0" Padding="10,5"/>
                        <Button Content="💬 Feedback" 
                                Command="{Binding ShowFeedbackCommand}"
                                Style="{StaticResource ActionButton}"
                                Background="{StaticResource ErrorRed}"
                                ToolTip="Submit feedback, report bugs, or suggest features"
                                Margin="0,0,5,0" Padding="10,5"/>
                        <Button Content="🔄 Refresh" 
                                Command="{Binding RefreshCommand}"
                                Style="{StaticResource ActionButton}"
                                Background="{StaticResource PrimaryBlueHover}"
                                ToolTip="Refresh all data"
                                Margin="0,0,0,0" Padding="10,5"/>
                    </WrapPanel>
                    <TextBlock Text="{Binding LastRefreshTime, StringFormat='Last updated: {0:g}'}" 
                               FontSize="11" Foreground="{StaticResource BorderLight}" 
                               HorizontalAlignment="Right" Margin="0,5,0,0"/>
                </StackPanel>
            </Grid>
        </Border>

        <!-- Connection Status Warning Banner - Shows when not fully connected -->
        <Border Grid.Row="1" Background="#FFF3E0" BorderBrush="#FF9800" BorderThickness="0,0,0,2" Padding="12,8"
                Visibility="{Binding DeviceEnrollment.IsFullyConnected, Converter={StaticResource BoolToVisibilityConverter}, ConverterParameter=Inverse}">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                
                <TextBlock Grid.Column="0" Text="⚠️" FontSize="16" VerticalAlignment="Center" Margin="0,0,10,0"/>
                
                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                    <TextBlock FontSize="13" FontWeight="SemiBold" Foreground="#E65100">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock">
                                <Setter Property="Text" Value="Partial Connection"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding DeviceEnrollment.IsMockData}" Value="True">
                                        <Setter Property="Text" Value="Not Connected"/>
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding DeviceEnrollment.IsGraphOnlyData}" Value="True">
                                        <Setter Property="Text" Value="Graph Only - ConfigMgr Not Connected"/>
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding DeviceEnrollment.IsConfigMgrOnlyData}" Value="True">
                                        <Setter Property="Text" Value="ConfigMgr Only - Graph Not Connected"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>
                    <TextBlock Text="{Binding DeviceEnrollment.DataSourceWarning}" FontSize="11" Foreground="#BF360C" TextWrapping="Wrap"/>
                </StackPanel>
                
                <Button Grid.Column="2" Content="Connect" Padding="12,4" Margin="10,0,0,0"
                        Background="#FF9800" Foreground="White" BorderThickness="0"
                        Command="{Binding ShowConfigMgrSettingsCommand}"
                        ToolTip="Open connection settings"
                        Visibility="{Binding DeviceEnrollment.IsGraphOnlyData, Converter={StaticResource BoolToVisibilityConverter}}"/>
            </Grid>
        </Border>

        <!-- Main Content with Tabs -->
        <Grid Grid.Row="2" x:Name="MainContentGrid">
            <Grid.LayoutTransform>
                <ScaleTransform x:Name="ContentScaleTransform" ScaleX="1" ScaleY="1"/>
            </Grid.LayoutTransform>
            <TabControl x:Name="MainTabControl" Margin="10" Background="Transparent" BorderThickness="0" SelectionChanged="MainTabControl_SelectionChanged">
                <TabControl.Resources>
                    <Style TargetType="TabItem">
                        <Setter Property="Padding" Value="20,12"/>
                        <Setter Property="FontSize" Value="14"/>
                        <Setter Property="FontWeight" Value="Normal"/>
                        <Setter Property="FontFamily" Value="Segoe UI Emoji, Segoe UI, Arial"/>
                        <Setter Property="Background" Value="{StaticResource BackgroundPage}"/>
                        <Setter Property="Foreground" Value="{StaticResource TextSecondary}"/>
                        <Setter Property="BorderThickness" Value="0"/>
                        <Setter Property="Template">
                            <Setter.Value>
                                <ControlTemplate TargetType="TabItem">
                                    <Border Name="Border" 
                                            Background="{TemplateBinding Background}"
                                            BorderBrush="Transparent"
                                            BorderThickness="0,0,0,3"
                                            CornerRadius="6,6,0,0"
                                            Padding="{TemplateBinding Padding}"
                                            Margin="3,0">
                                        <ContentPresenter ContentSource="Header"
                                                          HorizontalAlignment="Center"
                                                          VerticalAlignment="Center"/>
                                    </Border>
                                    <ControlTemplate.Triggers>
                                        <!-- SELECTED STATE - Very prominent -->
                                        <Trigger Property="IsSelected" Value="True">
                                            <Setter TargetName="Border" Property="Background" Value="White"/>
                                            <Setter TargetName="Border" Property="BorderBrush" Value="{StaticResource PrimaryBlue}"/>
                                            <Setter TargetName="Border" Property="BorderThickness" Value="0,0,0,4"/>
                                            <Setter Property="Foreground" Value="{StaticResource PrimaryBlue}"/>
                                            <Setter Property="FontWeight" Value="Bold"/>
                                        </Trigger>
                                        <!-- HOVER STATE - Subtle highlight -->
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter TargetName="Border" Property="Background" Value="{StaticResource Gray200}"/>
                                            <Setter Property="Foreground" Value="{StaticResource TextPrimary}"/>
                                        </Trigger>
                                        <!-- Combined: Selected + Hover -->
                                        <MultiTrigger>
                                            <MultiTrigger.Conditions>
                                                <Condition Property="IsSelected" Value="True"/>
                                                <Condition Property="IsMouseOver" Value="True"/>
                                            </MultiTrigger.Conditions>
                                            <Setter TargetName="Border" Property="Background" Value="{StaticResource BackgroundAlice}"/>
                                            <Setter Property="Foreground" Value="{StaticResource PrimaryBlue}"/>
                                            <Setter Property="FontWeight" Value="Bold"/>
                                        </MultiTrigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </Setter.Value>
                        </Setter>
                    </Style>
                </TabControl.Resources>

                <!-- OVERVIEW TAB (All existing content) -->
                <TabItem>
                    <TabItem.Header>
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="📊 Overview"/>
                            <Ellipse Width="8" Height="8" Fill="#E53E3E" Margin="6,0,0,0" VerticalAlignment="Center"
                                     Visibility="{Binding HasPipelineStall, Converter={StaticResource BoolToVisibilityConverter}}"
                                     ToolTip="Enrollment stall detected by analysis pipeline"/>
                        </StackPanel>
                    </TabItem.Header>
                    <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="20">
                        <StackPanel>
                            <!-- Loading Indicator -->
                            <Border Background="{StaticResource AccentAmberLight}" Padding="15" CornerRadius="4" Margin="0,0,0,15"
                                    Visibility="{Binding IsLoading, Converter={StaticResource BoolToVisibilityConverter}}">
                                <TextBlock Text="⏳ Loading dashboard data..." FontSize="14" Foreground="{StaticResource WarningOrange}"/>
                            </Border>

                            <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="2*"/>
                        <ColumnDefinition Width="15"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <!-- Left Column -->
                    <StackPanel Grid.Column="0">
                        <!-- 1. Overall Migration Status - MOVED TO WORKLOADS TAB -->
                        <Border Style="{StaticResource SectionCard}" Visibility="Collapsed">
                            <StackPanel>
                                <TextBlock Text="📊 Overall Migration Status" Style="{StaticResource SectionTitle}"/>
                                
                                <Grid Margin="0,0,0,15">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    
                                    <StackPanel Grid.Column="0">
                                        <TextBlock Text="Workloads Transitioned" Style="{StaticResource MetricLabel}"/>
                                        <TextBlock Style="{StaticResource MetricValue}">
                                            <Run Text="{Binding MigrationStatus.WorkloadsTransitioned, Mode=OneWay}"/>
                                            <Run Text=" of " FontSize="16"/>
                                            <Run Text="{Binding MigrationStatus.TotalWorkloads, Mode=OneWay}"/>
                                        </TextBlock>
                                    </StackPanel>

                                    <StackPanel Grid.Column="1">
                                        <TextBlock Text="Completion" Style="{StaticResource MetricLabel}"/>
                                        <TextBlock Text="{Binding MigrationStatus.CompletionPercentage, Mode=OneWay, Converter={StaticResource PercentageConverter}}" 
                                                   Style="{StaticResource MetricValue}"/>
                                    </StackPanel>
                                </Grid>

                                <ProgressBar Height="20" 
                                             Value="{Binding MigrationStatus.CompletionPercentage, Mode=OneWay}" 
                                             Maximum="100"
                                             Foreground="{StaticResource PrimaryBlue}"
                                             Background="{StaticResource BorderLight}"
                                             Margin="0,0,0,10"/>

                                <TextBlock Text="{Binding MigrationStatus.ProjectedFinishDate, StringFormat='Projected finish: {0:MMMM yyyy}'}" 
                                           FontSize="13" Foreground="{StaticResource TextSecondary}"/>
                            </StackPanel>
                        </Border>

                        <!-- 2. Device Enrollment -->
                        <Border Style="{StaticResource SectionCard}">
                            <StackPanel>
                                <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
                                    <TextBlock Text="💻 Device Enrollment" Style="{StaticResource SectionTitle}"/>
                                    <Border Background="{StaticResource PrimaryBlue}" CornerRadius="3" Padding="5,2" Margin="10,0,0,0" VerticalAlignment="Center">
                                        <TextBlock Text="WINDOWS 10/11 ONLY" FontSize="10" FontWeight="Bold" Foreground="White"/>
                                    </Border>
                                </StackPanel>
                                
                                <!-- Metric Cards with Color-Coded Trend Indicators -->
                                <Grid Margin="0,0,0,20">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>

                                    <!-- Total Devices from ConfigMgr - No trend line (it's the baseline) -->
                                    <Border Grid.Column="0" Background="{StaticResource BackgroundSubtle}" CornerRadius="6" Padding="12" Margin="0,0,5,0"
                                            ToolTip="Windows 10/11 workstations from ConfigMgr.&#x0a;This is your migration baseline - the devices you're moving to cloud management.&#x0a;&#x0a;Note: This count may differ from Intune if devices were added directly to Intune or removed from ConfigMgr.">
                                        <StackPanel>
                                            <TextBlock Text="ConfigMgr Windows 10/11" Style="{StaticResource MetricLabel}"/>
                                            <TextBlock Text="{Binding DeviceEnrollment.TotalDevices}" 
                                                       Style="{StaticResource MetricValue}" FontSize="22"/>
                                            <TextBlock Text="📋 Migration baseline" FontSize="9" Foreground="#666" FontStyle="Italic"/>
                                        </StackPanel>
                                    </Border>

                                    <!-- Comanaged - GREEN line in chart -->
                                    <Border Grid.Column="1" Background="{StaticResource SuccessGreenLight}" CornerRadius="6" Padding="12" Margin="5,0,5,0"
                                            BorderBrush="{StaticResource SuccessGreen}" BorderThickness="0,0,0,4"
                                            ToolTip="Devices managed by BOTH ConfigMgr AND Intune.&#x0a;Detected via Intune ManagementAgent = ConfigurationManagerClientMdm.&#x0a;&#x0a;These devices have the ConfigMgr client installed AND are enrolled in Intune for co-management workloads.">
                                        <StackPanel>
                                            <StackPanel Orientation="Horizontal">
                                                <Ellipse Width="10" Height="10" Fill="{StaticResource SuccessGreen}" Margin="0,0,6,0" VerticalAlignment="Center"/>
                                                <TextBlock Text="Co-managed" Style="{StaticResource MetricLabel}"/>
                                            </StackPanel>
                                            <TextBlock Text="{Binding DeviceEnrollment.CoManagedDevices}" 
                                                       Style="{StaticResource MetricValue}" FontSize="22" Foreground="{StaticResource SuccessGreen}"/>
                                            <TextBlock Text="📈 ConfigMgr + Intune" FontSize="9" Foreground="{StaticResource SuccessGreen}" FontStyle="Italic"/>
                                        </StackPanel>
                                    </Border>

                                    <!-- ConfigMgr Only - RED/ORANGE line in chart -->
                                    <Border Grid.Column="2" Background="{StaticResource ErrorRedLight}" CornerRadius="6" Padding="12" Margin="5,0,5,0"
                                            BorderBrush="{StaticResource ErrorRed}" BorderThickness="0,0,0,4"
                                            ToolTip="ConfigMgr devices NOT yet enrolled in Intune.&#x0a;These are your migration candidates.&#x0a;&#x0a;To migrate these devices:&#x0a;• Enable co-management in ConfigMgr&#x0a;• Ensure Hybrid Azure AD Join is configured&#x0a;• Configure co-management workloads">
                                        <StackPanel>
                                            <StackPanel Orientation="Horizontal">
                                                <Rectangle Width="10" Height="10" Fill="{StaticResource ErrorRed}" Margin="0,0,6,0" VerticalAlignment="Center"/>
                                                <TextBlock Text="ConfigMgr Only" Style="{StaticResource MetricLabel}"/>
                                            </StackPanel>
                                            <TextBlock Text="{Binding DeviceEnrollment.ConfigMgrOnlyDevices}" 
                                                       Style="{StaticResource MetricValue}" FontSize="22" Foreground="{StaticResource ErrorRed}"/>
                                            <TextBlock Text="📉 Not in Intune yet" FontSize="9" Foreground="{StaticResource ErrorRed}" FontStyle="Italic"/>
                                        </StackPanel>
                                    </Border>

                                    <!-- Cloud Native - BLUE (informational, not in trend) -->
                                    <Border Grid.Column="3" Background="{StaticResource BackgroundAlice}" CornerRadius="6" Padding="12" Margin="5,0,0,0"
                                            BorderBrush="{StaticResource PrimaryBlue}" BorderThickness="0,0,0,4"
                                            ToolTip="Windows 10/11 devices in Intune that are NOT currently found in ConfigMgr.&#x0a;These are fully cloud-managed (Entra joined + Intune MDM).&#x0a;&#x0a;Includes Autopilot, BYOD, Azure VD, Windows 365.&#x0a;&#x0a;Note: This is a point-in-time snapshot - we detect 'not found' rather than tracking removal events.">
                                        <StackPanel>
                                            <StackPanel Orientation="Horizontal">
                                                <Polygon Points="5,0 10,10 0,10" Fill="{StaticResource PrimaryBlue}" Margin="0,0,6,0" VerticalAlignment="Center"/>
                                                <TextBlock Text="Cloud Native" Style="{StaticResource MetricLabel}"/>
                                            </StackPanel>
                                            <TextBlock Text="{Binding DeviceEnrollment.CloudNativeDevices}" 
                                                       Style="{StaticResource MetricValue}" FontSize="22" Foreground="{StaticResource PrimaryBlue}"/>
                                            <TextBlock Text="☁️ Intune only (no ConfigMgr)" FontSize="9" Foreground="{StaticResource PrimaryBlue}" FontStyle="Italic"/>
                                        </StackPanel>
                                    </Border>
                                </Grid>

                                <!-- Chart with Legend -->
                                <TextBlock Text="Enrollment Trend (6 Months)" FontWeight="SemiBold" Margin="0,0,0,5"/>
                                <TextBlock Text="Click legend items to show/hide lines" FontSize="10" Foreground="#888" Margin="0,0,0,8"/>
                                <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
                                    <!-- Comanaged Toggle -->
                                    <Border CornerRadius="3" Padding="8,3" Margin="0,0,10,0" Cursor="Hand"
                                            Background="{Binding IsComanagedSeriesVisible, Converter={StaticResource BoolToColorConverter}, ConverterParameter=#107C10}"
                                            Opacity="{Binding IsComanagedSeriesVisible, Converter={StaticResource BoolToOpacityConverter}}">
                                        <Border.InputBindings>
                                            <MouseBinding MouseAction="LeftClick" Command="{Binding ToggleComanagedSeriesCommand}"/>
                                        </Border.InputBindings>
                                        <StackPanel Orientation="Horizontal">
                                            <Ellipse Width="8" Height="8" Fill="White" Margin="0,0,5,0" VerticalAlignment="Center"/>
                                            <TextBlock Text="Comanaged" FontSize="11" Foreground="White" FontWeight="SemiBold"/>
                                        </StackPanel>
                                    </Border>
                                    <!-- ConfigMgr Only Toggle -->
                                    <Border CornerRadius="3" Padding="8,3" Margin="0,0,10,0" Cursor="Hand"
                                            Background="{Binding IsConfigMgrOnlySeriesVisible, Converter={StaticResource BoolToColorConverter}, ConverterParameter=#D13438}"
                                            Opacity="{Binding IsConfigMgrOnlySeriesVisible, Converter={StaticResource BoolToOpacityConverter}}">
                                        <Border.InputBindings>
                                            <MouseBinding MouseAction="LeftClick" Command="{Binding ToggleConfigMgrOnlySeriesCommand}"/>
                                        </Border.InputBindings>
                                        <StackPanel Orientation="Horizontal">
                                            <Rectangle Width="8" Height="8" Fill="White" Margin="0,0,5,0" VerticalAlignment="Center"/>
                                            <TextBlock Text="ConfigMgr Only" FontSize="11" Foreground="White" FontWeight="SemiBold"/>
                                        </StackPanel>
                                    </Border>
                                    <!-- Cloud Native Toggle -->
                                    <Border CornerRadius="3" Padding="8,3" Cursor="Hand"
                                            Background="{Binding IsCloudNativeSeriesVisible, Converter={StaticResource BoolToColorConverter}, ConverterParameter=#0078D4}"
                                            Opacity="{Binding IsCloudNativeSeriesVisible, Converter={StaticResource BoolToOpacityConverter}}">
                                        <Border.InputBindings>
                                            <MouseBinding MouseAction="LeftClick" Command="{Binding ToggleCloudNativeSeriesCommand}"/>
                                        </Border.InputBindings>
                                        <StackPanel Orientation="Horizontal">
                                            <Polygon Points="4,0 8,8 0,8" Fill="White" Margin="0,0,5,0" VerticalAlignment="Center"/>
                                            <TextBlock Text="Cloud Native" FontSize="11" Foreground="White" FontWeight="SemiBold"/>
                                        </StackPanel>
                                    </Border>
                                </StackPanel>
                                
                                <!-- Trend Chart (shown when sufficient data available) -->
                                <lvc:CartesianChart Height="250" Series="{Binding EnrollmentTrendSeries, Mode=OneWay}" 
