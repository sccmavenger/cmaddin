                                                    <TextBlock FontSize="11" Foreground="#666" Margin="0,2,0,0">
                                                        <Run Text="ConfigMgr: "/>
                                                        <Run Text="{Binding ConfigMgrDeviceCount, Mode=OneWay}" FontWeight="Bold" Foreground="#D13438"/>
