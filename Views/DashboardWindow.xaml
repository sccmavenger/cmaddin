                                                    <Border Grid.Row="0" Background="#E8E8E8" CornerRadius="4" Height="8" Margin="0,0,0,4">
                                                        <Border Background="{StaticResource SuccessGreen}" CornerRadius="4" HorizontalAlignment="Left"
                                                                Width="{Binding IntuneAdoptionPercentage, Converter={StaticResource PercentToWidthConverter}, ConverterParameter=200}"/>
                                                    </Border>
                                                    <TextBlock Grid.Row="1" FontSize="10" Foreground="#999" HorizontalAlignment="Right">
                                                        <Run Text="{Binding IntuneAdoptionPercentage, StringFormat='{}{0:F0}%', Mode=OneWay}"/>
                                                        <Run Text=" Intune"/>
                                                    </TextBlock>
                                                </Grid>
                                            </Grid>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>

                            <!-- Cloud-Native Opportunity Card -->
                            <Border Background="White" BorderBrush="{StaticResource SuccessGreen}" BorderThickness="2" CornerRadius="8" Padding="25" Margin="0,10,0,20">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>

                                    <Border Grid.Column="0" Background="{StaticResource SuccessGreenLight}" CornerRadius="50" Width="80" Height="80" Margin="0,0,20,0">
                                        <StackPanel VerticalAlignment="Center">
                                            <TextBlock Text="{Binding NearCloudNativeCount}" FontSize="28" FontWeight="Bold" Foreground="{StaticResource SuccessGreen}" HorizontalAlignment="Center"/>
                                            <TextBlock Text="devices" FontSize="10" Foreground="{StaticResource SuccessGreen}" HorizontalAlignment="Center"/>
                                        </StackPanel>
                                    </Border>

                                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                        <TextBlock Text="🌟 Near Cloud-Native Opportunity" FontSize="18" FontWeight="Bold" Foreground="{StaticResource SuccessGreen}" Margin="0,0,0,5"/>
