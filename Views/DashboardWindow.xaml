                                            <Run Text="These devices have 6 of 7 workloads on Intune — just ONE workload away from fully cloud-native. Moving the last holdout workload for these devices eliminates the ConfigMgr client dependency entirely."/>
                                        </TextBlock>
                                        <StackPanel Orientation="Horizontal" Margin="0,10,0,0">
                                            <Border Background="{StaticResource InfoBlueLight}" CornerRadius="4" Padding="8,3" Margin="0,0,10,0">
                                                <TextBlock FontSize="11" Foreground="{StaticResource PrimaryBlue}">
                                                    <Run Text="🔄 Already cloud-native: "/>
                                                    <Run Text="{Binding DevicesReadyForCloudNative, Mode=OneWay}" FontWeight="Bold"/>
                                                </TextBlock>
                                            </Border>
                                        </StackPanel>
                                    </StackPanel>
                                </Grid>
