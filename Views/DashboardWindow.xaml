                                                            <TextBlock FontSize="11" Foreground="#666">
                                                                <Run Text="Moving this workload to Intune would make "/>
                                                                <Run Text="{Binding DevicesBlockedCount, Mode=OneWay}" FontWeight="Bold" Foreground="{StaticResource SuccessGreen}"/>
                                                                <Run Text=" devices fully cloud-native"/>
                                                            </TextBlock>
                                                        </StackPanel>
                                                        <Border Grid.Column="2" Background="#FFB900" CornerRadius="4" Padding="10,5" VerticalAlignment="Center">
                                                            <TextBlock FontSize="12" FontWeight="Bold" Foreground="White">
                                                                <Run Text="{Binding DevicesBlockedCount, Mode=OneWay}"/>
                                                                <Run Text=" blocked"/>
                                                            </TextBlock>
                                                        </Border>
                                                    </Grid>
                                                </Border>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </StackPanel>
