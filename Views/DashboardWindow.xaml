                                                <TextBlock Grid.Column="2" Text="DEVICES" FontSize="10" FontWeight="Bold" Foreground="#666" HorizontalAlignment="Center"/>
                                                <TextBlock Grid.Column="3" Text="STATUS" FontSize="10" FontWeight="Bold" Foreground="#666" HorizontalAlignment="Center"/>
                                                <TextBlock Grid.Column="4" Text="ACTION REQUIRED" FontSize="10" FontWeight="Bold" Foreground="#666"/>
                                            </Grid>
                                        </Border>

                                        <!-- Row 1: Hybrid Entra -->
                                        <Border Grid.Row="1" BorderBrush="{StaticResource BorderLight}" BorderThickness="0,1,0,0" Padding="10,12">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="40"/>
                                                    <ColumnDefinition Width="2*"/>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="2*"/>
                                                </Grid.ColumnDefinitions>
                                                
                                                <TextBlock Grid.Column="0" Text="✅" FontSize="18" VerticalAlignment="Center"/>
                                                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                                    <TextBlock Text="Hybrid Entra joined" FontSize="12" FontWeight="SemiBold"/>
                                                    <TextBlock Text="Domain + Entra ID identity" FontSize="10" Foreground="#666" Margin="0,2,0,0"/>
                                                </StackPanel>
                                                <TextBlock Grid.Column="2" Text="{Binding DeviceEnrollment.HybridJoinedDevices}" 
                                                           FontSize="18" FontWeight="Bold" Foreground="{StaticResource SuccessGreen}" 
                                                           HorizontalAlignment="Center" VerticalAlignment="Center"
                                                           Cursor="Hand" MouseLeftButtonDown="DeviceCount_Click" Tag="HybridJoined"
                                                           ToolTip="Click to view device list"/>
                                                <Border Grid.Column="3" Background="{StaticResource SuccessGreenLight}" CornerRadius="12" Padding="8,4" 
                                                        HorizontalAlignment="Center" VerticalAlignment="Center">
                                                    <TextBlock Text="Ready" FontSize="10" FontWeight="SemiBold" Foreground="{StaticResource SuccessGreen}"/>
                                                </Border>
                                                <TextBlock Grid.Column="4" Text="None - Ready for co-management enrollment" 
                                                           FontSize="11" Foreground="#666" VerticalAlignment="Center"/>
                                            </Grid>
                                        </Border>

                                        <!-- Row 2: Entra joined -->
                                        <Border Grid.Row="2" BorderBrush="{StaticResource BorderLight}" BorderThickness="0,1,0,0" Padding="10,12">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="40"/>
                                                    <ColumnDefinition Width="2*"/>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="2*"/>
                                                </Grid.ColumnDefinitions>
                                                
                                                <TextBlock Grid.Column="0" Text="☁️" FontSize="18" VerticalAlignment="Center"/>
                                                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                                    <TextBlock Text="Entra joined" FontSize="12" FontWeight="SemiBold"/>
                                                    <TextBlock Text="Cloud-native identity" FontSize="10" Foreground="#666" Margin="0,2,0,0"/>
                                                </StackPanel>
                                                <TextBlock Grid.Column="2" Text="{Binding DeviceEnrollment.AzureADOnlyDevices}" 
                                                           FontSize="18" FontWeight="Bold" Foreground="{StaticResource PrimaryBlue}" 
                                                           HorizontalAlignment="Center" VerticalAlignment="Center"
                                                           Cursor="Hand" MouseLeftButtonDown="DeviceCount_Click" Tag="AzureADOnly"
                                                           ToolTip="Click to view device list"/>
                                                <Border Grid.Column="3" Background="{StaticResource InfoBlueLight}" CornerRadius="12" Padding="8,4" 
                                                        HorizontalAlignment="Center" VerticalAlignment="Center">
                                                    <TextBlock Text="Ready" FontSize="10" FontWeight="SemiBold" Foreground="{StaticResource PrimaryBlue}"/>
                                                </Border>
                                                <TextBlock Grid.Column="4" Text="None - Ready for Intune-only enrollment" 
                                                           FontSize="11" Foreground="#666" VerticalAlignment="Center"/>
                                            </Grid>
                                        </Border>

                                        <!-- Row 3: On-Prem Domain Only -->
                                        <Border Grid.Row="3" BorderBrush="{StaticResource BorderLight}" BorderThickness="0,1,0,0" Padding="10,12">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="40"/>
                                                    <ColumnDefinition Width="2*"/>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="2*"/>
                                                </Grid.ColumnDefinitions>
                                                
                                                <TextBlock Grid.Column="0" Text="⚠️" FontSize="18" VerticalAlignment="Center"/>
                                                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                                    <TextBlock Text="Active Directory joined" FontSize="12" FontWeight="SemiBold"/>
                                                    <TextBlock Text="AD domain joined (no Entra ID)" FontSize="10" Foreground="#666" Margin="0,2,0,0"/>
                                                </StackPanel>
                                                <TextBlock Grid.Column="2" Text="{Binding DeviceEnrollment.OnPremDomainOnlyDevices}" 
                                                           FontSize="18" FontWeight="Bold" Foreground="{StaticResource AccentAmber}" 
                                                           HorizontalAlignment="Center" VerticalAlignment="Center"
                                                           Cursor="Hand" MouseLeftButtonDown="DeviceCount_Click" Tag="OnPremOnly"
                                                           ToolTip="Click to view device list"/>
                                                <Border Grid.Column="3" Background="{StaticResource AccentAmberLight}" CornerRadius="12" Padding="8,4" 
                                                        HorizontalAlignment="Center" VerticalAlignment="Center">
                                                    <TextBlock Text="Blocked" FontSize="10" FontWeight="SemiBold" Foreground="{StaticResource AccentAmber}"/>
                                                </Border>
                                                <StackPanel Grid.Column="4" VerticalAlignment="Center">
                                                    <TextBlock FontSize="11" Foreground="#666">
                                                        <Run Text="Configure Hybrid Entra join"/>
                                                    </TextBlock>
                                                    <TextBlock Text="View Setup Guide →" FontSize="10" Foreground="{StaticResource PrimaryBlue}" Cursor="Hand"
                                                               MouseLeftButtonDown="SetupGuide_Click" Tag="HybridJoin"/>
                                                </StackPanel>
                                            </Grid>
                                        </Border>

                                        <!-- Row 4: Workgroup -->
                                        <Border Grid.Row="4" BorderBrush="{StaticResource BorderLight}" BorderThickness="0,1,0,0" Padding="10,12">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="40"/>
                                                    <ColumnDefinition Width="2*"/>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="2*"/>
                                                </Grid.ColumnDefinitions>
                                                
                                                <TextBlock Grid.Column="0" Text="❌" FontSize="18" VerticalAlignment="Center"/>
                                                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                                    <TextBlock Text="Workgroup (Standalone)" FontSize="12" FontWeight="SemiBold"/>
                                                    <TextBlock Text="Not domain or Entra ID joined" FontSize="10" Foreground="#666" Margin="0,2,0,0"/>
                                                </StackPanel>
                                                <TextBlock Grid.Column="2" Text="{Binding DeviceEnrollment.WorkgroupDevices}" 
                                                           FontSize="18" FontWeight="Bold" Foreground="{StaticResource ErrorRed}" 
                                                           HorizontalAlignment="Center" VerticalAlignment="Center"
                                                           Cursor="Hand" MouseLeftButtonDown="DeviceCount_Click" Tag="Workgroup"
                                                           ToolTip="Click to view device list"/>
                                                <Border Grid.Column="3" Background="{StaticResource ErrorRedLight}" CornerRadius="12" Padding="8,4" 
                                                        HorizontalAlignment="Center" VerticalAlignment="Center">
                                                    <TextBlock Text="Blocked" FontSize="10" FontWeight="SemiBold" Foreground="{StaticResource ErrorRed}"/>
                                                </Border>
                                                <StackPanel Grid.Column="4" VerticalAlignment="Center">
                                                    <TextBlock FontSize="11" Foreground="#666">
                                                        <Run Text="Join to domain or Azure AD first"/>
                                                    </TextBlock>
                                                    <TextBlock Text="View Options →" FontSize="10" Foreground="{StaticResource PrimaryBlue}" Cursor="Hand"
                                                               MouseLeftButtonDown="SetupGuide_Click" Tag="DomainJoin"/>
                                                </StackPanel>
                                            </Grid>
                                        </Border>
                                    </Grid>
                                </Border>
                            </StackPanel>
                        </Border>

                        <!-- Migration Impact Forecast - HIDDEN per ADR-007: projected values need citable sources
                             TO RESTORE: Change Visibility="Collapsed" to Visibility="Visible"
                        -->
                        <views:MigrationImpactCard x:Name="MigrationImpactCard" Margin="0,0,0,15"
                                                   Visibility="Collapsed"/>

                        <!-- 3a. Generate Migration Plan Prompt (shows when no plan exists) -->
                        <Border Style="{StaticResource SectionCard}"
                                Background="{StaticResource BackgroundAlice}"
                                Visibility="{Binding MigrationPlan, Converter={StaticResource NullToVisibilityConverter}}">
                            <StackPanel HorizontalAlignment="Center" Margin="30">
                                <TextBlock Text="🗓️ Migration Plan Timeline" 
                                           Style="{StaticResource SectionTitle}" 
                                           HorizontalAlignment="Center"/>
                                <TextBlock Text="Generate an Autopatch-style migration plan with phased enrollment" 
                                           FontSize="14" 
                                           Foreground="#666" 
                                           HorizontalAlignment="Center"
                                           Margin="0,0,0,20"/>
                                <Button Content="📅 Generate Migration Plan"
                                        Command="{Binding GenerateMigrationPlanCommand}"
                                        Style="{StaticResource ActionButton}"
                                        FontSize="14"
                                        Padding="20,10"
                                        HorizontalAlignment="Center"/>
                            </StackPanel>
                        </Border>

                        <!-- 3b. Migration Plan Timeline (Phase 1 AI) - shows when plan exists -->
                        <Border Style="{StaticResource SectionCard}"
                                Visibility="{Binding MigrationPlan, Converter={StaticResource ObjectToVisibilityConverter}}">
                            <StackPanel>
                                <Grid Margin="0,0,0,15">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    
                                    <TextBlock Grid.Column="0" Text="🗓️ Migration Plan Timeline" Style="{StaticResource SectionTitle}" Margin="0"/>
                                    <Button Grid.Column="1" 
                                            Content="Mark Phase Complete"
                                            Command="{Binding MarkPhaseCompleteCommand}"
                                            Style="{StaticResource ActionButton}"
                                            Background="{StaticResource SuccessGreen}"
                                            FontSize="12"
                                            Padding="10,5"
                                            Visibility="{Binding MigrationPlan.CurrentPhaseIndex, Converter={StaticResource BoolToVisibilityConverter}, ConverterParameter=GreaterThanMinusOne}"/>
                                </Grid>

                                <!-- Plan Summary -->
                                <Grid Margin="0,0,0,20">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>

                                    <StackPanel Grid.Column="0">
                                        <TextBlock Text="Target Date" Style="{StaticResource MetricLabel}"/>
                                        <TextBlock Text="{Binding MigrationPlan.TargetDate, StringFormat='{}{0:MMM dd, yyyy}'}" 
                                                   FontSize="16" FontWeight="SemiBold" Foreground="{StaticResource PrimaryBlue}"/>
                                    </StackPanel>

                                    <StackPanel Grid.Column="1">
                                        <TextBlock Text="Overall Progress" Style="{StaticResource MetricLabel}"/>
                                        <TextBlock Text="{Binding MigrationPlan.OverallProgress, StringFormat='{}{0:F0}%'}" 
                                                   FontSize="16" FontWeight="SemiBold" Foreground="{StaticResource PrimaryBlue}"/>
                                    </StackPanel>

                                    <StackPanel Grid.Column="2">
                                        <TextBlock Text="Status" Style="{StaticResource MetricLabel}"/>
                                        <TextBlock Text="{Binding MigrationPlan.TimelineStatus}" 
                                                   FontSize="16" FontWeight="SemiBold">
                                            <TextBlock.Style>
                                                <Style TargetType="TextBlock">
                                                    <Setter Property="Foreground" Value="{StaticResource SuccessGreen}"/>
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding MigrationPlan.TimelineStatus}" Value="Behind Schedule">
                                                            <Setter Property="Foreground" Value="{StaticResource ErrorRed}"/>
                                                        </DataTrigger>
                                                        <DataTrigger Binding="{Binding MigrationPlan.TimelineStatus}" Value="Complete">
                                                            <Setter Property="Foreground" Value="{StaticResource SuccessGreen}"/>
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </TextBlock.Style>
                                        </TextBlock>
                                    </StackPanel>
                                </Grid>

                                <!-- Phases List -->
                                <ItemsControl ItemsSource="{Binding MigrationPlan.Phases}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Border BorderBrush="{StaticResource BorderLight}" BorderThickness="1" CornerRadius="6" 
                                                    Padding="15" Margin="0,0,0,15">
                                                <Border.Style>
                                                    <Style TargetType="Border">
                                                        <Setter Property="Background" Value="White"/>
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding IsActive}" Value="True">
                                                                <Setter Property="Background" Value="{StaticResource InfoBlueLight}"/>
                                                                <Setter Property="BorderBrush" Value="{StaticResource PrimaryBlue}"/>
                                                                <Setter Property="BorderThickness" Value="2"/>
                                                            </DataTrigger>
                                                            <DataTrigger Binding="{Binding IsComplete}" Value="True">
                                                                <Setter Property="Background" Value="{StaticResource SuccessGreenLight}"/>
                                                                <Setter Property="BorderBrush" Value="{StaticResource SuccessGreen}"/>
                                                            </DataTrigger>
                                                            <DataTrigger Binding="{Binding IsPastDue}" Value="True">
                                                                <Setter Property="Background" Value="{StaticResource ErrorRedLight}"/>
                                                                <Setter Property="BorderBrush" Value="{StaticResource ErrorRed}"/>
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </Border.Style>

                                                <StackPanel>
                                                    <!-- Phase Header -->
                                                    <Grid Margin="0,0,0,10">
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="*"/>
                                                            <ColumnDefinition Width="Auto"/>
                                                        </Grid.ColumnDefinitions>

                                                        <StackPanel Grid.Column="0">
                                                            <TextBlock FontWeight="Bold" FontSize="14">
                                                                <Run Text="📅 Phase"/>
                                                                <Run Text="{Binding PhaseNumber}"/>
                                                                <Run Text=":"/>
                                                                <Run Text="{Binding Name}"/>
                                                            </TextBlock>
                                                            <TextBlock FontSize="12" Foreground="{StaticResource TextSecondary}" Margin="0,2,0,0">
                                                                <Run Text="{Binding StartDate, StringFormat='{}{0:MMM dd}'}"/>
                                                                <Run Text=" - "/>
                                                                <Run Text="{Binding EndDate, StringFormat='{}{0:MMM dd}'}"/>
                                                                <Run Text=" • "/>
                                                                <Run Text="{Binding DeviceCount}"/>
                                                                <Run Text=" devices"/>
                                                            </TextBlock>
                                                        </StackPanel>

                                                        <Border Grid.Column="1" CornerRadius="12" Padding="8,4" VerticalAlignment="Top">
                                                            <Border.Style>
                                                                <Style TargetType="Border">
                                                                    <Setter Property="Background" Value="{StaticResource BorderLight}"/>
                                                                    <Style.Triggers>
                                                                        <DataTrigger Binding="{Binding IsActive}" Value="True">
                                                                            <Setter Property="Background" Value="{StaticResource PrimaryBlue}"/>
                                                                        </DataTrigger>
                                                                        <DataTrigger Binding="{Binding IsComplete}" Value="True">
                                                                            <Setter Property="Background" Value="{StaticResource SuccessGreen}"/>
                                                                        </DataTrigger>
                                                                        <DataTrigger Binding="{Binding IsPastDue}" Value="True">
                                                                            <Setter Property="Background" Value="{StaticResource ErrorRed}"/>
                                                                        </DataTrigger>
                                                                    </Style.Triggers>
                                                                </Style>
                                                            </Border.Style>
                                                            <TextBlock FontSize="11" FontWeight="SemiBold" Foreground="White">
                                                                <TextBlock.Style>
                                                                    <Style TargetType="TextBlock">
                                                                        <Setter Property="Text" Value="Upcoming"/>
                                                                        <Style.Triggers>
                                                                            <DataTrigger Binding="{Binding IsActive}" Value="True">
                                                                                <Setter Property="Text">
                                                                                    <Setter.Value>
                                                                                        <MultiBinding StringFormat="Active • {0} days left">
                                                                                            <Binding Path="DaysRemaining"/>
                                                                                        </MultiBinding>
                                                                                    </Setter.Value>
                                                                                </Setter>
                                                                            </DataTrigger>
                                                                            <DataTrigger Binding="{Binding IsComplete}" Value="True">
                                                                                <Setter Property="Text" Value="✓ Complete"/>
                                                                            </DataTrigger>
                                                                            <DataTrigger Binding="{Binding IsPastDue}" Value="True">
                                                                                <Setter Property="Text" Value="⚠ Past Due"/>
                                                                            </DataTrigger>
                                                                        </Style.Triggers>
                                                                    </Style>
                                                                </TextBlock.Style>
                                                            </TextBlock>
                                                        </Border>
                                                    </Grid>

                                                    <!-- Tasks -->
                                                    <TextBlock Text="Weekly Tasks:" FontWeight="SemiBold" FontSize="12" 
                                                               Margin="0,5,0,5"/>
                                                    <ItemsControl ItemsSource="{Binding Tasks}">
                                                        <ItemsControl.ItemTemplate>
                                                            <DataTemplate>
                                                                <TextBlock FontSize="12" Margin="0,2,0,2">
                                                                    <Run Text="•" Foreground="{StaticResource PrimaryBlue}"/>
                                                                    <Run Text="{Binding Mode=OneWay}"/>
                                                                </TextBlock>
                                                            </DataTemplate>
                                                        </ItemsControl.ItemTemplate>
                                                    </ItemsControl>

                                                    <!-- Success Criteria -->
                                                    <Border Background="{StaticResource AccentAmberLight}" BorderBrush="{StaticResource AccentAmber}" BorderThickness="1" 
                                                            CornerRadius="4" Padding="8" Margin="0,10,0,0">
                                                        <TextBlock FontSize="12">
                                                            <Run Text="🎯 Success:" FontWeight="SemiBold"/>
                                                            <Run Text="{Binding SuccessCriteria}"/>
                                                        </TextBlock>
                                                    </Border>
                                                </StackPanel>
                                            </Border>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </StackPanel>
                        </Border>

                        <!-- 4. Device Selection Intelligence (Phase 1 AI) - HIDDEN -->
                        <Border Style="{StaticResource SectionCard}" Visibility="Collapsed">
                            <StackPanel>
                                <TextBlock Text="🎯 Device Selection Intelligence" Style="{StaticResource SectionTitle}"/>
                                <TextBlock Text="AI-recommended enrollment batches based on readiness scores" 
                                           FontSize="12" Foreground="{StaticResource TextSecondary}" Margin="0,0,0,15"/>

                                <!-- Readiness Summary -->
                                <Grid Margin="0,0,0,20">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>

                                    <StackPanel Grid.Column="0">
                                        <TextBlock Text="Excellent" Style="{StaticResource MetricLabel}"/>
                                        <TextBlock Text="{Binding ExcellentReadinessCount}" 
                                                   FontSize="20" FontWeight="Bold" Foreground="{StaticResource SuccessGreen}"/>
                                        <TextBlock Text="80+ score" FontSize="10" Foreground="#999"/>
                                    </StackPanel>

                                    <StackPanel Grid.Column="1">
                                        <TextBlock Text="Good" Style="{StaticResource MetricLabel}"/>
                                        <TextBlock Text="{Binding GoodReadinessCount}" 
                                                   FontSize="20" FontWeight="Bold" Foreground="{StaticResource PrimaryBlue}"/>
                                        <TextBlock Text="60-79 score" FontSize="10" Foreground="#999"/>
                                    </StackPanel>

                                    <StackPanel Grid.Column="2">
                                        <TextBlock Text="Fair" Style="{StaticResource MetricLabel}"/>
                                        <TextBlock Text="{Binding FairReadinessCount}" 
                                                   FontSize="20" FontWeight="Bold" Foreground="{StaticResource AccentAmber}"/>
                                        <TextBlock Text="40-59 score" FontSize="10" Foreground="#999"/>
                                    </StackPanel>

                                    <StackPanel Grid.Column="3">
                                        <TextBlock Text="Poor" Style="{StaticResource MetricLabel}"/>
                                        <TextBlock Text="{Binding PoorReadinessCount}" 
                                                   FontSize="20" FontWeight="Bold" Foreground="{StaticResource ErrorRed}"/>
                                        <TextBlock Text="&lt;40 score" FontSize="10" Foreground="#999"/>
                                    </StackPanel>
                                </Grid>

                                <!-- Next Batch Recommendation -->
                                <Border Background="{StaticResource InfoBlueLight}" BorderBrush="{StaticResource PrimaryBlue}" BorderThickness="1" 
                                        CornerRadius="6" Padding="15" Margin="0,0,0,15">
                                    <StackPanel>
                                        <TextBlock FontWeight="SemiBold" FontSize="14" Margin="0,0,0,10">
                                            <Run Text="🎯 Next Batch Ready:"/>
                                            <Run Text="{Binding NextBatchSize, Mode=OneWay}"/>
                                            <Run Text="High-Readiness Devices"/>
                                        </TextBlock>
                                        <TextBlock FontSize="12" Foreground="#333" TextWrapping="Wrap">
                                            <Run Text="•"/>
                                            <Run Text="{Binding ExcellentReadinessCount}"/>
                                            <Run Text="devices with Excellent readiness (80+ score)"/>
                                            <LineBreak/>
                                            <Run Text="•"/>
                                            <Run Text="{Binding GoodReadinessCount}"/>
                                            <Run Text="devices with Good readiness (60-79 score)"/>
                                        </TextBlock>
                                        <Button Content="📋 Export Device List"
                                                Command="{Binding ExportDeviceListCommand}"
                                                Style="{StaticResource ActionButton}"
                                                Background="{StaticResource PrimaryBlue}"
                                                FontSize="12"
                                                Padding="12,6"
                                                Margin="0,10,0,0"
                                                HorizontalAlignment="Left"/>
                                    </StackPanel>
                                </Border>

                                <!-- Barriers and Risks -->
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="10"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>

                                    <Border Grid.Column="0" Background="{StaticResource AccentAmberLight}" BorderBrush="{StaticResource AccentAmber}" 
                                            BorderThickness="1" CornerRadius="6" Padding="12">
                                        <StackPanel>
                                            <TextBlock FontWeight="SemiBold" FontSize="12" Margin="0,0,0,8">
                                                <Run Text="⚠️"/>
                                                <Run Text="{Binding DevicesNeedingPreparation}"/>
                                                <Run Text="Devices Need Preparation"/>
                                            </TextBlock>
                                            <TextBlock FontSize="11" Foreground="#666" TextWrapping="Wrap">
                                                <Run Text="Common barriers:"/>
                                                <LineBreak/>
                                                <Run Text="• Not Entra ID joined"/>
                                                <LineBreak/>
                                                <Run Text="• Offline &gt;7 days"/>
                                                <LineBreak/>
                                                <Run Text="• Legacy OS version"/>
                                            </TextBlock>
                                        </StackPanel>
                                    </Border>

                                    <Border Grid.Column="2" Background="{StaticResource ErrorRedLight}" BorderBrush="{StaticResource ErrorRed}" 
                                            BorderThickness="1" CornerRadius="6" Padding="12">
                                        <StackPanel>
                                            <TextBlock FontWeight="SemiBold" FontSize="12" Margin="0,0,0,8">
                                                <Run Text="📋"/>
                                                <Run Text="{Binding HighRiskDeviceCount}"/>
                                                <Run Text="Devices: Enroll Last"/>
                                            </TextBlock>
                                            <TextBlock FontSize="11" Foreground="#666" TextWrapping="Wrap">
                                                <Run Text="Risk factors:"/>
                                                <LineBreak/>
                                                <Run Text="• VIP users"/>
                                                <LineBreak/>
                                                <Run Text="• Offline &gt;30 days"/>
                                                <LineBreak/>
                                                <Run Text="• Critical workloads"/>
                                            </TextBlock>
                                        </StackPanel>
                                    </Border>
                                </Grid>
                            </StackPanel>
                        </Border>

                        <!-- 5. Workload Trend Tracking (Phase 1 AI) - MOVED TO WORKLOADS TAB -->
                        <Border Style="{StaticResource SectionCard}" Visibility="Collapsed">
                            <StackPanel>
                                <TextBlock Text="📊 Workload Velocity Tracking" Style="{StaticResource SectionTitle}"/>
                                <TextBlock Text="Historical progress and migration velocity analysis" 
                                           FontSize="12" Foreground="{StaticResource TextSecondary}" Margin="0,0,0,15"/>

                                <!-- Velocity Chart -->
                                <lvc:CartesianChart Height="300" Series="{Binding WorkloadTrendSeries}" 
                                                    LegendLocation="Right" Margin="0,0,0,20">
                                    <lvc:CartesianChart.AxisX>
                                        <lvc:Axis Labels="{Binding WorkloadTrendLabels}" Title="Date"/>
                                    </lvc:CartesianChart.AxisX>
                                    <lvc:CartesianChart.AxisY>
                                        <lvc:Axis Title="Completion %" MinValue="0" MaxValue="100"/>
                                    </lvc:CartesianChart.AxisY>
                                </lvc:CartesianChart>

                                <!-- Velocity Indicators -->
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>

                                    <Border Grid.Column="0" Background="{StaticResource SuccessGreenLight}" BorderBrush="{StaticResource SuccessGreen}" 
                                            BorderThickness="1" CornerRadius="6" Padding="12" Margin="0,0,5,0">
                                        <StackPanel>
                                            <TextBlock Text="🚀 Excellent Velocity" FontWeight="SemiBold" 
                                                       FontSize="12" Foreground="{StaticResource SuccessGreen}" Margin="0,0,0,5"/>
                                            <TextBlock FontSize="11" Foreground="#666">
                                                <Run Text="{Binding ExcellentVelocityCount}"/>
                                                <Run Text="workloads"/>
                                                <LineBreak/>
                                                <Run Text="&gt;15% per week"/>
                                            </TextBlock>
                                        </StackPanel>
                                    </Border>

                                    <Border Grid.Column="1" Background="{StaticResource AccentAmberLight}" BorderBrush="{StaticResource AccentAmber}" 
                                            BorderThickness="1" CornerRadius="6" Padding="12" Margin="5,0">
                                        <StackPanel>
                                            <TextBlock Text="⚡ Good Velocity" FontWeight="SemiBold" 
                                                       FontSize="12" Foreground="{StaticResource AccentAmber}" Margin="0,0,0,5"/>
                                            <TextBlock FontSize="11" Foreground="#666">
                                                <Run Text="{Binding GoodVelocityCount}"/>
                                                <Run Text="workloads"/>
                                                <LineBreak/>
                                                <Run Text="10-15% per week"/>
                                            </TextBlock>
                                        </StackPanel>
                                    </Border>

                                    <Border Grid.Column="2" Background="{StaticResource ErrorRedLight}" BorderBrush="{StaticResource ErrorRed}" 
                                            BorderThickness="1" CornerRadius="6" Padding="12" Margin="5,0,0,0">
                                        <StackPanel>
                                            <TextBlock Text="📉 Stalled" FontWeight="SemiBold" 
                                                       FontSize="12" Foreground="{StaticResource ErrorRed}" Margin="0,0,0,5"/>
                                            <TextBlock FontSize="11" Foreground="#666">
                                                <Run Text="{Binding StalledWorkloadCount}"/>
                                                <Run Text="workloads"/>
                                                <LineBreak/>
                                                <Run Text="&lt;5% per week"/>
                                            </TextBlock>
                                        </StackPanel>
                                    </Border>
                                </Grid>
                            </StackPanel>
                        </Border>

                        <!-- 6. Application Migration Analysis (Phase 2 Feature) - MOVED TO APPLICATIONS TAB -->
                        <Border Style="{StaticResource SectionCard}" Visibility="Collapsed">
                            <StackPanel>
                                <Grid Margin="0,0,0,15">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    
                                    <StackPanel Grid.Column="0">
                                        <TextBlock Text="📱 Application Migration Analysis" Style="{StaticResource SectionTitle}" Margin="0"/>
                                        <TextBlock Text="ConfigMgr application inventory with Intune migration guidance" 
                                                   FontSize="12" Foreground="#666" Margin="0,2,0,0"/>
                                    </StackPanel>
                                    
                                    <Button Grid.Column="1" 
                                            Content="🔄 Refresh Analysis"
                                            Command="{Binding AnalyzeApplicationsCommand}"
                                            Style="{StaticResource ActionButton}"
                                            FontSize="12"
                                            Padding="12,6"/>
                                </Grid>

                                <!-- Summary Cards -->
                                <Grid Margin="0,0,0,20">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>

                                    <Border Grid.Column="0" Background="{StaticResource SuccessGreenLight}" BorderBrush="{StaticResource SuccessGreen}" 
                                            BorderThickness="1" CornerRadius="6" Padding="12" Margin="0,0,5,0">
                                        <StackPanel>
                                            <TextBlock Text="Low Complexity" Style="{StaticResource MetricLabel}"/>
                                            <TextBlock Text="{Binding LowComplexityCount}" 
                                                       FontSize="20" FontWeight="Bold" Foreground="{StaticResource SuccessGreen}"/>
                                            <TextBlock Text="Easy migration" FontSize="10" Foreground="#666"/>
                                        </StackPanel>
                                    </Border>

                                    <Border Grid.Column="1" Background="{StaticResource AccentAmberLight}" BorderBrush="{StaticResource AccentAmber}" 
                                            BorderThickness="1" CornerRadius="6" Padding="12" Margin="5,0">
                                        <StackPanel>
                                            <TextBlock Text="Medium Complexity" Style="{StaticResource MetricLabel}"/>
                                            <TextBlock Text="{Binding MediumComplexityCount}" 
                                                       FontSize="20" FontWeight="Bold" Foreground="{StaticResource AccentAmber}"/>
                                            <TextBlock Text="Some effort needed" FontSize="10" Foreground="#666"/>
                                        </StackPanel>
                                    </Border>

                                    <Border Grid.Column="2" Background="{StaticResource ErrorRedLight}" BorderBrush="{StaticResource ErrorRed}" 
                                            BorderThickness="1" CornerRadius="6" Padding="12" Margin="5,0">
                                        <StackPanel>
                                            <TextBlock Text="High Complexity" Style="{StaticResource MetricLabel}"/>
                                            <TextBlock Text="{Binding HighComplexityCount}" 
                                                       FontSize="20" FontWeight="Bold" Foreground="{StaticResource ErrorRed}"/>
                                            <TextBlock Text="Requires planning" FontSize="10" Foreground="#666"/>
                                        </StackPanel>
                                    </Border>

                                    <Border Grid.Column="3" Background="{StaticResource InfoBlueLight}" BorderBrush="{StaticResource PrimaryBlue}" 
                                            BorderThickness="1" CornerRadius="6" Padding="12" Margin="5,0,0,0">
                                        <StackPanel>
                                            <TextBlock Text="Total Apps" Style="{StaticResource MetricLabel}"/>
                                            <TextBlock Text="{Binding TotalApplicationCount}" 
                                                       FontSize="20" FontWeight="Bold" Foreground="{StaticResource PrimaryBlue}"/>
                                            <TextBlock Text="Analyzed" FontSize="10" Foreground="#666"/>
                                        </StackPanel>
                                    </Border>
                                </Grid>

                                <!-- Empty State Message -->
                                <Border Background="{StaticResource BackgroundPage}" 
                                        CornerRadius="6" 
                                        Padding="30"
                                        Margin="0,15,0,0"
                                        Visibility="{Binding ApplicationMigrations, Converter={StaticResource NullToVisibilityConverter}}">
                                    <StackPanel HorizontalAlignment="Center">
                                        <TextBlock Text="No applications analyzed yet" 
                                                   FontSize="14" 
                                                   FontWeight="SemiBold" 
                                                   Foreground="#666"
                                                   HorizontalAlignment="Center"
                                                   Margin="0,0,0,8"/>
                                        <TextBlock Text="Click 'Refresh Analysis' to analyze your ConfigMgr application inventory" 
                                                   FontSize="12" 
                                                   Foreground="#888"
                                                   HorizontalAlignment="Center"/>
                                    </StackPanel>
                                </Border>

                                <!-- Application List -->
                                <ItemsControl ItemsSource="{Binding ApplicationMigrations}"
                                              Visibility="{Binding ApplicationMigrations, Converter={StaticResource ObjectToVisibilityConverter}}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Border BorderBrush="{StaticResource BorderLight}" BorderThickness="0,0,0,1" Padding="0,12">
                                                <Grid>
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="2*"/>
                                                        <ColumnDefinition Width="Auto"/>
                                                        <ColumnDefinition Width="*"/>
                                                        <ColumnDefinition Width="Auto"/>
                                                    </Grid.ColumnDefinitions>

                                                    <!-- App Name & Details -->
                                                    <StackPanel Grid.Column="0">
                                                        <TextBlock Text="{Binding ApplicationName}" 
                                                                   FontWeight="SemiBold" FontSize="14"/>
                                                        <TextBlock FontSize="11" Foreground="#666" Margin="0,2,0,0">
                                                            <Run Text="Deployment:"/>
                                                            <Run Text="{Binding DeploymentType}" FontWeight="SemiBold"/>
                                                            <Run Text=" • Devices:"/>
                                                            <Run Text="{Binding TargetedDevices}" FontWeight="SemiBold"/>
                                                        </TextBlock>
                                                    </StackPanel>

                                                    <!-- Complexity Score -->
                                                    <Border Grid.Column="1" 
                                                            BorderBrush="{Binding ComplexityColor}" 
                                                            BorderThickness="2"
                                                            CornerRadius="6" 
                                                            Padding="12,6" 
                                                            Margin="10,0">
                                                        <StackPanel HorizontalAlignment="Center">
                                                            <TextBlock Text="{Binding ComplexityScore}" 
                                                                       FontSize="18" 
                                                                       FontWeight="Bold" 
                                                                       Foreground="{Binding ComplexityColor}"
                                                                       HorizontalAlignment="Center"/>
                                                            <TextBlock Text="{Binding ComplexityCategory}" 
                                                                       FontSize="9" 
                                                                       Foreground="#666"
                                                                       HorizontalAlignment="Center"/>
                                                        </StackPanel>
                                                    </Border>

                                                    <!-- Migration Path & Recommendation -->
                                                    <StackPanel Grid.Column="2" Margin="10,0">
                                                        <TextBlock Text="{Binding MigrationPath}" 
                                                                   FontSize="11" 
                                                                   FontWeight="SemiBold"
                                                                   Foreground="{StaticResource PrimaryBlue}"/>
                                                        <TextBlock Text="{Binding Recommendation}" 
                                                                   FontSize="10" 
                                                                   Foreground="#666" 
                                                                   TextWrapping="Wrap"
                                                                   Margin="0,2,0,0"/>
                                                    </StackPanel>

                                                    <!-- Estimated Effort -->
                                                    <Border Grid.Column="3" 
                                                            Background="{StaticResource BackgroundPage}" 
                                                            CornerRadius="4" 
                                                            Padding="10,6"
                                                            Margin="10,0,0,0">
                                                        <StackPanel>
                                                            <TextBlock Text="⏱️ Effort" 
                                                                       FontSize="9" 
                                                                       Foreground="#666"
                                                                       HorizontalAlignment="Center"/>
                                                            <TextBlock Text="{Binding EstimatedEffort}" 
                                                                       FontSize="11" 
                                                                       FontWeight="SemiBold"
                                                                       HorizontalAlignment="Center"/>
                                                        </StackPanel>
                                                    </Border>
                                                </Grid>
                                            </Border>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </StackPanel>
                        </Border>

                        <!-- 7. Remaining Workloads (HIDDEN - Low value for admins) -->
                        <Border Style="{StaticResource SectionCard}" Visibility="Collapsed">
                            <StackPanel>
                                <TextBlock Text="📋 Workload Status" Style="{StaticResource SectionTitle}"/>
                                
                                <ItemsControl ItemsSource="{Binding Workloads}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Border BorderBrush="{StaticResource BorderLight}" BorderThickness="0,0,0,1" Padding="0,10">
                                                <Grid>
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="*"/>
                                                        <ColumnDefinition Width="Auto"/>
                                                        <ColumnDefinition Width="Auto"/>
                                                    </Grid.ColumnDefinitions>

                                                    <StackPanel Grid.Column="0">
                                                        <TextBlock Text="{Binding Name}" FontWeight="SemiBold" FontSize="14"/>
                                                        <TextBlock Text="{Binding Description}" 
                                                                   FontSize="12" Foreground="{StaticResource TextSecondary}" 
                                                                   TextWrapping="Wrap" Margin="0,2,0,0"/>
                                                    </StackPanel>

                                                    <Border Grid.Column="1" 
                                                            Background="{Binding Status, Converter={StaticResource WorkloadStatusConverter}}"
                                                            CornerRadius="12" Padding="10,5" Margin="10,0">
                                                        <TextBlock Text="{Binding Status}" 
                                                                   FontSize="11" Foreground="White" FontWeight="SemiBold"/>
                                                    </Border>

                                                    <StackPanel Grid.Column="2" Orientation="Horizontal">
                                                        <Button Content="Start" 
                                                                Command="{Binding DataContext.StartMigrationCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                                CommandParameter="{Binding Mode=OneWay}"
                                                                Style="{StaticResource ActionButton}"
                                                                Visibility="{Binding Status, Converter={StaticResource WorkloadStatusConverter}, ConverterParameter=NotStarted}"/>
                                                        <Button Content="Learn More" 
                                                                Command="{Binding DataContext.LearnMoreCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                                CommandParameter="{Binding LearnMoreUrl}"
                                                                Style="{StaticResource ActionButton}"
                                                                Background="{StaticResource TextSecondary}"/>
                                                    </StackPanel>
                                                </Grid>
                                            </Border>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </StackPanel>
                        </Border>

                        <!-- 4. Security & Compliance Scorecard -->
                        <Border Style="{StaticResource SectionCard}" Visibility="Collapsed">
                            <StackPanel>
                                <TextBlock Text="🔒 Security &amp; Compliance Scorecard" Style="{StaticResource SectionTitle}"/>
                                
                                <lvc:CartesianChart Height="200" Series="{Binding ComplianceComparisonSeries}" 
                                                    LegendLocation="Right" Margin="0,0,0,15">
                                    <lvc:CartesianChart.AxisX>
                                        <lvc:Axis Labels="{Binding ComplianceLabels}"/>
                                    </lvc:CartesianChart.AxisX>
                                    <lvc:CartesianChart.AxisY>
                                        <lvc:Axis Title="Compliance Score" MaxValue="100"/>
                                    </lvc:CartesianChart.AxisY>
                                </lvc:CartesianChart>

                                <TextBlock Text="Risk Areas:" FontWeight="SemiBold" Margin="0,0,0,5"/>
                                <ItemsControl ItemsSource="{Binding ComplianceScore.RiskAreas}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <TextBlock FontSize="12" Foreground="{StaticResource ErrorRed}" Margin="0,2">
                                                <Run Text="⚠️ "/><Run Text="{Binding Mode=OneWay}"/>
                                            </TextBlock>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </StackPanel>
                        </Border>

                        <!-- 6. Savings Unlock Insight - WHAT ACTIONS UNLOCK SAVINGS -->
                        <Border Style="{StaticResource SectionCard}"
                                Visibility="Collapsed">
                            <StackPanel>
                                <TextBlock Text="💰 Unlock Savings with Action" Style="{StaticResource SectionTitle}"/>
                                
                                <!-- Enrollment Action -->
                                <Border Background="{StaticResource SuccessGreenLight}" Padding="12" CornerRadius="4" Margin="0,10,0,10">
                                    <StackPanel>
                                        <TextBlock Text="📱 Enrollment Impact" FontWeight="Bold" FontSize="13" Margin="0,0,0,5"/>
                                        <TextBlock FontSize="24" FontWeight="Bold" Foreground="{StaticResource SuccessGreen}" Margin="0,0,0,5">
                                            <Run Text="{Binding SavingsUnlockInsight.SavingsLockedBehindEnrollment, Converter={StaticResource CurrencyConverter}, Mode=OneWay}"/>
                                            <Run Text="/year" FontSize="14"/>
                                        </TextBlock>
                                        <TextBlock Text="locked behind device enrollment" FontSize="12" Foreground="#666" Margin="0,0,0,8"/>
                                        <TextBlock FontSize="13" FontWeight="SemiBold" Foreground="#333">
                                            <Run Text="✅ ACTION: "/>
                                            <Run Text="{Binding SavingsUnlockInsight.RecommendedAction, Mode=OneWay}" FontWeight="Normal"/>
                                        </TextBlock>
                                    </StackPanel>
                                </Border>

                                <!-- Workload Transition Action -->
                                <Border Background="{StaticResource InfoBlueLight}" Padding="12" CornerRadius="4">
                                    <StackPanel>
                                        <TextBlock Text="🔄 Workload Transition Impact" FontWeight="Bold" FontSize="13" Margin="0,0,0,5"/>
                                        <TextBlock FontSize="24" FontWeight="Bold" Foreground="{StaticResource PrimaryBlue}" Margin="0,0,0,5">
                                            <Run Text="{Binding SavingsUnlockInsight.SavingsFromWorkloadTransition, Converter={StaticResource CurrencyConverter}, Mode=OneWay}"/>
                                            <Run Text="/year" FontSize="14"/>
                                        </TextBlock>
                                        <TextBlock FontSize="12" Foreground="#666" Margin="0,0,0,8">
                                            <Run Text="unlocked by transitioning "/>
                                            <Run Text="{Binding SavingsUnlockInsight.WorkloadToTransition, Mode=OneWay}" FontWeight="Bold"/>
                                        </TextBlock>
                                        <TextBlock Text="{Binding SavingsUnlockInsight.NextSavingsMilestone}" 
                                                   FontSize="11" FontStyle="Italic" Foreground="#555"/>
                                    </StackPanel>
                                </Border>
                            </StackPanel>
                        </Border>

                        <!-- 9. Enrollment Readiness (True Blockers Only) - MOVED TO ENROLLMENT TAB -->
                        <Border Style="{StaticResource SectionCard}" Visibility="Collapsed">
                            <StackPanel>
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="🚫 Enrollment Readiness" Style="{StaticResource SectionTitle}" Margin="0,0,10,0"/>
                                </StackPanel>
                                <TextBlock Text="Prerequisites required for Intune co-management enrollment" FontSize="11" Foreground="#666" Margin="0,0,0,10"/>
                                
                                <!-- Empty state when no blockers (ready to enroll!) -->
                                <Border Background="{StaticResource SuccessGreenLight}" CornerRadius="4" Padding="20" Margin="0,10,0,0"
                                        Visibility="{Binding Blockers.Count, Mode=OneWay, Converter={StaticResource CountToVisibilityConverter}}">
                                    <StackPanel HorizontalAlignment="Center">
                                        <TextBlock Text="✅ All Prerequisites Met" FontSize="14" FontWeight="SemiBold" Foreground="{StaticResource SuccessGreen}" HorizontalAlignment="Center"/>
                                        <TextBlock Text="No enrollment blockers detected - ready to enroll devices" FontSize="11" Foreground="{StaticResource SuccessGreen}" HorizontalAlignment="Center" Margin="0,5,0,0"/>
                                    </StackPanel>
                                </Border>
                                
                                <ItemsControl ItemsSource="{Binding Blockers}">
                                    <ItemsControl.ItemsPanel>
                                        <ItemsPanelTemplate>
                                            <UniformGrid Columns="2" />
                                        </ItemsPanelTemplate>
                                    </ItemsControl.ItemsPanel>
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Border Background="{StaticResource ErrorRedLight}" CornerRadius="4" Padding="10" Margin="0,0,8,8"
                                                    BorderBrush="{Binding Severity, Converter={StaticResource BlockerSeverityConverter}}"
                                                    BorderThickness="2">
                                                <Grid>
                                                    <Grid.RowDefinitions>
                                                        <RowDefinition Height="Auto"/>
                                                        <RowDefinition Height="*"/>
                                                        <RowDefinition Height="Auto"/>
                                                    </Grid.RowDefinitions>

                                                    <TextBlock Grid.Row="0" Text="{Binding Title}" FontWeight="SemiBold" FontSize="12" TextTrimming="CharacterEllipsis"/>
                                                    <TextBlock Grid.Row="1" Text="{Binding Description}" 
                                                               FontSize="11" Foreground="{StaticResource TextSecondary}" 
                                                               TextWrapping="Wrap" TextTrimming="CharacterEllipsis"
                                                               MaxHeight="40" Margin="0,3,0,5"/>
                                                    <Grid Grid.Row="2">
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="*"/>
                                                            <ColumnDefinition Width="Auto"/>
                                                        </Grid.ColumnDefinitions>
                                                        <TextBlock Grid.Column="0" Text="{Binding AffectedDevices, StringFormat='🔴 {0} devices'}" 
                                                                   FontSize="10" Foreground="{StaticResource ErrorRed}" FontWeight="SemiBold" VerticalAlignment="Center"/>
                                                        <Button Grid.Column="1" Content="Fix"
                                                                Command="{Binding DataContext.LearnMoreCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                                CommandParameter="{Binding RemediationUrl}"
                                                                Style="{StaticResource ActionButton}"
                                                                Background="{StaticResource ErrorRed}" FontSize="10" Padding="8,3"/>
                                                    </Grid>
                                                </Grid>
                                            </Border>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </StackPanel>
                        </Border>
                    </StackPanel>

                    <!-- Right Column -->
                    <StackPanel Grid.Column="2">
                        <!-- 7. Alerts & Nudges -->
                        <Border Style="{StaticResource SectionCard}">
                            <StackPanel>
                                <TextBlock Text="🔔 Alerts &amp; Recommendations" Style="{StaticResource SectionTitle}"/>
                                
                                <ItemsControl ItemsSource="{Binding Alerts}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Border Background="{Binding Severity, Converter={StaticResource AlertSeverityConverter}}"
                                                    CornerRadius="4" Padding="12" Margin="0,0,0,10">
                                                <StackPanel>
                                                    <TextBlock Text="{Binding Title}" 
                                                               FontWeight="SemiBold" FontSize="13" 
                                                               Foreground="{StaticResource TextPrimary}"/>
                                                    <TextBlock Text="{Binding Description}" 
                                                               FontSize="12" Foreground="{StaticResource TextSecondary}" 
                                                               TextWrapping="Wrap" Margin="0,5,0,10"/>
                                                    <Button Content="{Binding ActionText}" 
                                                            Command="{Binding DataContext.ActionCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                            CommandParameter="fasttrack"
                                                            Style="{StaticResource ActionButton}"
                                                            HorizontalAlignment="Left"/>
                                                </StackPanel>
                                            </Border>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </StackPanel>
                        </Border>

                        <!-- 8. Progress Targets - FORWARD-LOOKING ACTIONS -->
                        <Border Style="{StaticResource SectionCard}"
                                Visibility="{Binding ProgressTargets.Count, Converter={StaticResource CountToVisibilityConverter}}">
                            <StackPanel>
                                <TextBlock Text="🎯 Your Progress Targets" Style="{StaticResource SectionTitle}"/>
                                <TextBlock Text="Specific actions to achieve your next milestones" 
                                           FontSize="11" Foreground="#666" Margin="0,0,0,10"/>
                                
                                <ItemsControl ItemsSource="{Binding ProgressTargets}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Border Background="{StaticResource InfoBlueLight}" BorderBrush="{StaticResource PrimaryBlue}" BorderThickness="1" 
                                                    CornerRadius="4" Padding="12" Margin="0,0,0,10">
                                                <StackPanel>
                                                    <StackPanel Orientation="Horizontal" Margin="0,0,0,5">
                                                        <TextBlock FontSize="18" Text="{Binding Icon}" Margin="0,0,8,0"/>
                                                        <TextBlock Text="{Binding TargetDescription}" 
                                                                   FontWeight="Bold" FontSize="13" Foreground="{StaticResource PrimaryBlue}"/>
                                                    </StackPanel>
                                                    <TextBlock FontSize="11" Foreground="#666" Margin="0,0,0,5">
                                                        <Run Text="📅 Target: "/>
                                                        <Run Text="{Binding TargetDate, StringFormat='{}{0:MMM d, yyyy}'}" FontWeight="SemiBold"/>
                                                    </TextBlock>
                                                    <Border Background="{StaticResource AccentAmberLight}" Padding="8" CornerRadius="3" Margin="0,0,0,5">
                                                        <TextBlock FontSize="11" Foreground="{StaticResource WarningOrange}" TextWrapping="Wrap">
                                                            <Run Text="✅ "/>
                                                            <Run Text="{Binding ActionToAchieve}" FontWeight="SemiBold"/>
                                                        </TextBlock>
                                                    </Border>
                                                    <StackPanel Orientation="Horizontal" Margin="0,5,0,0">
                                                        <Border Background="{StaticResource SuccessGreenLight}" Padding="5,2" CornerRadius="3" Margin="0,0,5,0"
                                                                Visibility="{Binding IsEnrollmentTarget, Converter={StaticResource BoolToVisibilityConverter}}">
                                                            <TextBlock FontSize="10" Foreground="{StaticResource SuccessGreen}">
                                                                <Run Text="📱 "/>
                                                                <Run Text="{Binding DevicesRequired, Mode=OneWay}"/>
                                                                <Run Text=" devices"/>
                                                            </TextBlock>
                                                        </Border>
                                                        <Border Background="{StaticResource InfoBlueLight}" Padding="5,2" CornerRadius="3"
                                                                Visibility="{Binding IsWorkloadTarget, Converter={StaticResource BoolToVisibilityConverter}}">
                                                            <TextBlock FontSize="10" Foreground="{StaticResource PrimaryBlue}">
                                                                <Run Text="🔄 "/>
                                                                <Run Text="{Binding WorkloadsRequired, Mode=OneWay}"/>
                                                                <Run Text=" workload"/>
                                                            </TextBlock>
                                                        </Border>
                                                    </StackPanel>
                                                </StackPanel>
                                            </Border>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </StackPanel>
                        </Border>

                        <!-- 10. Engagement Options -->
                        <Border Style="{StaticResource SectionCard}">
                            <StackPanel>
                                <TextBlock Text="🤝 Get Help &amp; Resources" Style="{StaticResource SectionTitle}"/>
                                
                                <ItemsControl ItemsSource="{Binding EngagementOptions}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Button Command="{Binding DataContext.LearnMoreCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                    CommandParameter="{Binding Url}"
                                                    Background="White"
                                                    BorderBrush="{StaticResource BorderLight}"
                                                    BorderThickness="1"
                                                    HorizontalContentAlignment="Stretch"
                                                    Margin="0,0,0,10"
                                                    Padding="12,10"
                                                    Cursor="Hand">
                                                <Button.Style>
                                                    <Style TargetType="Button">
                                                        <Setter Property="Template">
                                                            <Setter.Value>
                                                                <ControlTemplate TargetType="Button">
                                                                    <Border x:Name="border" 
                                                                            Background="{TemplateBinding Background}"
                                                                            BorderBrush="{TemplateBinding BorderBrush}"
                                                                            BorderThickness="{TemplateBinding BorderThickness}"
                                                                            CornerRadius="6"
                                                                            Padding="{TemplateBinding Padding}">
                                                                        <ContentPresenter HorizontalAlignment="Stretch"/>
                                                                    </Border>
                                                                    <ControlTemplate.Triggers>
                                                                        <Trigger Property="IsMouseOver" Value="True">
                                                                            <Setter TargetName="border" Property="Background" Value="{StaticResource InfoBlueLight}"/>
                                                                            <Setter TargetName="border" Property="BorderBrush" Value="{StaticResource PrimaryBlue}"/>
                                                                        </Trigger>
                                                                    </ControlTemplate.Triggers>
                                                                </ControlTemplate>
                                                            </Setter.Value>
                                                        </Setter>
                                                    </Style>
                                                </Button.Style>
                                                <Grid>
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="50"/>
                                                        <ColumnDefinition Width="*"/>
                                                        <ColumnDefinition Width="Auto"/>
                                                    </Grid.ColumnDefinitions>
                                                    
                                                    <!-- Icon Circle -->
                                                    <Border Grid.Column="0" Width="40" Height="40" 
                                                            Background="{StaticResource InfoBlueLight}" CornerRadius="20"
                                                            VerticalAlignment="Center">
                                                        <TextBlock Text="{Binding IconPath}" 
                                                                   FontSize="20" 
                                                                   HorizontalAlignment="Center" 
                                                                   VerticalAlignment="Center"/>
                                                    </Border>
                                                    
                                                    <!-- Title and Description -->
                                                    <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="5,0,0,0">
                                                        <TextBlock Text="{Binding Title}" 
                                                                   FontWeight="SemiBold" FontSize="13" 
                                                                   Foreground="{StaticResource TextPrimary}"/>
                                                        <TextBlock Text="{Binding Description}" 
                                                                   FontSize="11" Foreground="{StaticResource TextSecondary}" 
                                                                   TextWrapping="Wrap" Margin="0,3,0,0"/>
                                                    </StackPanel>
                                                    
                                                    <!-- Arrow indicator -->
                                                    <TextBlock Grid.Column="2" Text="→" 
                                                               FontSize="16" Foreground="{StaticResource PrimaryBlue}"
                                                               VerticalAlignment="Center" Margin="10,0,5,0"/>
                                                </Grid>
                                            </Button>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </Grid>
            </StackPanel>
        </ScrollViewer>
    </TabItem>

                <!-- ENROLLMENT MOMENTUM TAB -->
