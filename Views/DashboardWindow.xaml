                                                    <StackPanel Grid.Column="0" Orientation="Horizontal">
                                                        <TextBlock Text="{Binding CardTypeIcon}" FontSize="18" VerticalAlignment="Center" Margin="0,0,8,0"/>
                                                        <TextBlock Text="{Binding WorkloadName}" FontSize="17" FontWeight="Bold" Foreground="#1E293B" VerticalAlignment="Center"/>
                                                    </StackPanel>

