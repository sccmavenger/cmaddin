                                    </Border>

                                    <Border Grid.Column="3" Background="{StaticResource InfoBlueLight}" BorderBrush="{StaticResource PrimaryBlue}" 
                                            BorderThickness="1" CornerRadius="6" Padding="12" Margin="5,0,0,0">
