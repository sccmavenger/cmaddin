                                                        </StackPanel>
                                                        <TextBlock Grid.Column="1" Text="{Binding DeviceEnrollment.CloudNativeDevices, StringFormat={}{0:N0}}" 
                                                                   FontSize="14" FontWeight="Bold" Foreground="{StaticResource PrimaryBlue}"/>
                                                    </Grid>
                                                    <!-- Co-managed -->
                                                    <Grid Margin="0,0,0,8">
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="*"/>
                                                            <ColumnDefinition Width="Auto"/>
                                                        </Grid.ColumnDefinitions>
                                                        <StackPanel Grid.Column="0" Orientation="Horizontal">
                                                            <Ellipse Width="10" Height="10" Fill="{StaticResource SuccessGreen}" Margin="0,0,8,0" VerticalAlignment="Center"/>
                                                            <TextBlock Text="Co-managed" FontSize="12" Foreground="{StaticResource TextSecondary}" VerticalAlignment="Center"/>
                                                        </StackPanel>
                                                        <TextBlock Grid.Column="1" Text="{Binding DeviceEnrollment.CoManagedDevices, StringFormat={}{0:N0}}" 
                                                                   FontSize="14" FontWeight="Bold" Foreground="{StaticResource SuccessGreen}"/>
                                                    </Grid>
                                                    <!-- ConfigMgr Only -->
                                                    <Grid Margin="0,0,0,8">
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="*"/>
                                                            <ColumnDefinition Width="Auto"/>
                                                        </Grid.ColumnDefinitions>
                                                        <StackPanel Grid.Column="0" Orientation="Horizontal">
                                                            <Ellipse Width="10" Height="10" Fill="{StaticResource ErrorRed}" Margin="0,0,8,0" VerticalAlignment="Center"/>
                                                            <TextBlock Text="ConfigMgr Only" FontSize="12" Foreground="{StaticResource TextSecondary}" VerticalAlignment="Center"/>
                                                        </StackPanel>
                                                        <TextBlock Grid.Column="1" Text="{Binding DeviceEnrollment.ConfigMgrOnlyDevices, StringFormat={}{0:N0}}" 
                                                                   FontSize="14" FontWeight="Bold" Foreground="{StaticResource ErrorRed}"/>
                                                    </Grid>
                                                    <Border Height="1" Background="{StaticResource BorderLight}" Margin="0,5,0,10"/>
                                                    <Grid>
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="*"/>
                                                            <ColumnDefinition Width="Auto"/>
                                                        </Grid.ColumnDefinitions>
                                                        <TextBlock Grid.Column="0" Text="Total Devices" FontSize="12" Foreground="{StaticResource TextPrimary}" FontWeight="SemiBold"/>
                                                        <TextBlock Grid.Column="1" Text="{Binding DeviceEnrollment.TotalDevices, StringFormat={}{0:N0}}" 
                                                                   FontSize="14" FontWeight="Bold" Foreground="{StaticResource TextPrimary}"/>
                                                    </Grid>
                                                </StackPanel>
                                            </Border>
                                        </StackPanel>
                                    </Border>

                                    <!-- RIGHT: Timeline with Milestones + Target Controls -->
                                    <Grid Grid.Column="1" Margin="30,10,0,10">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="400"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>
                                        
                                        <!-- Timeline Section -->
                                        <StackPanel Grid.Column="0">
                                            <TextBlock Text="📅 ENROLLMENT JOURNEY" FontSize="16" FontWeight="Bold" Foreground="{StaticResource TextPrimary}" Margin="0,0,0,20"/>
                                        
                                        <!-- Timeline Items -->
                                        <Grid Margin="0,0,0,0">
                                            <Grid.RowDefinitions>
                                                <RowDefinition Height="Auto"/>
                                                <RowDefinition Height="Auto"/>
                                                <RowDefinition Height="Auto"/>
                                                <RowDefinition Height="Auto"/>
                                            </Grid.RowDefinitions>

                                            <!-- Vertical Line (behind milestones) -->
                                            <Border Grid.Row="0" Grid.RowSpan="4" Width="3" Background="{StaticResource BorderLight}" 
                                                    HorizontalAlignment="Left" Margin="16,20,0,20"/>

                                            <!-- Milestone 1: Started -->
                                            <Grid Grid.Row="0" Margin="0,0,0,25">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="Auto"/>
                                                    <ColumnDefinition Width="*"/>
                                                </Grid.ColumnDefinitions>
                                                
                                                <Ellipse Grid.Column="0" Width="35" Height="35" Fill="{StaticResource SuccessGreen}" 
                                                         VerticalAlignment="Top"/>
                                                <TextBlock Grid.Column="0" Text="✓" FontSize="20" Foreground="White" 
                                                           FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Top"
                                                           Margin="0,5,0,0"/>
                                                
                                                <StackPanel Grid.Column="1" Margin="20,0,0,0">
                                                    <TextBlock Text="Assessment Complete" FontSize="14" FontWeight="Bold" Foreground="{StaticResource TextPrimary}"/>
                                                    <TextBlock FontSize="12" Foreground="{StaticResource TextSecondary}" TextWrapping="Wrap" Margin="0,3,0,0">
                                                        <Run Text="Discovered"/>
                                                        <Run Text="{Binding DeviceEnrollment.TotalDevices, StringFormat=' {0:N0}', TargetNullValue=' --'}" FontWeight="SemiBold"/>
                                                        <Run Text=" devices for migration"/>
                                                    </TextBlock>
                                                    <TextBlock Text="👉 View device readiness below" 
                                                               FontSize="11" Foreground="{StaticResource PrimaryBlue}" FontStyle="Italic" 
                                                               Margin="0,2,0,0" Cursor="Hand"
                                                               MouseLeftButtonUp="ScrollToDeviceReadiness_Click"
                                                               TextDecorations="Underline"/>
                                                </StackPanel>
                                            </Grid>

                                            <!-- Milestone 2: In Progress -->
                                            <Grid Grid.Row="1" Margin="0,0,0,25">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="Auto"/>
                                                    <ColumnDefinition Width="*"/>
                                                </Grid.ColumnDefinitions>
                                                
                                                <Ellipse Grid.Column="0" Width="35" Height="35" VerticalAlignment="Top">
                                                    <Ellipse.Fill>
                                                        <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                                            <GradientStop Color="#0078D4" Offset="0"/>
                                                            <GradientStop Color="#106EBE" Offset="1"/>
                                                        </LinearGradientBrush>
                                                    </Ellipse.Fill>
                                                </Ellipse>
                                                <TextBlock Grid.Column="0" Text="⏳" FontSize="18" Foreground="White" 
                                                           HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                
                                                <StackPanel Grid.Column="1" Margin="20,0,0,0">
                                                    <TextBlock FontSize="14" FontWeight="Bold" Foreground="{StaticResource PrimaryBlue}">
                                                        <Run Text="Active Enrollment"/>
                                                        <Run Text="{Binding EnrollmentProgressPercentage, StringFormat=' ({0:F0}%)', Mode=OneWay}" 
                                                             FontSize="13" Foreground="{StaticResource TextSecondary}"/>
                                                    </TextBlock>
                                                    <TextBlock FontSize="12" Foreground="{StaticResource TextSecondary}" TextWrapping="Wrap" Margin="0,3,0,0">
                                                        <Run Text="Enrolling devices at"/>
                                                        <Run Text="{Binding CurrentEnrollmentVelocity, StringFormat=' {0:F0}', TargetNullValue=' --', Mode=OneWay}" FontWeight="SemiBold"/>
                                                        <Run Text=" devices/week"/>
                                                    </TextBlock>
                                                </StackPanel>
                                            </Grid>

                                            <!-- Milestone 3: Target (Based on AI Recommendation) -->
                                            <Grid Grid.Row="2" Margin="0,0,0,25">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="Auto"/>
                                                    <ColumnDefinition Width="*"/>
                                                </Grid.ColumnDefinitions>
                                                
                                                <Ellipse Grid.Column="0" Width="35" Height="35" Fill="{StaticResource BackgroundPage}" 
                                                         Stroke="{StaticResource Gray300}" StrokeThickness="2" VerticalAlignment="Top"/>
                                                <TextBlock Grid.Column="0" Text="🎯" FontSize="16" 
                                                           HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                
                                                <StackPanel Grid.Column="1" Margin="20,0,0,0">
                                                    <TextBlock Text="Accelerate Velocity" FontSize="14" FontWeight="Bold" Foreground="{StaticResource TextSecondary}"/>
                                                    <TextBlock FontSize="12" Foreground="{StaticResource TextSecondary}" TextWrapping="Wrap" Margin="0,3,0,0">
                                                        <Run Text="Recommended:"/>
                                                        <Run Text="{Binding RecommendedEnrollmentVelocity, StringFormat=' {0:F0}', TargetNullValue=' --', Mode=OneWay}" FontWeight="SemiBold" Foreground="{StaticResource WarningOrange}"/>
                                                        <Run Text=" devices/week to meet target"/>
                                                    </TextBlock>
                                                </StackPanel>
                                            </Grid>

                                            <!-- Milestone 4: Completion -->
                                            <Grid Grid.Row="3" Margin="0,0,0,0">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="Auto"/>
                                                    <ColumnDefinition Width="*"/>
                                                </Grid.ColumnDefinitions>
                                                
                                                <Ellipse Grid.Column="0" Width="35" Height="35" Fill="{StaticResource BackgroundPage}" 
                                                         Stroke="{StaticResource Gray300}" StrokeThickness="2" VerticalAlignment="Top"/>
                                                <TextBlock Grid.Column="0" Text="🏁" FontSize="16" 
                                                           HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                
                                                <StackPanel Grid.Column="1" Margin="20,0,0,0">
                                                    <TextBlock Text="Migration Complete" FontSize="14" FontWeight="Bold" Foreground="{StaticResource TextSecondary}"/>
                                                    <TextBlock FontSize="12" Foreground="{StaticResource TextSecondary}" TextWrapping="Wrap" Margin="0,3,0,0">
                                                        <Run Text="Projected in"/>
                                                        <Run Text="{Binding ProjectedCompletionWeeks, StringFormat=' {0:F0}', TargetNullValue=' --', Mode=OneWay}" FontWeight="SemiBold" Foreground="{StaticResource AccentPurple}"/>
                                                        <Run Text=" weeks at recommended pace"/>
                                                    </TextBlock>
                                                </StackPanel>
                                            </Grid>
                                        </Grid>
                                        </StackPanel>
                                        
                                        <!-- Velocity Target Controls (Right Side) -->
                                        <Border Grid.Column="1" Background="{StaticResource AccentAmberLight}" CornerRadius="8" Padding="20" Margin="20,0,0,0">
                                            <StackPanel>
                                                <TextBlock Text="⚙️ ADJUST TARGET" FontSize="14" FontWeight="Bold" Foreground="{StaticResource TextPrimary}" Margin="0,0,0,10"/>
                                                <TextBlock Text="Set your target completion timeline:" FontSize="12" Foreground="{StaticResource TextSecondary}" TextWrapping="Wrap" Margin="0,0,0,15"/>
                                                
                                                <!-- Target Weeks Slider -->
                                                <StackPanel Margin="0,0,0,15">
                                                    <Grid Margin="0,0,0,8">
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="*"/>
                                                            <ColumnDefinition Width="Auto"/>
                                                        </Grid.ColumnDefinitions>
                                                        <TextBlock Grid.Column="0" Text="Target Weeks" FontSize="12" Foreground="{StaticResource TextSecondary}"/>
                                                        <TextBlock Grid.Column="1" FontSize="14" FontWeight="Bold" Foreground="{StaticResource WarningOrange}">
                                                            <Run Text="{Binding TargetCompletionWeeks, Mode=OneWay, TargetNullValue='14'}"/>
                                                            <Run Text=" weeks" FontSize="11" Foreground="{StaticResource TextSecondary}"/>
                                                        </TextBlock>
                                                    </Grid>
                                                    <Slider Minimum="4" Maximum="52" Value="{Binding TargetCompletionWeeks, Mode=TwoWay}" 
                                                            TickFrequency="2" IsSnapToTickEnabled="True"
                                                            VerticalAlignment="Center"/>
                                                    <Grid Margin="0,5,0,0">
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="*"/>
                                                            <ColumnDefinition Width="*"/>
                                                        </Grid.ColumnDefinitions>
                                                        <TextBlock Grid.Column="0" Text="4 weeks (aggressive)" FontSize="10" Foreground="{StaticResource TextLight}" HorizontalAlignment="Left"/>
                                                        <TextBlock Grid.Column="1" Text="52 weeks (relaxed)" FontSize="10" Foreground="{StaticResource TextLight}" HorizontalAlignment="Right"/>
                                                    </Grid>
                                                </StackPanel>
                                                
                                                <!-- Calculated Required Velocity -->
                                                <Border Background="White" CornerRadius="6" Padding="12" BorderBrush="{StaticResource BorderLight}" BorderThickness="1">
                                                    <StackPanel>
                                                        <TextBlock Text="Required Velocity" FontSize="11" Foreground="{StaticResource TextSecondary}" Margin="0,0,0,5"/>
                                                        <TextBlock FontSize="18" FontWeight="Bold" Foreground="{StaticResource PrimaryBlue}">
                                                            <Run Text="{Binding CalculatedRequiredVelocity, Mode=OneWay, StringFormat='{}{0:F0}', TargetNullValue='--'}"/>
                                                            <Run Text=" devices/week" FontSize="12" Foreground="{StaticResource TextSecondary}"/>
                                                        </TextBlock>
                                                        <TextBlock FontSize="10" Foreground="{StaticResource TextLight}" Margin="0,3,0,0">
                                                            <Run Text="Based on"/>
                                                            <Run Text="{Binding DeviceEnrollment.ConfigMgrOnlyDevices, StringFormat=' {0:N0}', TargetNullValue=' --'}" FontWeight="SemiBold"/>
                                                            <Run Text=" remaining devices"/>
                                                        </TextBlock>
                                                    </StackPanel>
                                                </Border>
                                                
                                                <TextBlock Text="💡 Adjust the slider to see how different timelines affect required enrollment velocity" 
                                                           FontSize="10" Foreground="{StaticResource TextSecondary}" TextWrapping="Wrap" 
                                                           FontStyle="Italic" Margin="0,10,0,0"/>
                                            </StackPanel>
                                        </Border>
                                    </Grid>
                                </Grid>
                            </Border>

                            <!-- SMART ENROLLMENT MANAGEMENT (Merged Device Readiness + Agent)
                                 STATUS: HIDDEN (January 2026)
                                 REASON: Feature needs refinement before broader release
                                 TO RESTORE: Change Visibility="Collapsed" to Visibility="Visible"
                            -->
                            <Border x:Name="DeviceReadinessSection" Style="{StaticResource SectionCard}"
                                    Visibility="Collapsed">
                                <StackPanel>
                                    <!-- Main Header -->
                                    <TextBlock Text="🎯 Smart Enrollment Management" Style="{StaticResource SectionTitle}"/>
                                    <TextBlock Text="AI-powered readiness scoring with optional autonomous enrollment agent" 
                                               FontSize="12" Foreground="{StaticResource TextSecondary}" Margin="0,0,0,15"/>

                                    <!-- ZONE 1: READINESS DASHBOARD -->
                                    <Border Background="{StaticResource BackgroundSubtle}" Padding="15" CornerRadius="6" Margin="0,0,0,15">
                                        <StackPanel>
                                            <TextBlock Text="📊 Device Readiness Overview" FontSize="13" FontWeight="Bold" Margin="0,0,0,12"/>
                                            
                                            <!-- Readiness Summary Grid -->
                                            <Grid Margin="0,0,0,15">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="*"/>
                                                </Grid.ColumnDefinitions>

                                                <StackPanel Grid.Column="0">
                                                    <TextBlock Text="Excellent" Style="{StaticResource MetricLabel}"/>
                                                    <TextBlock FontSize="20" FontWeight="Bold" Foreground="{StaticResource SuccessGreen}">
                                                        <Run Text="{Binding ExcellentReadinessCount}"/>
                                                    </TextBlock>
                                                    <TextBlock FontSize="10" Foreground="#999">
                                                        <Run Text="80+ score"/>
                                                    </TextBlock>
                                                </StackPanel>

                                                <StackPanel Grid.Column="1">
                                                    <TextBlock Text="Good" Style="{StaticResource MetricLabel}"/>
                                                    <TextBlock FontSize="20" FontWeight="Bold" Foreground="{StaticResource PrimaryBlue}">
                                                        <Run Text="{Binding GoodReadinessCount}"/>
                                                    </TextBlock>
                                                    <TextBlock FontSize="10" Foreground="#999">
                                                        <Run Text="60-79 score"/>
                                                    </TextBlock>
                                                </StackPanel>

                                                <StackPanel Grid.Column="2">
                                                    <TextBlock Text="Fair" Style="{StaticResource MetricLabel}"/>
                                                    <TextBlock FontSize="20" FontWeight="Bold" Foreground="{StaticResource AccentAmber}">
                                                        <Run Text="{Binding FairReadinessCount}"/>
                                                    </TextBlock>
                                                    <TextBlock FontSize="10" Foreground="#999">
                                                        <Run Text="40-59 score"/>
                                                    </TextBlock>
                                                </StackPanel>

                                                <StackPanel Grid.Column="3">
                                                    <TextBlock Text="Poor" Style="{StaticResource MetricLabel}"/>
                                                    <TextBlock FontSize="20" FontWeight="Bold" Foreground="{StaticResource ErrorRed}">
                                                        <Run Text="{Binding PoorReadinessCount}"/>
                                                    </TextBlock>
                                                    <TextBlock FontSize="10" Foreground="#999">
                                                        <Run Text="&lt;40 score"/>
                                                    </TextBlock>
                                                </StackPanel>
                                            </Grid>

                                            <!-- Ready for Enrollment Callout -->
                                            <Border Background="{StaticResource InfoBlueLight}" BorderBrush="{StaticResource PrimaryBlue}" BorderThickness="2" 
                                                    CornerRadius="6" Padding="15" Margin="0,0,0,15">
                                                <StackPanel>
                                                    <TextBlock FontWeight="Bold" FontSize="15" Margin="0,0,0,8">
                                                        <Run Text="✅ READY FOR ENROLLMENT: "/>
                                                        <Run Text="{Binding NextBatchSize, Mode=OneWay}" Foreground="{StaticResource SuccessGreen}"/>
                                                        <Run Text=" devices"/>
                                                    </TextBlock>
                                                    <TextBlock FontSize="12" Foreground="#333" TextWrapping="Wrap" Margin="0,0,0,10">
                                                        <Run Text="• "/>
                                                        <Run Text="{Binding ExcellentReadinessCount}"/>
                                                        <Run Text=" Excellent (80+ score) - Immediate enrollment recommended"/>
                                                        <LineBreak/>
                                                        <Run Text="• "/>
                                                        <Run Text="{Binding GoodReadinessCount}"/>
                                                        <Run Text=" Good (60-79 score) - Low risk"/>
                                                    </TextBlock>
                                                    <StackPanel Orientation="Horizontal">
                                                        <Button Content="📋 Export Device List"
                                                                Command="{Binding ExportDeviceListCommand}"
                                                                Style="{StaticResource ActionButton}"
                                                                Background="{StaticResource PrimaryBlue}" Foreground="White"
                                                                FontSize="12" Padding="12,6"
                                                                HorizontalAlignment="Left"/>
                                                        <TextBlock Text="💡 Want automated enrollment? Enable Agent below" 
                                                                   FontSize="11" FontStyle="Italic" Foreground="{StaticResource PrimaryBlue}"
                                                                   VerticalAlignment="Center" Margin="15,0,0,0"/>
                                                    </StackPanel>
                                                </StackPanel>
                                            </Border>

                                            <!-- Barriers and Risks -->
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="10"/>
                                                    <ColumnDefinition Width="*"/>
                                                </Grid.ColumnDefinitions>

                                                <Border Grid.Column="0" Background="{StaticResource AccentAmberLight}" BorderBrush="{StaticResource AccentAmber}" 
                                                        BorderThickness="1" CornerRadius="6" Padding="12">
                                                    <StackPanel>
                                                        <TextBlock FontWeight="SemiBold" FontSize="12" Margin="0,0,0,8">
                                                            <Run Text="⚠️ Needs Preparation: "/>
                                                            <Run Text="{Binding DevicesNeedingPreparation}"/>
                                                            <Run Text=" devices"/>
                                                        </TextBlock>
                                                        <TextBlock FontSize="11" Foreground="#666" TextWrapping="Wrap">
                                                            Fair/Poor readiness scores. Review apps, policies, and compliance before enrolling.
                                                        </TextBlock>
                                                    </StackPanel>
                                                </Border>

                                                <Border Grid.Column="2" Background="{StaticResource ErrorRedLight}" BorderBrush="{StaticResource ErrorRed}" 
                                                        BorderThickness="1" CornerRadius="6" Padding="12">
                                                    <StackPanel>
                                                        <TextBlock FontWeight="SemiBold" FontSize="12" Margin="0,0,0,8">
                                                            <Run Text="🔴 High Risk: "/>
                                                            <Run Text="{Binding HighRiskDeviceCount}"/>
                                                            <Run Text=" devices"/>
                                                        </TextBlock>
                                                        <TextBlock FontSize="11" Foreground="#666" TextWrapping="Wrap">
                                                            Critical app or policy conflicts. Address blockers before enrollment.
                                                        </TextBlock>
                                                    </StackPanel>
                                                </Border>
                                            </Grid>
                                        </StackPanel>
                                    </Border>

                                    <!-- ZONE 2: AUTONOMOUS AGENT -->
                                    <Grid Margin="0,0,0,15">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <StackPanel Grid.Column="0">
                                            <TextBlock Text="🤖 Autonomous Enrollment Agent" FontSize="13" FontWeight="Bold" Margin="0"/>
                                            <TextBlock Text="Let AI orchestrate enrollment from ready devices above" 
                                                       FontSize="11" Foreground="{StaticResource TextSecondary}" Margin="0,3,0,0"/>
                                        </StackPanel>
                                        <StackPanel Grid.Column="1" Orientation="Horizontal">
                                            <ToggleButton x:Name="AgentModeToggle" 
                                                          Width="50" Height="26" 
                                                          Style="{StaticResource ToggleSwitchStyle}"
                                                          ToolTip="Enable/Disable Enrollment Agent"/>
                                        </StackPanel>
                                    </Grid>

                                    <!-- Configuration Panel (Collapsed when disabled) -->
                                    <Border Background="{StaticResource BackgroundSubtle}" Padding="15" CornerRadius="4" Margin="0,0,0,15"
                                            Visibility="{Binding IsChecked, ElementName=AgentModeToggle, Converter={StaticResource BoolToVisibilityConverter}}">
                                        <StackPanel>
                                            <TextBlock FontSize="12" Foreground="{StaticResource PrimaryBlue}" Margin="0,0,0,10" TextWrapping="Wrap">
                                                <Run Text="📊 Agent will work with the "/>
                                                <Run Text="{Binding NextBatchSize, Mode=OneWay}" FontWeight="Bold"/>
                                                <Run Text=" ready devices from readiness analysis above"/>
                                            </TextBlock>
                                            
                                            <TextBlock Text="⚙️ Configuration" FontSize="13" FontWeight="Bold" Margin="0,5,0,10"/>
                                            
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="*"/>
                                                </Grid.ColumnDefinitions>
                                                <Grid.RowDefinitions>
                                                    <RowDefinition Height="Auto"/>
                                                    <RowDefinition Height="Auto"/>
                                                    <RowDefinition Height="Auto"/>
                                                </Grid.RowDefinitions>

                                                <!-- Target Date -->
                                                <StackPanel Grid.Row="0" Grid.Column="0" Margin="0,0,10,10">
                                                    <TextBlock Text="Target Completion Date" FontSize="11" Foreground="{StaticResource TextSecondary}" Margin="0,0,0,3"/>
                                                    <DatePicker x:Name="TargetDatePicker" 
                                                                SelectedDate="{Binding TargetCompletionDate}"
                                                                SelectedDateChanged="TargetDatePicker_SelectedDateChanged"
                                                                FontSize="12" Width="200" HorizontalAlignment="Left"/>
                                                </StackPanel>

                                                <!-- Agent Phase Selector -->
                                                <StackPanel Grid.Row="0" Grid.Column="1" Margin="10,0,0,10">
                                                    <TextBlock Text="Agent Phase (NEW)" FontSize="11" Foreground="{StaticResource TextSecondary}" Margin="0,0,0,3"/>
                                                    <ComboBox x:Name="AgentPhaseCombo" Width="220" HorizontalAlignment="Left" FontSize="12"
                                                              SelectedIndex="{Binding AgentPhaseIndex, Mode=TwoWay}">
                                                        <ComboBoxItem Content="📋 Supervised" Tag="Phase1">
                                                            <ComboBoxItem.ToolTip>
                                                                <ToolTip MaxWidth="400">
                                                                    <StackPanel>
                                                                        <TextBlock Text="Supervised Agent" FontWeight="Bold" Margin="0,0,0,5"/>
                                                                        <TextBlock Text="• All enrollments require your approval" TextWrapping="Wrap"/>
                                                                        <TextBlock Text="• Emergency stop available at all times" TextWrapping="Wrap"/>
                                                                        <TextBlock Text="• Agent pauses if failure rate exceeds 15%" TextWrapping="Wrap"/>
                                                                        <TextBlock Text="• Complete audit trail of all actions" TextWrapping="Wrap"/>
                                                                    </StackPanel>
                                                                </ToolTip>
                                                            </ComboBoxItem.ToolTip>
                                                        </ComboBoxItem>
                                                        <ComboBoxItem Content="⚡ Conditional" Tag="Phase2">
                                                            <ComboBoxItem.ToolTip>
                                                                <ToolTip MaxWidth="400">
                                                                    <StackPanel>
                                                                        <TextBlock Text="Conditional Autonomy" FontWeight="Bold" Margin="0,0,0,5"/>
                                                                        <TextBlock Text="• Low/Medium risk devices auto-approved" TextWrapping="Wrap"/>
                                                                        <TextBlock Text="• High/Critical risk requires approval" TextWrapping="Wrap"/>
                                                                        <TextBlock Text="• Self-adjusting batch sizes" TextWrapping="Wrap"/>
                                                                        <TextBlock Text="• Risk assessment for every device" TextWrapping="Wrap"/>
                                                                    </StackPanel>
                                                                </ToolTip>
                                                            </ComboBoxItem.ToolTip>
                                                        </ComboBoxItem>
                                                        <ComboBoxItem Content="🚗 Autonomous" Tag="Phase3" IsSelected="True">
                                                            <ComboBoxItem.ToolTip>
                                                                <ToolTip MaxWidth="400">
                                                                    <StackPanel>
                                                                        <TextBlock Text="Fully Autonomous" FontWeight="Bold" Margin="0,0,0,5"/>
                                                                        <TextBlock Text="• Continuous monitoring every 15 minutes" TextWrapping="Wrap"/>
                                                                        <TextBlock Text="• Auto-enrolls when devices improve" TextWrapping="Wrap"/>
                                                                        <TextBlock Text="• No approval required for qualifying devices" TextWrapping="Wrap"/>
                                                                        <TextBlock Text="• Real-time device status tracking" TextWrapping="Wrap"/>
                                                                    </StackPanel>
                                                                </ToolTip>
                                                            </ComboBoxItem.ToolTip>
                                                        </ComboBoxItem>
                                                    </ComboBox>
                                                </StackPanel>

                                                <!-- Max Devices Per Day -->
                                                <StackPanel Grid.Row="1" Grid.Column="0" Margin="0,0,10,10">
                                                    <TextBlock Text="Max Devices Per Day" FontSize="11" Foreground="{StaticResource TextSecondary}" Margin="0,0,0,3"/>
                                                    <TextBox x:Name="MaxDevicesPerDayText" Width="200" HorizontalAlignment="Left" FontSize="12"
                                                             Text="50" 
                                                             ToolTip="Auto-calculated based on target date. Edit to override AI suggestion."/>
                                                </StackPanel>

                                                <!-- Operating Hours -->
                                                <StackPanel Grid.Row="1" Grid.Column="1" Margin="10,0,0,10">
                                                    <TextBlock Text="Operating Hours" FontSize="11" Foreground="{StaticResource TextSecondary}" Margin="0,0,0,3"/>
                                                    <ComboBox x:Name="OperatingHoursCombo" Width="200" HorizontalAlignment="Left" FontSize="12"
                                                              SelectedIndex="0"
                                                              ToolTip="Business Hours: 8AM-6PM Monday-Friday&#x0a;Extended: 6AM-10PM Monday-Saturday&#x0a;Always: 24/7 continuous operation">
                                                        <ComboBoxItem Content="⏰ Business Hours (8AM-6PM)" Tag="BusinessHours"/>
                                                        <ComboBoxItem Content="🌆 Extended (6AM-10PM)" Tag="Extended"/>
                                                        <ComboBoxItem Content="🌍 Always (24/7)" Tag="Always"/>
                                                    </ComboBox>
                                                </StackPanel>

                                                <!-- Action Buttons -->
                                                <StackPanel Grid.Row="2" Grid.Column="0" Grid.ColumnSpan="2" Orientation="Horizontal" Margin="0,10,0,0">
                                                    <Button Content="🎯 Start Autonomous Agent" 
                                                            Style="{StaticResource ActionButton}"
                                                            Background="{StaticResource PrimaryBlue}" Foreground="White"
                                                            Width="200" Height="32"
                                                            Command="{Binding GenerateAgentPlanCommand}"
                                                            IsEnabled="{Binding IsAgentRunning, Converter={StaticResource InverseBoolConverter}}"
                                                            ToolTip="Start autonomous enrollment - agent will continuously monitor and enroll devices as they become ready"/>
                                                    
                                                    <Button Content="🔍 View Monitoring Stats" 
                                                            Style="{StaticResource ActionButton}"
                                                            Background="{StaticResource SuccessGreen}" Foreground="White"
                                                            Width="180" Height="32" Margin="10,0,0,0"
                                                            Command="{Binding ViewMonitoringStatsCommand}"
                                                            Visibility="{Binding IsMonitoringActive, Converter={StaticResource BoolToVisibilityConverter}}"
                                                            ToolTip="View current monitoring statistics and tracked devices"/>
                                                </StackPanel>
                                            </Grid>
                                        </StackPanel>
                                    </Border>

                                    <!-- Status Display -->
                                    <Border Background="{StaticResource InfoBlueLight}" Padding="15" CornerRadius="4" Margin="0,0,0,15"
                                            Visibility="{Binding IsChecked, ElementName=AgentModeToggle, Converter={StaticResource BoolToVisibilityConverter}}">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto"/>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>

                                            <!-- Status Icon -->
                                            <Border Grid.Column="0" Width="50" Height="50" CornerRadius="25" Margin="0,0,15,0">
                                                <Border.Style>
                                                    <Style TargetType="Border">
                                                        <Setter Property="Background" Value="{StaticResource PrimaryBlue}"/>
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding IsAgentRunning}" Value="True">
                                                                <Setter Property="Background" Value="{StaticResource SuccessGreen}"/>
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </Border.Style>
                                                <TextBlock FontSize="24" HorizontalAlignment="Center" VerticalAlignment="Center">
                                                    <TextBlock.Style>
                                                        <Style TargetType="TextBlock">
                                                            <Setter Property="Text" Value="⚙️"/>
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding IsAgentRunning}" Value="True">
                                                                    <Setter Property="Text" Value="🤖"/>
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </TextBlock.Style>
                                                </TextBlock>
                                            </Border>

                                            <!-- Status Info -->
                                            <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                                <TextBlock FontSize="14" FontWeight="Bold">
                                                    <TextBlock.Style>
                                                        <Style TargetType="TextBlock">
                                                            <Setter Property="Text" Value="Ready to Generate Plan"/>
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding IsAgentRunning}" Value="True">
                                                                    <Setter Property="Text" Value="Agent Running"/>
                                                                    <Setter Property="Foreground" Value="{StaticResource SuccessGreen}"/>
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </TextBlock.Style>
                                                </TextBlock>
                                                <TextBlock FontSize="11" Foreground="{StaticResource TextSecondary}" Margin="0,3,0,0" TextWrapping="Wrap">
                                                    <Run Text="{Binding AgentStatus}"/>
                                                </TextBlock>
                                            </StackPanel>

                                            <!-- Emergency Stop -->
                                            <Button Grid.Column="2" Content="🛑 STOP" 
                                                    Background="{StaticResource ErrorRed}" Foreground="White"
                                                    FontWeight="Bold" FontSize="13"
                                                    Width="120" Height="40"
                                                    Command="{Binding StopAgentCommand}"
                                                    Visibility="{Binding IsAgentRunning, Converter={StaticResource BoolToVisibilityConverter}}"
                                                    ToolTip="Immediately halt all agent operations"/>
                                        </Grid>
                                    </Border>

                                    <!-- ZONE 3: AGENT REASONING & EXECUTION -->
                                    <!-- Agent Reasoning Panel (Shows thinking process) -->
                                    <Expander Header="🧠 Agent Reasoning Log" 
                                              IsExpanded="True"
                                              Margin="0,0,0,15"
                                              Visibility="{Binding AgentReasoningSteps.Count, Mode=OneWay, Converter={StaticResource InverseCountToVisibilityConverter}}">
                                        <Border Background="White" BorderBrush="#CCCCCC" BorderThickness="1" 
                                                Padding="15" CornerRadius="4" Margin="0,5,0,0">
                                            <ScrollViewer MaxHeight="400" VerticalScrollBarVisibility="Auto">
                                                <ItemsControl ItemsSource="{Binding AgentReasoningSteps}">
                                                    <ItemsControl.ItemTemplate>
                                                        <DataTemplate>
                                                            <Border Background="{StaticResource BackgroundSubtle}" Padding="10" Margin="0,0,0,8" CornerRadius="4">
                                                                <StackPanel>
                                                                    <!-- Step Header -->
                                                                    <TextBlock FontSize="11" FontWeight="Bold" Margin="0,0,0,5">
                                                                        <Run Text="Step "/>
                                                                        <Run Text="{Binding StepNumber}"/>
                                                                        <Run Text=" - "/>
                                                                        <Run Text="{Binding Thought}" Foreground="{StaticResource PrimaryBlue}"/>
                                                                    </TextBlock>
                                                                    
                                                                    <!-- Tool Called -->
                                                                    <TextBlock FontSize="11" Margin="0,0,0,3" Visibility="{Binding ToolToUse, Converter={StaticResource NullToVisibilityConverter}}">
                                                                        <Run Text="🔧 Tool: " FontWeight="SemiBold"/>
                                                                        <Run Text="{Binding ToolToUse}" Foreground="{StaticResource SuccessGreen}"/>
                                                                    </TextBlock>
                                                                    
                                                                    <!-- Observation -->
                                                                    <TextBlock Text="{Binding Observation.Data}" FontSize="10" Foreground="{StaticResource TextSecondary}" 
                                                                               TextWrapping="Wrap" Margin="0,0,0,3"
                                                                               Visibility="{Binding Observation, Converter={StaticResource NullToVisibilityConverter}}"/>
                                                                    
                                                                    <!-- Reflection -->
                                                                    <TextBlock FontSize="10" Margin="0,3,0,0" 
                                                                               Visibility="{Binding Reflection, Converter={StaticResource NullToVisibilityConverter}}">
                                                                        <Run Text="💭 " FontStyle="Italic"/>
                                                                        <Run Text="{Binding Reflection}" FontStyle="Italic" Foreground="{StaticResource WarningOrange}"/>
                                                                    </TextBlock>
                                                                </StackPanel>
                                                            </Border>
                                                        </DataTemplate>
                                                    </ItemsControl.ItemTemplate>
                                                </ItemsControl>
                                            </ScrollViewer>
                                        </Border>
                                    </Expander>

                                    <!-- Progress Display (Visible during execution) -->
                                    <Border Background="White" BorderBrush="#CCCCCC" BorderThickness="1" 
                                            Padding="15" CornerRadius="4" Margin="0,0,0,15"
                                            Visibility="{Binding IsAgentRunning, Converter={StaticResource BoolToVisibilityConverter}}">
                                        <StackPanel>
                                            <TextBlock Text="📈 Enrollment Progress" FontSize="13" FontWeight="Bold" Margin="0,0,0,10"/>
                                            
                                            <!-- Progress Bar -->
                                            <Grid Margin="0,0,0,10">
                                                <ProgressBar Height="30" Value="0" Maximum="100"/>
                                                <TextBlock Text="0% Complete (0 / 0 devices)" 
                                                           FontSize="11" Foreground="White" FontWeight="Bold"
                                                           HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                            </Grid>

                                            <!-- Stats Grid -->
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="*"/>
                                                </Grid.ColumnDefinitions>

                                                <StackPanel Grid.Column="0">
                                                    <TextBlock Text="✅ Enrolled" FontSize="11" Foreground="{StaticResource SuccessGreen}" FontWeight="Bold"/>
                                                    <TextBlock Text="0" FontSize="18" FontWeight="Bold" Margin="0,3,0,0"/>
                                                </StackPanel>

                                                <StackPanel Grid.Column="1">
                                                    <TextBlock Text="❌ Failed" FontSize="11" Foreground="{StaticResource ErrorRed}" FontWeight="Bold"/>
                                                    <TextBlock Text="0" FontSize="18" FontWeight="Bold" Margin="0,3,0,0"/>
                                                </StackPanel>

                                                <StackPanel Grid.Column="2">
                                                    <TextBlock Text="⏳ Pending" FontSize="11" Foreground="{StaticResource WarningOrange}" FontWeight="Bold"/>
                                                    <TextBlock Text="0" FontSize="18" FontWeight="Bold" Margin="0,3,0,0"/>
                                                </StackPanel>

                                                <StackPanel Grid.Column="3">
                                                    <TextBlock Text="📈 Success Rate" FontSize="11" Foreground="{StaticResource PrimaryBlue}" FontWeight="Bold"/>
                                                    <TextBlock Text="0%" FontSize="18" FontWeight="Bold" Margin="0,3,0,0"/>
                                                </StackPanel>
                                            </Grid>

                                            <!-- Current Batch -->
                                            <TextBlock Text="Current: Batch 1 of 5" FontSize="11" Foreground="{StaticResource TextSecondary}" Margin="0,10,0,0"/>
                                            <TextBlock Text="Next batch scheduled: Tomorrow at 9:00 AM" FontSize="11" Foreground="{StaticResource TextSecondary}" Margin="0,3,0,0"/>
                                        </StackPanel>
                                    </Border>

                                    <!-- Agent Completion Status (Visible after agent completes) -->
                                    <Border Background="{StaticResource SuccessGreenLight}" BorderBrush="{StaticResource SuccessGreen}" BorderThickness="2" 
                                            Padding="15" CornerRadius="6" Margin="0,0,0,15"
                                            Visibility="{Binding AgentCompletionMessage, Converter={StaticResource NullToVisibilityConverter}}">
                                        <StackPanel>
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="Auto"/>
                                                    <ColumnDefinition Width="*"/>
                                                </Grid.ColumnDefinitions>
                                                
                                                <Border Grid.Column="0" Width="50" Height="50" Background="{StaticResource SuccessGreen}" 
                                                        CornerRadius="25" Margin="0,0,15,0" VerticalAlignment="Top">
                                                    <TextBlock Text="✅" FontSize="28" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                </Border>
                                                
                                                <StackPanel Grid.Column="1">
                                                    <TextBlock Text="Agent Monitoring Active" FontSize="16" FontWeight="Bold" 
                                                               Foreground="{StaticResource SuccessGreen}" Margin="0,0,0,8"/>
                                                    <TextBlock Text="{Binding AgentCompletionMessage}" FontSize="12" 
                                                               Foreground="#333" TextWrapping="Wrap" Margin="0,0,0,8"/>
                                                    <TextBlock FontSize="11" Foreground="#666" TextWrapping="Wrap">
                                                        <Run Text="🔄 The agent is continuously monitoring device readiness and will automatically enroll devices as they improve from poor/fair to good/excellent status."/>
                                                    </TextBlock>
                                                </StackPanel>
                                            </Grid>
                                        </StackPanel>
                                    </Border>

                                    <!-- Phase 3: Active Monitoring Status -->
                                    <Border Background="{StaticResource AccentAmberLight}" BorderBrush="#FFC107" BorderThickness="2" 
                                            Padding="15" CornerRadius="6" Margin="0,0,0,15"
                                            Visibility="{Binding IsMonitoringActive, Converter={StaticResource BoolToVisibilityConverter}}">
                                        <Grid>
                                            <Grid.RowDefinitions>
                                                <RowDefinition Height="Auto"/>
                                                <RowDefinition Height="Auto"/>
                                            </Grid.RowDefinitions>
                                            
                                            <StackPanel Grid.Row="0">
                                                <TextBlock Text="🔍 Phase 3: Continuous Monitoring Active" FontSize="14" FontWeight="Bold" 
                                                           Foreground="{StaticResource WarningOrange}" Margin="0,0,0,10"/>
                                                <Grid>
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="*"/>
                                                        <ColumnDefinition Width="*"/>
                                                        <ColumnDefinition Width="*"/>
                                                    </Grid.ColumnDefinitions>
                                                    
                                                    <StackPanel Grid.Column="0">
                                                        <TextBlock Text="Devices Monitored" FontSize="11" Foreground="#666"/>
                                                        <TextBlock Text="{Binding MonitoredDeviceCount}" FontSize="20" FontWeight="Bold" Foreground="{StaticResource WarningOrange}"/>
                                                    </StackPanel>
                                                    
                                                    <StackPanel Grid.Column="1">
                                                        <TextBlock Text="Auto-Enrolled Today" FontSize="11" Foreground="#666"/>
                                                        <TextBlock Text="{Binding AutoEnrolledToday}" FontSize="20" FontWeight="Bold" Foreground="{StaticResource SuccessGreen}"/>
                                                    </StackPanel>
                                                    
                                                    <StackPanel Grid.Column="2">
                                                        <TextBlock Text="Next Check" FontSize="11" Foreground="#666"/>
                                                        <TextBlock Text="{Binding NextMonitoringCheck}" FontSize="20" FontWeight="Bold" Foreground="{StaticResource PrimaryBlue}"/>
                                                    </StackPanel>
                                                </Grid>
                                            </StackPanel>
                                        </Grid>
                                    </Border>

                                    <!-- Phase 2: Auto-Approval Status -->
                                    <Border Background="{StaticResource InfoBlueLight}" BorderBrush="#2196F3" BorderThickness="1" 
                                            Padding="12" CornerRadius="4" Margin="0,0,0,15"
                                            Visibility="{Binding ShowAutoApprovalStatus, Converter={StaticResource BoolToVisibilityConverter}}">
                                        <StackPanel>
                                            <TextBlock FontSize="12" Foreground="{StaticResource InfoBlue}" FontWeight="SemiBold" Margin="0,0,0,5">
                                                <Run Text="⚡ Phase 2: Auto-Approval Active"/>
                                            </TextBlock>
                                            <TextBlock FontSize="11" Foreground="#666" TextWrapping="Wrap">
                                                <Run Text="{Binding AutoApprovalStatusMessage}"/>
                                            </TextBlock>
                                        </StackPanel>
                                    </Border>

                                    <!-- Help Link -->
                                    <Button Content="❓ Learn more" 
                                            Style="{StaticResource TileHelpButton}"
                                            Command="{Binding OpenUserGuideSectionCommand}"
                                            CommandParameter="enrollment-agent"
                                            ToolTip="Open help for Smart Enrollment Management"
                                            Margin="0,10,0,0"/>

                                </StackPanel>
                            </Border>

                            <!-- Enrollment Momentum & Analytics Section
                                 STATUS: HIDDEN (January 2026)
                                 REASON: Feature needs refinement before alpha release
                                 TO RESTORE: Change Visibility="Collapsed" to Visibility="Visible" below
                                 CONTAINS: EnrollmentMomentumView (velocity/projections) + EnrollmentConfidenceCard (score breakdown)
                            -->
                            <Border Style="{StaticResource SectionCard}" Visibility="Collapsed">
                                <StackPanel>
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="350"/>
                                        </Grid.ColumnDefinitions>
                                        
                                        <!-- Momentum Chart -->
                                        <views:EnrollmentMomentumView Grid.Column="0" Margin="0,0,15,0"
                                            x:Name="EnrollmentMomentumView"/>
                                        
                                        <!-- Confidence Card -->
                                        <views:EnrollmentConfidenceCard Grid.Column="1"
                                            x:Name="EnrollmentConfidenceCard"/>
                                    </Grid>
                                </StackPanel>
                            </Border>

                            <!-- NEW: Enrollment Playbooks Section (Hidden) -->
                            <views:EnrollmentPlaybooksView x:Name="EnrollmentPlaybooksView" Margin="0,0,0,15" Visibility="Collapsed"/>

                            <!-- Enrollment Readiness Analyzer (100% Data-Driven) -->
                            <views:EnrollmentSimulatorCard x:Name="EnrollmentSimulatorCard" Margin="0,0,0,15"/>

                            <!-- Enrollment Readiness (Moved from Overview) - HIDDEN: Feature needs refinement -->
                            <Border Style="{StaticResource SectionCard}" Visibility="Collapsed">
                                <StackPanel>
                                    <!-- Header with Info Badge -->
                                    <Grid Margin="0,0,0,15">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <StackPanel Grid.Column="0">
                                            <TextBlock Text="🚫 Enrollment Readiness Check" Style="{StaticResource SectionTitle}" Margin="0,0,0,5"/>
                                            <TextBlock Text="Essential prerequisites that must be met before Intune co-management enrollment" 
                                                       FontSize="11" Foreground="#666"/>
                                        </StackPanel>
                                        <Border Grid.Column="1" Background="{StaticResource InfoBlueLight}" BorderBrush="{StaticResource PrimaryBlue}" BorderThickness="1" 
                                                CornerRadius="4" Padding="10,5" VerticalAlignment="Top">
                                            <StackPanel Orientation="Horizontal">
                                                <TextBlock Text="ℹ️" FontSize="14" Margin="0,0,5,0"/>
                                                <TextBlock FontSize="11" Foreground="{StaticResource PrimaryBlue}">
                                                    <Run Text="Scanning "/>
                                                    <Run Text="{Binding DeviceEnrollment.TotalDevices}" FontWeight="Bold"/>
                                                    <Run Text=" devices"/>
                                                </TextBlock>
                                            </StackPanel>
                                        </Border>
                                    </Grid>

                                    <!-- Overall Status Summary -->
                                    <Border Background="{StaticResource BackgroundSubtle}" Padding="15" CornerRadius="6" Margin="0,0,0,15">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto"/>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>

                                            <Border Grid.Column="0" Width="60" Height="60" Background="{StaticResource SuccessGreenLight}" 
                                                    CornerRadius="30" Margin="0,0,15,0" VerticalAlignment="Center"
                                                    Visibility="{Binding Blockers.Count, Mode=OneWay, Converter={StaticResource CountToVisibilityConverter}}">
                                                <TextBlock Text="✅" FontSize="32" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                            </Border>
                                            <Border Grid.Column="0" Width="60" Height="60" Background="{StaticResource ErrorRedLight}" 
                                                    CornerRadius="30" Margin="0,0,15,0" VerticalAlignment="Center"
                                                    Visibility="{Binding Blockers.Count, Mode=OneWay, Converter={StaticResource InverseCountToVisibilityConverter}}">
                                                <TextBlock Text="⚠️" FontSize="32" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                            </Border>

                                            <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                                <TextBlock FontSize="16" FontWeight="Bold" Margin="0,0,0,5"
                                                           Visibility="{Binding Blockers.Count, Mode=OneWay, Converter={StaticResource CountToVisibilityConverter}}">
                                                    <Run Text="All Prerequisites Met" Foreground="{StaticResource SuccessGreen}"/>
                                                </TextBlock>
                                                <TextBlock FontSize="16" FontWeight="Bold" Margin="0,0,0,5"
                                                           Visibility="{Binding Blockers.Count, Mode=OneWay, Converter={StaticResource InverseCountToVisibilityConverter}}">
                                                    <Run Text="{Binding Blockers.Count, Mode=OneWay}"/>
                                                    <Run Text=" Critical Issues Found" Foreground="{StaticResource ErrorRed}"/>
                                                </TextBlock>
                                                <TextBlock FontSize="12" Foreground="#666" TextWrapping="Wrap"
                                                           Visibility="{Binding Blockers.Count, Mode=OneWay, Converter={StaticResource CountToVisibilityConverter}}">
                                                    Your environment meets all requirements for co-management enrollment. Ready to begin migration.
                                                </TextBlock>
                                                <TextBlock FontSize="12" Foreground="#666" TextWrapping="Wrap"
                                                           Visibility="{Binding Blockers.Count, Mode=OneWay, Converter={StaticResource InverseCountToVisibilityConverter}}">
                                                    These issues must be resolved before devices can be enrolled in Intune. Click "Fix" on each blocker for remediation steps.
                                                </TextBlock>
                                            </StackPanel>

                                            <Button Grid.Column="2" Content="📋 Export Report" 
                                                    Style="{StaticResource ActionButton}"
                                                    Background="{StaticResource PrimaryBlue}" Foreground="White"
                                                    FontSize="12" Padding="12,8"
                                                    VerticalAlignment="Center"
                                                    ToolTip="Export full readiness assessment to CSV"/>
                                        </Grid>
                                    </Border>

                                    <!-- Critical Prerequisites Checklist -->
                                    <Border Background="#FFFFFF" BorderBrush="{StaticResource BorderLight}" BorderThickness="1" 
                                            Padding="15" CornerRadius="6" Margin="0,0,0,15"
                                            Visibility="{Binding Blockers.Count, Mode=OneWay, Converter={StaticResource CountToVisibilityConverter}}">
                                        <StackPanel>
                                            <TextBlock Text="✅ Essential Prerequisites Verified" FontSize="13" FontWeight="Bold" 
                                                       Foreground="{StaticResource SuccessGreen}" Margin="0,0,0,12"/>
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="*"/>
                                                </Grid.ColumnDefinitions>
                                                <StackPanel Grid.Column="0" Margin="0,0,10,0">
                                                    <TextBlock FontSize="11" Foreground="#666" Margin="0,0,0,5">
                                                        <Run Text="✓" Foreground="{StaticResource SuccessGreen}" FontWeight="Bold"/>
                                                        <Run Text=" Entra ID Hybrid Join configured"/>
                                                    </TextBlock>
                                                    <TextBlock FontSize="11" Foreground="#666" Margin="0,0,0,5">
                                                        <Run Text="✓" Foreground="{StaticResource SuccessGreen}" FontWeight="Bold"/>
                                                        <Run Text=" Client Health Check passing"/>
                                                    </TextBlock>
                                                    <TextBlock FontSize="11" Foreground="#666" Margin="0,0,0,5">
                                                        <Run Text="✓" Foreground="{StaticResource SuccessGreen}" FontWeight="Bold"/>
                                                        <Run Text=" Windows 10/11 version validated"/>
                                                    </TextBlock>
                                                    <TextBlock FontSize="11" Foreground="#666">
                                                        <Run Text="✓" Foreground="{StaticResource SuccessGreen}" FontWeight="Bold"/>
                                                        <Run Text=" Configuration Manager client installed"/>
                                                    </TextBlock>
                                                </StackPanel>
                                                <StackPanel Grid.Column="1" Margin="10,0,0,0">
                                                    <TextBlock FontSize="11" Foreground="#666" Margin="0,0,0,5">
                                                        <Run Text="✓" Foreground="{StaticResource SuccessGreen}" FontWeight="Bold"/>
                                                        <Run Text=" Co-management prerequisites met"/>
                                                    </TextBlock>
                                                    <TextBlock FontSize="11" Foreground="#666" Margin="0,0,0,5">
                                                        <Run Text="✓" Foreground="{StaticResource SuccessGreen}" FontWeight="Bold"/>
                                                        <Run Text=" Internet connectivity verified"/>
                                                    </TextBlock>
                                                    <TextBlock FontSize="11" Foreground="#666" Margin="0,0,0,5">
                                                        <Run Text="✓" Foreground="{StaticResource SuccessGreen}" FontWeight="Bold"/>
                                                        <Run Text=" Intune licenses assigned"/>
                                                    </TextBlock>
                                                    <TextBlock FontSize="11" Foreground="#666">
                                                        <Run Text="✓" Foreground="{StaticResource SuccessGreen}" FontWeight="Bold"/>
                                                        <Run Text=" Endpoint protection policies ready"/>
                                                    </TextBlock>
                                                </StackPanel>
                                            </Grid>
                                        </StackPanel>
                                    </Border>
                                    
                                    <!-- Blockers List (Only shown when blockers exist) - Tile Layout -->
                                    <ItemsControl ItemsSource="{Binding Blockers}">
                                        <ItemsControl.ItemsPanel>
                                            <ItemsPanelTemplate>
                                                <UniformGrid Columns="2" />
                                            </ItemsPanelTemplate>
                                        </ItemsControl.ItemsPanel>
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <Border Background="#FFF9F9" 
                                                        BorderBrush="{Binding Severity, Converter={StaticResource BlockerSeverityConverter}}" 
                                                        BorderThickness="2" 
                                                        CornerRadius="6" Padding="12" Margin="0,0,10,10">
                                                    <Grid>
                                                        <Grid.RowDefinitions>
                                                            <RowDefinition Height="Auto"/>
                                                            <RowDefinition Height="*"/>
                                                            <RowDefinition Height="Auto"/>
                                                        </Grid.RowDefinitions>

                                                        <!-- Header with Severity Badge -->
                                                        <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,8">
                                                            <Border Background="{Binding Severity, Converter={StaticResource BlockerSeverityConverter}}"
                                                                    CornerRadius="3" Padding="6,2" Margin="0,0,8,0">
                                                                <TextBlock Text="{Binding Severity}" 
                                                                           FontSize="9" FontWeight="Bold" 
                                                                           Foreground="White"/>
                                                            </Border>
                                                            <TextBlock Text="{Binding Title}" 
                                                                       FontWeight="Bold" FontSize="12"
                                                                       TextTrimming="CharacterEllipsis"
                                                                       VerticalAlignment="Center"/>
                                                        </StackPanel>

                                                        <!-- Description -->
                                                        <TextBlock Grid.Row="1" Text="{Binding Description}" 
                                                                   FontSize="11" Foreground="{StaticResource TextSecondary}" 
                                                                   TextWrapping="Wrap" TextTrimming="CharacterEllipsis"
                                                                   MaxHeight="36" Margin="0,0,0,8"/>

                                                        <!-- Impact + Fix Button Row -->
