                            <!-- ============================== -->
                            <!-- SECTION 1: DECISION CARDS       -->
                            <!-- ============================== -->
                            <TextBlock Text="🎯 Decision Cards" FontSize="22" FontWeight="Bold" Foreground="#1E293B" Margin="0,0,0,5"/>
