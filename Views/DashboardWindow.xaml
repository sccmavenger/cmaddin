                                                        <TextBlock Text="{Binding Decision}" FontSize="13" FontWeight="SemiBold" Foreground="#1E293B" TextWrapping="Wrap"/>
                                                    </StackPanel>
                                                </Border>

                                                <!-- Q2: Why It Matters -->
